<Window x:Class="NetworkDiscoveryTool.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="SupportToolKit - Network Discovery &amp; IT Infrastructure"
        Icon="pack://application:,,,/SupportToolKit;component/Assets/app.ico"
        Height="780"
        Width="1280"
        MinHeight="560"
        MinWidth="900"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled"
        RenderOptions.BitmapScalingMode="HighQuality">

    <Window.Resources>
        <!-- Window control button style -->
        <Style x:Key="WindowBtn" TargetType="Button">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource HoverBgBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="WindowCloseBtn" TargetType="Button" BasedOn="{StaticResource WindowBtn}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource DangerBrush}"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- NetScope Pro Sidebar Button Style -->
        <Style x:Key="NetScopeNavBtn" TargetType="Button">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Margin" Value="12,2,12,2"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="{DynamicResource SidebarTextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="md:ButtonAssist.CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                CornerRadius="10" Padding="{TemplateBinding Padding}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                BorderBrush="{TemplateBinding BorderBrush}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource NavActiveBgBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource SidebarTextActiveBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Active Navigation Pill Style -->
        <Style x:Key="NetScopeNavBtnActive" TargetType="Button" BasedOn="{StaticResource NetScopeNavBtn}">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#0284C7" Offset="0"/>
                        <GradientStop Color="#0EA5E9" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#6038BDF8"/>
        </Style>

    </Window.Resources>

    <!-- Main Container Outer Border -->
    <Border Background="{DynamicResource PageBgBrush}" CornerRadius="14" BorderBrush="{DynamicResource SurfaceBorderBrush}" BorderThickness="1" SnapsToDevicePixels="True" UseLayoutRounding="True" RenderOptions.ClearTypeHint="Enabled">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="64"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ============================================================ -->
            <!-- TOP APP HEADER BAR                                           -->
            <!-- ============================================================ -->
            <Border Grid.Row="0" Background="{DynamicResource SurfaceBgBrush}" BorderBrush="{DynamicResource SidebarDividerBrush}" BorderThickness="0,0,0,1" Padding="16,0,12,0"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <!-- 0: Logo & Title -->
                        <ColumnDefinition Width="230"/>
                        <!-- 1: Live Pulse Status -->
                        <ColumnDefinition Width="Auto"/>
                        <!-- 2: Universal Search -->
                        <ColumnDefinition Width="*"/>
                        <!-- 3: Interface & Active Scan Widgets -->
                        <ColumnDefinition Width="Auto"/>
                        <!-- 4: Theme, User & Controls -->
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left Branding & Hamburger -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Network Radar Logo Icon in Glowing Badge -->
                        <Border Width="38" Height="38" CornerRadius="10" Background="{DynamicResource AccentMutedBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" Margin="0,0,10,0">
                            <TextBlock Text="&#xEC27;" FontFamily="Segoe MDL2 Assets" FontSize="19" Foreground="{DynamicResource AccentBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel x:Name="SidebarBrandText" VerticalAlignment="Center">
                            <TextBlock Text="SupportToolKit" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="Network &amp; IT Infrastructure" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"/>
                        </StackPanel>
                        <!-- Collapsed mode anchor -->
                        <TextBlock x:Name="NavLabel" Visibility="Collapsed"/>
                    </StackPanel>

                    <!-- Live Pulse Card -->
                    <Border Grid.Column="1" Style="{StaticResource HeaderBadge}" Margin="12,0,16,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" Fill="{DynamicResource SuccessBrush}" Margin="0,0,8,0"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Live Pulse" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"/>
                                <TextBlock Text="Connected" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SuccessBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Universal Search Bar with Ctrl / Shortcut -->
                    <Border Grid.Column="2" MaxWidth="440" Height="38" CornerRadius="10" Background="{DynamicResource InputBgBrush}"
                            BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1" VerticalAlignment="Center" Margin="0,0,16,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="36"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <!-- Search Icon -->
                            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                       Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            
                            <!-- Search TextBox -->
                            <TextBox x:Name="SearchBox" Grid.Column="1" Background="Transparent" BorderThickness="0"
                                     Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" VerticalContentAlignment="Center"
                                     CaretBrush="{DynamicResource AccentBrush}" TextChanged="OnSearchTextChanged"/>
                            
                            <!-- Placeholder -->
                            <TextBlock Grid.Column="1" IsHitTestVisible="False" Text="Search devices, IP, MAC, hostname..."
                                       FontSize="12" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- Shortcut Tag -->
                            <Border Grid.Column="2" Background="{DynamicResource CardBgAltBrush}" CornerRadius="6" Padding="6,2" Margin="0,0,8,0" VerticalAlignment="Center">
                                <TextBlock Text="Ctrl /" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Interface Selector & Active Scan Widget -->
                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                        <!-- Interface Selector Dropdown -->
                        <ComboBox Style="{StaticResource ModernDarkComboBox}"
                                  ItemsSource="{Binding NetworkAdapters}"
                                  SelectedItem="{Binding SelectedNetworkAdapter}"
                                  MinHeight="38"
                                  MinWidth="220"
                                  Margin="0,0,10,0"
                                  VerticalAlignment="Center">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="2,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="22" Height="22" CornerRadius="6" Background="#1510B981" BorderBrush="#3510B981" BorderThickness="1" Margin="0,0,8,0" VerticalAlignment="Center">
                                            <TextBlock Text="&#xE839;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="#10B981" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Description}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" MaxWidth="170" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding IPAddress, StringFormat={}{0}/24}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <!-- Active Scan Circular Badge -->
                        <Border Style="{StaticResource HeaderBadge}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="26" Height="26" CornerRadius="13" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2" Margin="0,0,8,0">
                                    <TextBlock Text="{Binding ActiveScanPercent, StringFormat={}{0}%, FallbackValue=100%}" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Active Subnet" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{Binding ActiveScanSubnet, FallbackValue=192.168.1.0/24}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Theme Toggle, User Profile & Window Controls -->
                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Theme Toggle -->
                        <Button x:Name="BtnThemeToggle" Width="36" Height="36" Background="Transparent" BorderThickness="0"
                                Cursor="Hand" Foreground="{DynamicResource TextSecondaryBrush}" Click="ToggleTheme" Margin="0,0,8,0">
                            <TextBlock x:Name="ThemeIcon" Text="&#xE708;" FontFamily="Segoe MDL2 Assets" FontSize="15"/>
                        </Button>

                        <!-- User Profile Chip -->
                        <Button x:Name="BtnProfile" Height="38" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="OnProfileClick" Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="32" Height="32" CornerRadius="16" Background="#1E3A8A" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" Margin="0,0,8,0">
                                    <TextBlock x:Name="UserAvatar" Text="A" FontSize="13" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,4,0">
                                    <TextBlock x:Name="UserDisplay" Text="Admin" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock x:Name="RoleDisplay" Text="Administrator" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"/>
                                </StackPanel>
                            </StackPanel>
                        </Button>

                        <!-- Window Buttons -->
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource WindowBtn}" Click="MinimizeWindow">
                                <TextBlock Text="&#xE921;"/>
                            </Button>
                            <Button x:Name="BtnMaximize" Style="{StaticResource WindowBtn}" Click="MaximizeWindow">
                                <TextBlock x:Name="MaxIcon" Text="&#xE922;"/>
                            </Button>
                            <Button Style="{StaticResource WindowCloseBtn}" Click="CloseWindow">
                                <TextBlock Text="&#xE8BB;"/>
                            </Button>
                        </StackPanel>
                    </StackPanel>

                </Grid>
            </Border>

            <!-- ============================================================ -->
            <!-- BODY (SIDEBAR + MAIN CONTENT)                                -->
            <!-- ============================================================ -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="SidebarColumn" Width="230"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT SIDEBAR -->
                <Border x:Name="SidebarPanel" Grid.Column="0" Background="{DynamicResource SidebarBgBrush}" BorderBrush="{DynamicResource SidebarDividerBrush}" BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Sidebar Hamburger Toggle Row -->
                        <Grid Grid.Row="0" Margin="16,14,16,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="NAVIGATION" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" x:Name="BtnToggleSidebar" Width="28" Height="28" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="ToggleSidebar">
                                <TextBlock Text="&#xE700;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource TextMutedBrush}"/>
                            </Button>
                        </Grid>

                        <!-- Navigation Items List -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <!-- 1. Dashboard (Active) -->
                                <Button x:Name="BtnDashboard" Style="{StaticResource NetScopeNavBtnActive}" Click="NavigateToDashboard">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="LblDashboard" Text="Dashboard" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <!-- 2. Network Scanner -->
                                <Button x:Name="BtnNetworkDiscovery" Style="{StaticResource NetScopeNavBtn}" Click="NavigateToNetworkDiscovery">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE704;" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="LblNetworkDiscovery" Text="Network Scanner" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <!-- 3. Live Topology -->
                                <Button x:Name="BtnLiveTopology" Style="{StaticResource NetScopeNavBtn}" Click="NavigateToLiveTopology">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="LblLiveTopology" Text="Live Topology" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <!-- 4. Port Checker -->
                                <Button x:Name="BtnPortChecker" Style="{StaticResource NetScopeNavBtn}" Click="NavigateToPortChecker">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8A6;" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="LblPortChecker" Text="Port Checker" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <!-- 5. Ping Monitor -->
                                <Button x:Name="BtnPingTool" Style="{StaticResource NetScopeNavBtn}" Click="NavigateToPingTool">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE95B;" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="LblPingTool" Text="Ping Monitor" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <!-- 6. Device Details -->
                                <Button x:Name="BtnSystemInfo" Style="{StaticResource NetScopeNavBtn}" Click="NavigateToSystemInfo">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE770;" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="LblSystemInfo" Text="Device Details" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <!-- 7. Windows Services -->
                                <Button x:Name="BtnWindowsServices" Style="{StaticResource NetScopeNavBtn}" Click="NavigateToWindowsServices">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="LblWindowsServices" Text="Windows Services" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <!-- 8. IIS Monitor -->
                                <Button x:Name="BtnIisMonitor" Style="{StaticResource NetScopeNavBtn}" Click="NavigateToIisMonitor">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="LblIisMonitor" Text="IIS Monitor" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <!-- 9. SQL Tester -->
                                <Button x:Name="BtnSqlTester" Style="{StaticResource NetScopeNavBtn}" Click="NavigateToSqlTester">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xEA47;" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="LblSqlTester" Text="SQL Tester" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <!-- 10. System Logs -->
                                <Button x:Name="BtnLogCollector" Style="{StaticResource NetScopeNavBtn}" Click="NavigateToLogCollector">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8A0;" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="LblLogCollector" Text="System Logs" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <!-- 11. Settings -->
                                <Button x:Name="BtnSettings" Style="{StaticResource NetScopeNavBtn}" Click="NavigateToSettings">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="LblSettings" Text="Settings" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <!-- Hidden items to preserve code-behind handlers if needed -->
                                <Button x:Name="BtnScreenshot" Visibility="Collapsed" Click="NavigateToScreenshot"><TextBlock x:Name="LblScreenshot"/></Button>
                                <Button x:Name="BtnLogout" Visibility="Collapsed" Click="Logout"><TextBlock x:Name="LblLogout"/></Button>
                                <Border x:Name="SidebarProfile" Visibility="Collapsed"/>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Bottom System Status & Scan Engine Status Cards -->
                        <StackPanel Grid.Row="2" Margin="14,8,14,14">
                            <!-- System Status -->
                            <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12,9" Margin="0,0,0,8">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                        <Ellipse Width="7" Height="7" Fill="{DynamicResource SuccessBrush}" Margin="0,0,8,0"/>
                                        <TextBlock Text="System Status" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    </StackPanel>
                                    <TextBlock Text="All Systems Operational" FontSize="10" Foreground="{DynamicResource SuccessBrush}" Margin="15,0,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Scan Engine Status Mini Widget with Sparkline Wave -->
                            <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12,9">
                                <StackPanel>
                                    <TextBlock Text="Scan Engine Status" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,2"/>
                                    <TextBlock Text="Idle" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                                    <Polyline Points="0,10 10,12 20,6 30,13 40,4 50,10 60,5 70,11 80,3 90,12 100,6 110,10 120,4 130,13 140,7 150,12 160,3 170,11 180,6 190,12"
                                              Stroke="#10B981" StrokeThickness="1.5" SnapsToDevicePixels="True"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                    </Grid>
                </Border>

                <!-- MAIN CONTENT AREA -->
                <Grid Grid.Column="1" Background="{DynamicResource PageBgBrush}">
                    <Frame x:Name="MainFrame" NavigationUIVisibility="Hidden" Margin="0,0,4,0"/>
                </Grid>
            </Grid>

            <!-- ============================================================ -->
            <!-- MODERN SIGN OUT / CONFIRMATION MODAL OVERLAY                 -->
            <!-- ============================================================ -->
            <Grid x:Name="SignOutModalOverlay" Grid.RowSpan="2" Panel.ZIndex="999" Visibility="Collapsed">
                <!-- Backdrop Blur / Dim -->
                <Border Background="#80000000" MouseDown="CancelSignOut_Click"/>

                <!-- Dialog Card -->
                <Border Width="380" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="{DynamicResource CardBgBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1" CornerRadius="16" Padding="24">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="30" ShadowDepth="8" Opacity="0.5" Color="#000000"/>
                    </Border.Effect>
                    <StackPanel HorizontalAlignment="Center">
                        <!-- Red / Danger Circular Icon Badge -->
                        <Border Width="56" Height="56" CornerRadius="28" Background="#20EF4444"
                                BorderBrush="#40EF4444" BorderThickness="1"
                                HorizontalAlignment="Center" Margin="0,0,0,16">
                            <TextBlock Text="&#xE7E8;" FontFamily="Segoe MDL2 Assets" FontSize="24"
                                       Foreground="#EF4444" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <!-- Modal Title -->
                        <TextBlock Text="Sign Out Confirmation" FontSize="16" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,8"/>

                        <!-- Modal Subtitle -->
                        <TextBlock Text="Are you sure you want to sign out from SupportToolKit?"
                                   FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,24" LineHeight="18"/>

                        <!-- Action Buttons -->
                        <Grid Width="310">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Cancel Button -->
                            <Button Grid.Column="0" Content="Cancel" Height="38"
                                    Style="{StaticResource BtnSecondary}"
                                    Click="CancelSignOut_Click"
                                    FontSize="12" FontWeight="SemiBold" Cursor="Hand"/>

                            <!-- Confirm Sign Out Button -->
                            <Button Grid.Column="2" Height="38"
                                    Background="#EF4444" Foreground="#FFFFFF"
                                    BorderBrush="#DC2626" BorderThickness="1"
                                    Click="ConfirmSignOut_Click"
                                    FontSize="12" FontWeight="Bold" Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="8"/>
                                    </Style>
                                </Button.Resources>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE7E8;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Sign Out" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

        </Grid>
    </Border>
</Window>
