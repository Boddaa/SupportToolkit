<Page x:Class="NetworkDiscoveryTool.UI.Views.DeviceDetails.DeviceDetailsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Device Details"
      Background="{DynamicResource PageBgBrush}">

    <ScrollViewer Style="{StaticResource Scroller}" VerticalScrollBarVisibility="Auto" Padding="28,20">
        <StackPanel MaxWidth="1400" HorizontalAlignment="Stretch">

            <!-- ======================================================== -->
            <!-- 1. TOP BREADCRUMB & UTILITY BAR                          -->
            <!-- ======================================================== -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Back Button -->
                <Button Command="{Binding GoBackCommand}" Style="{StaticResource BtnSecondary}" Height="36" Padding="14,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Back to Scanner" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Utility Actions (Refresh & Copy All) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Refresh Device -->
                    <Button Command="{Binding RefreshDeviceCommand}" Style="{StaticResource BtnSecondary}" Height="36" Padding="12,0" Margin="0,0,8,0" ToolTip="Refresh Device Diagnostics">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource AccentBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Refresh Status" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Copy All Diagnostics -->
                    <Button Command="{Binding CopyDiagnosticsCommand}" Style="{StaticResource BtnPrimary}" Height="36" Padding="14,0" ToolTip="Copy All Diagnostics to Clipboard">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="White" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Copy Diagnostics" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ======================================================== -->
            <!-- 2. HERO DEVICE PROFILE BANNER                            -->
            <!-- ======================================================== -->
            <Border Style="{StaticResource NetScopeCard}" Padding="20,18" Margin="0,0,0,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Large Device Icon Avatar -->
                    <Border Width="56" Height="56" CornerRadius="12" Background="{Binding DeviceIconBg}" BorderBrush="{Binding DeviceIconColor}" BorderThickness="1.5" Margin="0,0,18,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding DeviceIcon}" FontFamily="Segoe MDL2 Assets" FontSize="26" Foreground="{Binding DeviceIconColor}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <!-- Middle: Identity & Metadata -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- IP Address -->
                            <TextBlock Text="{Binding IP}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,12,0"/>

                            <!-- Online Status Pill -->
                            <Border CornerRadius="12" Padding="10,3" Background="{DynamicResource SuccessBgBrush}" BorderBrush="{DynamicResource SuccessBorderBrush}" BorderThickness="1" VerticalAlignment="Center" Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="6" Height="6" Fill="{DynamicResource SuccessBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}"/>
                                </StackPanel>
                            </Border>

                            <!-- Role Pill -->
                            <Border CornerRadius="6" Padding="8,2" Background="{DynamicResource AccentMutedBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding DeviceType}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                            </Border>
                        </StackPanel>

                        <!-- Hostname & MAC Row -->
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <!-- Hostname -->
                            <TextBlock Text="Hostname: " FontSize="12" Foreground="{DynamicResource TextMutedBrush}"/>
                            <TextBlock Text="{Binding Hostname}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,18,0"/>

                            <!-- Vendor -->
                            <TextBlock Text="Vendor: " FontSize="12" Foreground="{DynamicResource TextMutedBrush}"/>
                            <TextBlock Text="{Binding Vendor}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,18,0"/>

                            <!-- MAC -->
                            <TextBlock Text="MAC: " FontSize="12" Foreground="{DynamicResource TextMutedBrush}"/>
                            <TextBlock Text="{Binding MAC}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" FontFamily="Consolas, Cascadia Code"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Right: Quick Diagnostic Actions -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Ping -->
                        <Button Command="{Binding PingHostCommand}" Style="{StaticResource BtnSecondary}" Height="36" Padding="12,0" Margin="0,0,6,0" ToolTip="Continuous Live Ping in Terminal">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE95B;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource SuccessBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Ping" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Traceroute -->
                        <Button Command="{Binding TracerouteHostCommand}" Style="{StaticResource BtnSecondary}" Height="36" Padding="12,0" Margin="0,0,6,0" ToolTip="Trace Route Hops in Terminal">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE809;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource AccentBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Traceroute" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Port Audit -->
                        <Button Command="{Binding PortAuditCommand}" Style="{StaticResource BtnSecondary}" Height="36" Padding="12,0" Margin="0,0,6,0" ToolTip="Scan All Ports for this Device">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8B9;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource PurpleBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Port Audit" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- HTTP -->
                        <Button Command="{Binding OpenHttpCommand}" Style="{StaticResource BtnSecondary}" Height="36" Padding="12,0" Margin="0,0,6,0" ToolTip="Open Web Interface (HTTP)"
                                Visibility="{Binding HasHttp, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource AccentBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="HTTP" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- HTTPS -->
                        <Button Command="{Binding OpenHttpsCommand}" Style="{StaticResource BtnSecondary}" Height="36" Padding="12,0" Margin="0,0,6,0" ToolTip="Open Secure Web Interface (HTTPS)"
                                Visibility="{Binding HasHttps, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource SuccessBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="HTTPS" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- SSH -->
                        <Button Command="{Binding OpenSshCommand}" Style="{StaticResource BtnSecondary}" Height="36" Padding="12,0" Margin="0,0,6,0" ToolTip="Connect via SSH"
                                Visibility="{Binding HasSsh, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE756;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource WarningBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="SSH" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- RDP -->
                        <Button Command="{Binding OpenRdpCommand}" Style="{StaticResource BtnSecondary}" Height="36" Padding="12,0" ToolTip="Remote Desktop Connection"
                                Visibility="{Binding HasRdp, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource AccentBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="RDP" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ======================================================== -->
            <!-- 3. TOP METRICS KPI STRIP (4 CARDS)                       -->
            <!-- ======================================================== -->
            <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- KPI 1: Live Status & Latency -->
                <Border Grid.Column="0" Style="{StaticResource NetScopeCard}" Margin="0,0,10,0" Padding="16,14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Border Width="28" Height="28" CornerRadius="6" Background="{DynamicResource SuccessBgBrush}" BorderBrush="{DynamicResource SuccessBorderBrush}" BorderThickness="1" Margin="0,0,8,0">
                                <TextBlock Text="&#xE95B;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource SuccessBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Response Latency" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                            <TextBlock Text="{Binding Latency}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Bottom"/>
                            <TextBlock Text=" (RTT)" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Bottom" Margin="4,0,0,2"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- KPI 2: OS & Kernel Guess -->
                <Border Grid.Column="1" Style="{StaticResource NetScopeCard}" Margin="0,0,10,0" Padding="16,14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Border Width="28" Height="28" CornerRadius="6" Background="{DynamicResource AccentMutedBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" Margin="0,0,8,0">
                                <TextBlock Text="&#xE7F8;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Operating System" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Grid.Row="1" Text="{Binding OS}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Bottom" TextTrimming="CharacterEllipsis"/>
                    </Grid>
                </Border>

                <!-- KPI 3: Open Services Count -->
                <Border Grid.Column="2" Style="{StaticResource NetScopeCard}" Margin="0,0,10,0" Padding="16,14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Border Width="28" Height="28" CornerRadius="6" Background="{DynamicResource PurpleBgBrush}" BorderBrush="{DynamicResource PurpleBorderBrush}" BorderThickness="1" Margin="0,0,8,0">
                                <TextBlock Text="&#xE8A6;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource PurpleBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Open Service Ports" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                            <TextBlock Text="{Binding Ports.Count}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Bottom"/>
                            <TextBlock Text=" Active Endpoints" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Bottom" Margin="4,0,0,2"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- KPI 4: Last Seen & Batch -->
                <Border Grid.Column="3" Style="{StaticResource NetScopeCard}" Padding="16,14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Border Width="28" Height="28" CornerRadius="6" Background="{DynamicResource WarningBgBrush}" BorderBrush="{DynamicResource WarningBorderBrush}" BorderThickness="1" Margin="0,0,8,0">
                                <TextBlock Text="&#xEC92;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource WarningBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Last Discovered" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Grid.Row="1" Text="{Binding LastSeen}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Bottom" TextTrimming="CharacterEllipsis"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- ======================================================== -->
            <!-- 4. INTERACTIVE TAB STRIP: Overview | Ports | Audit Logs  -->
            <!-- ======================================================== -->
            <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="6,6" Margin="0,0,0,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- TAB 1: Hardware & Network Specs -->
                    <Button Grid.Column="0" Command="{Binding SetTabCommand}" CommandParameter="Overview" Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="0">
                        <Border CornerRadius="8" Padding="14,8">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsTabOverviewSelected}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource HoverBgBrush}"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Hardware &amp; Network Specs" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Button>

                    <!-- TAB 2: Open Ports & Services -->
                    <Button Grid.Column="1" Command="{Binding SetTabCommand}" CommandParameter="Ports" Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="0">
                        <Border CornerRadius="8" Padding="14,8">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsTabPortsSelected}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource HoverBgBrush}"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="&#xE8A6;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource PurpleBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Open Ports &amp; Services (" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Ports.Count}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text=")" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Button>

                    <!-- TAB 3: Timeline & Audit Logs -->
                    <Button Grid.Column="2" Command="{Binding SetTabCommand}" CommandParameter="Logs" Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="0">
                        <Border CornerRadius="8" Padding="14,8">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsTabLogsSelected}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource HoverBgBrush}"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="&#xE81C;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource WarningBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Timeline &amp; Operations History (" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding History.Count}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text=")" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Button>
                </Grid>
            </Border>

            <!-- ======================================================== -->
            <!-- 5. TAB 1 CONTENT: HARDWARE & NETWORK SPECS               -->
            <!-- ======================================================== -->
            <Grid Visibility="{Binding IsTabOverviewSelected, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Column: Layer 2 & 3 Network Specs -->
                <Border Grid.Column="0" Style="{StaticResource NetScopeCard}" Margin="0,0,10,0" Padding="22,18">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <Border Width="28" Height="28" CornerRadius="6" Background="{DynamicResource AccentMutedBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" Margin="0,0,10,0">
                                <TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Network Identity &amp; Interface" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- IP -->
                        <Border Background="{DynamicResource InputBgBrush}" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="IPv4 Address" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding IP}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                                <Button Grid.Column="2" Command="{Binding CopyFieldCommand}" CommandParameter="{Binding IP}" Style="{StaticResource BtnGhost}" Height="26" Padding="8,0" ToolTip="Copy IP">
                                    <TextBlock Text="Copy" FontSize="10" FontWeight="Bold"/>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- MAC -->
                        <Border Background="{DynamicResource InputBgBrush}" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="MAC Address" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding MAC}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="Consolas, Cascadia Code" VerticalAlignment="Center"/>
                                <Button Grid.Column="2" Command="{Binding CopyFieldCommand}" CommandParameter="{Binding MAC}" Style="{StaticResource BtnGhost}" Height="26" Padding="8,0" ToolTip="Copy MAC">
                                    <TextBlock Text="Copy" FontSize="10" FontWeight="Bold"/>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Vendor -->
                        <Border Background="{DynamicResource InputBgBrush}" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Hardware Vendor" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding Vendor}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Hostname -->
                        <Border Background="{DynamicResource InputBgBrush}" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Resolved Hostname" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding Hostname}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Device Role -->
                        <Border Background="{DynamicResource InputBgBrush}" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Device Role" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding DeviceType}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Right Column: OS Fingerprint & Web Banners -->
                <Border Grid.Column="1" Style="{StaticResource NetScopeCard}" Margin="10,0,0,0" Padding="22,18">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <Border Width="28" Height="28" CornerRadius="6" Background="{DynamicResource PurpleBgBrush}" BorderBrush="{DynamicResource PurpleBorderBrush}" BorderThickness="1" Margin="0,0,10,0">
                                <TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource PurpleBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Fingerprints &amp; Service Signatures" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- TTL Packet Fingerprint -->
                        <Border Background="{DynamicResource InputBgBrush}" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="TTL Fingerprint" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding TtlText}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Operating System -->
                        <Border Background="{DynamicResource InputBgBrush}" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Operating System" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding OS}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- HTTP Server Banner -->
                        <TextBlock Text="HTTP BANNER &amp; SERVER SIGNATURE" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,6"/>
                        <Border Background="{DynamicResource InputBgBrush}" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,12">
                            <TextBlock Text="{Binding HttpBanner}" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" FontFamily="Consolas, Cascadia Code"/>
                        </Border>

                        <!-- Notes & Tags -->
                        <TextBlock Text="SCAN BATCH &amp; NOTES" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,6"/>
                        <Border Background="{DynamicResource InputBgBrush}" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="14,10">
                            <TextBlock Text="{Binding ScanDescription}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ======================================================== -->
            <!-- 6. TAB 2 CONTENT: OPEN PORTS & SERVICES TABLE            -->
            <!-- ======================================================== -->
            <Border Visibility="{Binding IsTabPortsSelected, Converter={StaticResource BooleanToVisibilityConverter}}" Style="{StaticResource NetScopeCard}" Padding="0" Margin="0,0,0,20">
                <StackPanel>
                    <!-- Table Header Controls -->
                    <Border Background="{DynamicResource CardBgAltBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1" Padding="20,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="AUDITED PORTS &amp; ACTIVE PROTOCOLS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock Text=" (" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding Ports.Count}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                <TextBlock Text=" Open)" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                            </StackPanel>
                            <Button Grid.Column="1" Command="{Binding PortAuditCommand}" Style="{StaticResource BtnSecondary}" Height="30" Padding="12,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8A6;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="{DynamicResource AccentBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Launch Deep Port Scan" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Column Titles -->
                    <Border Background="{DynamicResource InputBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1" Padding="20,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="PORT" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                            <TextBlock Grid.Column="1" Text="STATE" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                            <TextBlock Grid.Column="2" Text="SERVICE NAME" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                            <TextBlock Grid.Column="3" Text="PROTOCOL / CLASSIFICATION" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                        </Grid>
                    </Border>

                    <!-- Rows -->
                    <ItemsControl ItemsSource="{Binding Ports}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="Transparent" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1" Padding="20,11">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource HoverBgBrush}"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="220"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Port Badge -->
                                        <Border Grid.Column="0" Background="{DynamicResource AccentMutedBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="4" Padding="8,2" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding Port}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                        </Border>

                                        <!-- State Badge -->
                                        <Border Grid.Column="1" Background="{DynamicResource SuccessBgBrush}" BorderBrush="{DynamicResource SuccessBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8,2" HorizontalAlignment="Left">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="5" Height="5" Fill="{DynamicResource SuccessBrush}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding State}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Service -->
                                        <TextBlock Grid.Column="2" Text="{Binding Service}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>

                                        <!-- Description -->
                                        <TextBlock Grid.Column="3" Text="TCP Active Service Endpoint" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Empty State -->
                    <Border Padding="40" Visibility="{Binding HasNoPorts, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="&#xE8B9;" FontFamily="Segoe MDL2 Assets" FontSize="32" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                            <TextBlock Text="No Open Ports Detected Yet" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                            <TextBlock Text="Click 'Launch Deep Port Scan' above to scan all ports on this device." FontSize="11" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ======================================================== -->
            <!-- 7. TAB 3 CONTENT: TIMELINE & OPERATION LOGS              -->
            <!-- ======================================================== -->
            <Border Visibility="{Binding IsTabLogsSelected, Converter={StaticResource BooleanToVisibilityConverter}}" Style="{StaticResource NetScopeCard}" Padding="0" Margin="0,0,0,20">
                <StackPanel>
                    <!-- Table Header -->
                    <Border Background="{DynamicResource InputBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1" Padding="20,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="TIMESTAMP" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                            <TextBlock Grid.Column="1" Text="OPERATION" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                            <TextBlock Grid.Column="2" Text="DETAILS / METRICS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                            <TextBlock Grid.Column="3" Text="STATUS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                            <TextBlock Grid.Column="4" Text="LATENCY" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                        </Grid>
                    </Border>

                    <!-- History Items -->
                    <ItemsControl ItemsSource="{Binding History}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="Transparent" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1" Padding="20,11">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource HoverBgBrush}"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="160"/>
                                            <ColumnDefinition Width="180"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="100"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Date}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Operation}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Description}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                        <Border Grid.Column="3" Background="{DynamicResource SuccessBgBrush}" BorderBrush="{DynamicResource SuccessBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8,2" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding Result}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}"/>
                                        </Border>
                                        <TextBlock Grid.Column="4" Text="{Binding Duration}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Empty State -->
                    <Border Padding="40" Visibility="{Binding HasNoHistory, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="&#xE81C;" FontFamily="Segoe MDL2 Assets" FontSize="32" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                            <TextBlock Text="No Previous Operations Logged" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                            <TextBlock Text="Any pings, port scans, or discovery batches performed on this IP will appear in this timeline." FontSize="11" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Bottom Margin Buffer -->
            <Border Height="40" Background="Transparent"/>

        </StackPanel>
    </ScrollViewer>
</Page>
