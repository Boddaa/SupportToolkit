<Page x:Class="NetworkDiscoveryTool.UI.Views.Topology.TopologyPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Live Network Topology"
      Background="{DynamicResource PageBgBrush}">

    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ======================================================== -->
        <!-- TOP TOOLBAR: Title + Zoom + Layout + Subnets + Refresh   -->
        <!-- ======================================================== -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Title & Live Indicator -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Live Network Topology" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                <Border Background="#1510B981" BorderBrush="#3510B981" BorderThickness="1" CornerRadius="12" Padding="8,3" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="6" Height="6" Fill="#10B981" Margin="0,0,6,0"/>
                        <TextBlock Text="Real-time" FontSize="11" FontWeight="SemiBold" Foreground="#10B981"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Right Controls Toolbar -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Zoom Controls -->
                <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Height="34" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <Button Command="{Binding ZoomOutCommand}" Width="28" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="Zoom Out">
                            <TextBlock Text="&#xE738;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center"/>
                        </Button>
                        <TextBlock Text="{Binding ZoomText}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" Width="40" TextAlignment="Center"/>
                        <Button Command="{Binding ZoomInCommand}" Width="28" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="Zoom In">
                            <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center"/>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Auto Layout Button -->
                <Button Command="{Binding AutoLayoutCommand}" Style="{StaticResource BtnSecondary}" Height="34" Padding="12,0" Margin="0,0,10,0" ToolTip="Auto Organize Nodes">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8D7;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Auto Layout" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Fit to Screen Button -->
                <Button Command="{Binding FitToScreenCommand}" Style="{StaticResource BtnSecondary}" Height="34" Padding="12,0" Margin="0,0,10,0" ToolTip="Fit to Canvas">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE740;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Fit to Screen" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Filter Dropdown -->
                <ComboBox Style="{StaticResource NetScopeCombo}"
                          ItemsSource="{Binding FilterOptions}"
                          SelectedItem="{Binding SelectedFilter}"
                          Width="130" Height="34" Margin="0,0,10,0"/>

                <!-- Subnet Dropdown -->
                <ComboBox Style="{StaticResource NetScopeCombo}"
                          ItemsSource="{Binding Subnets}"
                          SelectedItem="{Binding SelectedSubnet}"
                          Width="150" Height="34" Margin="0,0,10,0"/>

                <!-- Refresh Button -->
                <Button Command="{Binding RefreshTopologyCommand}" Style="{StaticResource BtnActionIcon}" Width="34" Height="34" ToolTip="Refresh Topology Map">
                    <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ======================================================== -->
        <!-- MAIN CANVAS & SIDE PANELS LAYOUT                         -->
        <!-- ======================================================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="310"/>
            </Grid.ColumnDefinitions>

            <!-- ==================================================== -->
            <!-- LEFT COLUMN: Legend + Link Status + Network Health   -->
            <!-- ==================================================== -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
                <StackPanel>
                    <!-- CARD 1: Device Legend -->
                    <Border Style="{StaticResource NetScopeCard}" Margin="0,0,0,12" Padding="14,12">
                        <StackPanel>
                            <TextBlock Text="Device Legend" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,10"/>

                            <Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE809;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#0EA5E9" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="Router" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding RouterCount}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </Grid>

                            <Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#0EA5E9" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="Switch" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding SwitchCount}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </Grid>

                            <Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#8B5CF6" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="Server" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding ServerCount}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </Grid>

                            <Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE714;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#F59E0B" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="IP Camera" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding CameraCount}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </Grid>

                            <Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE7F8;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#38BDF8" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="Workstation" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding WorkstationCount}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </Grid>

                            <Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE749;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#10B981" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="Printer" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding PrinterCount}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </Grid>

                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE897;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="Unknown" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding UnknownCount}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- CARD 2: Link Status -->
                    <Border Style="{StaticResource NetScopeCard}" Margin="0,0,0,12" Padding="14,12">
                        <StackPanel>
                            <TextBlock Text="Link Status" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,10"/>

                            <Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Rectangle Height="2" Fill="#0EA5E9" VerticalAlignment="Center" RadiusX="1" RadiusY="1"/>
                                <TextBlock Grid.Column="1" Text="Active (1Gbps+)" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="8,0,0,0"/>
                            </Grid>

                            <Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Rectangle Height="2" Fill="#64748B" VerticalAlignment="Center" RadiusX="1" RadiusY="1"/>
                                <TextBlock Grid.Column="1" Text="Inactive" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="8,0,0,0"/>
                            </Grid>

                            <Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Rectangle Height="2" Fill="#F59E0B" VerticalAlignment="Center" RadiusX="1" RadiusY="1"/>
                                <TextBlock Grid.Column="1" Text="Warning (High Jitter)" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="8,0,0,0"/>
                            </Grid>

                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Rectangle Height="2" Fill="#EF4444" VerticalAlignment="Center" RadiusX="1" RadiusY="1"/>
                                <TextBlock Grid.Column="1" Text="Critical (Down)" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="8,0,0,0"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- CARD 3: Network Health -->
                    <Border Style="{StaticResource NetScopeCard}" Padding="14,12">
                        <StackPanel>
                            <TextBlock Text="Network Health" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8"/>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Ellipse Width="7" Height="7" Fill="#10B981" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="All Systems Operational" FontSize="11" FontWeight="SemiBold" Foreground="#10B981" VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Availability -->
                            <TextBlock Text="Availability" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"/>
                            <Grid Margin="0,2,0,8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding AvailabilityText}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,6,0"/>
                                <TextBlock Grid.Column="1" Text="{Binding AvailabilityDelta}" FontSize="10" FontWeight="SemiBold" Foreground="#10B981" VerticalAlignment="Center"/>
                                <Polyline Grid.Column="2" Points="0,10 10,8 20,4 30,7 40,2 50,5" Stroke="#0EA5E9" StrokeThickness="1.5" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Avg Latency -->
                            <TextBlock Text="Avg. Latency" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"/>
                            <Grid Margin="0,2,0,8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding AvgLatencyText}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,6,0"/>
                                <TextBlock Grid.Column="1" Text="{Binding LatencyDelta}" FontSize="10" FontWeight="SemiBold" Foreground="#10B981" VerticalAlignment="Center"/>
                                <Polyline Grid.Column="2" Points="0,6 10,4 20,9 30,5 40,3 50,4" Stroke="#10B981" StrokeThickness="1.5" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Packet Loss -->
                            <TextBlock Text="Packet Loss" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"/>
                            <Grid Margin="0,2,0,8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding PacketLossText}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,6,0"/>
                                <TextBlock Grid.Column="1" Text="{Binding PacketLossDelta}" FontSize="10" FontWeight="SemiBold" Foreground="#10B981" VerticalAlignment="Center"/>
                                <Polyline Grid.Column="2" Points="0,2 10,2 20,4 30,2 40,2 50,2" Stroke="#8B5CF6" StrokeThickness="1.5" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Devices Online -->
                            <TextBlock Text="Devices Online" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"/>
                            <Grid Margin="0,2,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding DevicesOnlineText}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,6,0"/>
                                <TextBlock Grid.Column="1" Text="{Binding DevicesOnlinePercent}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                                <Polyline Grid.Column="2" Points="0,8 10,7 20,5 30,3 40,2 50,1" Stroke="#0EA5E9" StrokeThickness="1.5" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ==================================================== -->
            <!-- CENTER COLUMN: Interactive Cyber Topology Canvas     -->
            <!-- ==================================================== -->
            <Border Grid.Column="1" Background="#060C17" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Margin="0,0,12,0" ClipToBounds="True">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <Grid x:Name="TopologySurface" Background="#060C17" Width="{Binding CanvasWidth}" Height="{Binding CanvasHeight}">
                        <Grid.LayoutTransform>
                            <ScaleTransform ScaleX="{Binding ZoomScale}" ScaleY="{Binding ZoomScale}"/>
                        </Grid.LayoutTransform>

                        <!-- Dynamic Connecting Links (Wires between Gateway, Switches, and Endpoints) -->
                        <ItemsControl ItemsSource="{Binding Links}" IsHitTestVisible="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Line X1="{Binding StartX}" Y1="{Binding StartY}"
                                          X2="{Binding EndX}" Y2="{Binding EndY}"
                                          Stroke="{Binding LinkBrush}" StrokeThickness="{Binding StrokeThickness}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Interactive Clickable Node Cards -->
                        <ItemsControl ItemsSource="{Binding Nodes}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                    <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- Node Card with Transform Centering -->
                                    <Button Command="{Binding DataContext.SelectNodeCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                            CommandParameter="{Binding}"
                                            Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand">
                                        <Button.RenderTransform>
                                            <TranslateTransform X="-60" Y="-25"/>
                                        </Button.RenderTransform>
                                        <Border CornerRadius="8" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="8,6" MinWidth="115">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                            <Setter Property="Background" Value="{DynamicResource HoverBgBrush}"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel>
                                                <Grid Margin="0,0,0,3">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                    <Border Width="22" Height="22" CornerRadius="4" Background="{DynamicResource AccentMutedBrush}" Margin="0,0,6,0">
                                                        <TextBlock Text="{Binding Icon}" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                </Grid>
                                                <TextBlock Text="{Binding IPAddress}" FontSize="9" FontWeight="SemiBold" Foreground="#38BDF8" Margin="0,0,0,3"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Ellipse Width="5" Height="5" Margin="0,0,4,0" VerticalAlignment="Center">
                                                            <Ellipse.Style>
                                                                <Style TargetType="Ellipse">
                                                                    <Setter Property="Fill" Value="#10B981"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Status}" Value="Offline">
                                                                            <Setter Property="Fill" Value="#64748B"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Ellipse.Style>
                                                        </Ellipse>
                                                        <TextBlock Text="{Binding Status}" FontSize="9" FontWeight="SemiBold">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="#34D399"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Status}" Value="Offline">
                                                                            <Setter Property="Foreground" Value="#94A3B8"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Text="{Binding Category}" FontSize="8" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </ScrollViewer>
            </Border>

            <!-- ==================================================== -->
            <!-- RIGHT COLUMN: Selected Node Inspector & Live Details -->
            <!-- ==================================================== -->
            <Border Grid.Column="2" Style="{StaticResource NetScopeCard}" Padding="16,14"
                    Visibility="{Binding HasSelectedNode, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Inspector Header: Icon + Name + Close Button -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="36" Height="36" CornerRadius="8" Background="{DynamicResource AccentMutedBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" Margin="0,0,10,0">
                            <TextBlock Text="{Binding SelectedNode.Icon}" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding SelectedNode.Name}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding SelectedNode.SubTitle}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <Button Grid.Column="2" Command="{Binding CloseInspectorCommand}" Style="{StaticResource BtnActionIcon}" Width="26" Height="26" ToolTip="Close">
                            <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"/>
                        </Button>
                    </Grid>

                    <!-- Tab Strip (Overview | Ports & Services | Uplink / Neighbors) -->
                    <Border Grid.Row="1" Background="{DynamicResource InputBgBrush}" CornerRadius="6" Padding="3" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <!-- Tab 1: Overview -->
                            <Button Command="{Binding SetInspectorTabCommand}" CommandParameter="Overview"
                                    Background="Transparent" BorderThickness="0" Padding="0,5" Cursor="Hand">
                                <Border CornerRadius="4" Padding="0,3">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsOverviewTabSelected}" Value="True">
                                                    <Setter Property="Background" Value="#150EA5E9"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="Overview" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsOverviewTabSelected}" Value="True">
                                                        <Setter Property="Foreground" Value="#0EA5E9"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </Button>

                            <!-- Tab 2: Ports & Services -->
                            <Button Grid.Column="1" Command="{Binding SetInspectorTabCommand}" CommandParameter="Interfaces"
                                    Background="Transparent" BorderThickness="0" Padding="0,5" Cursor="Hand">
                                <Border CornerRadius="4" Padding="0,3">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsInterfacesTabSelected}" Value="True">
                                                    <Setter Property="Background" Value="#150EA5E9"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="Ports" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsInterfacesTabSelected}" Value="True">
                                                        <Setter Property="Foreground" Value="#0EA5E9"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </Button>

                            <!-- Tab 3: Uplink & Neighbors -->
                            <Button Grid.Column="2" Command="{Binding SetInspectorTabCommand}" CommandParameter="Traffic"
                                    Background="Transparent" BorderThickness="0" Padding="0,5" Cursor="Hand">
                                <Border CornerRadius="4" Padding="0,3">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsTrafficTabSelected}" Value="True">
                                                    <Setter Property="Background" Value="#150EA5E9"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="Uplink" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsTrafficTabSelected}" Value="True">
                                                        <Setter Property="Foreground" Value="#0EA5E9"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Tab Contents Container -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <!-- TAB CONTENT 1: OVERVIEW -->
                            <StackPanel Visibility="{Binding IsOverviewTabSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                                
                                <!-- Connection Relationship Callout -->
                                <Border Background="#1038BDF8" BorderBrush="#3538BDF8" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="Network Topology Link" FontSize="10" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,2"/>
                                        <TextBlock Text="{Binding SelectedNode.ConnectedToText}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <!-- Properties Table -->
                                <Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="IP Address" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding SelectedNode.IPAddress}" FontSize="12" FontWeight="Bold" Foreground="#38BDF8"/>
                                </Grid>
                                <Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="MAC Address" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding SelectedNode.MACAddress}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </Grid>
                                <Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Vendor" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding SelectedNode.Vendor}" FontSize="11" FontWeight="SemiBold" Foreground="#38BDF8"/>
                                </Grid>
                                <Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Device Type" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding SelectedNode.Category}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </Grid>
                                <Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Latency" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding SelectedNode.LatencyText}" FontSize="11" FontWeight="SemiBold" Foreground="#34D399"/>
                                </Grid>
                                <Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="OS / Specs" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding SelectedNode.OSVersion}" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </Grid>
                                <Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Status" FontSize="11" Foreground="#94A3B8"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Ellipse Width="6" Height="6" Fill="#10B981" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding SelectedNode.Status}" FontSize="11" FontWeight="Bold" Foreground="#34D399"/>
                                    </StackPanel>
                                </Grid>
                                <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Last Seen" FontSize="11" Foreground="#94A3B8"/>
                                    <TextBlock Grid.Column="1" Text="{Binding SelectedNode.LastSeen}" FontSize="11" Foreground="#94A3B8"/>
                                </Grid>

                                <!-- Quick Ping Status Notification -->
                                <TextBlock Text="{Binding QuickPingStatus}" FontSize="11" FontWeight="SemiBold" Foreground="#38BDF8" HorizontalAlignment="Center" Margin="0,0,0,6"
                                           Visibility="{Binding QuickPingStatus.Length, Converter={StaticResource IntToVisibilityConverter}}"/>

                                <!-- Action Buttons Grid -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- Ping Live -->
                                    <Button Command="{Binding PingSelectedNodeCommand}" Style="{StaticResource BtnSecondary}" Height="28" Margin="0,0,4,0" ToolTip="Test Live Ping">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="10" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Ping" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <!-- Copy IP -->
                                    <Button Grid.Column="1" Command="{Binding CopyNodeIpCommand}" Style="{StaticResource BtnSecondary}" Height="28" Margin="4,0,0,0" ToolTip="Copy IP to Clipboard">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="10" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Copy IP" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <!-- Web & Remote Desktop Shortcuts -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Command="{Binding OpenWebAdminCommand}" IsEnabled="{Binding SelectedNode.IsWebAccessible}" Style="{StaticResource BtnSecondary}" Height="28" Margin="0,0,4,0" ToolTip="Open Web Browser Interface">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets" FontSize="10" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Web UI" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Column="1" Command="{Binding ConnectRdpCommand}" IsEnabled="{Binding SelectedNode.IsRdpAccessible}" Style="{StaticResource BtnSecondary}" Height="28" Margin="4,0,0,0" ToolTip="Connect with Remote Desktop">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE836;" FontFamily="Segoe MDL2 Assets" FontSize="10" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="RDP" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <!-- Open Detailed Device Profile Button -->
                                <Button Command="{Binding OpenDeviceDetailsCommand}" Style="{StaticResource BtnPrimary}" Height="32" Margin="0,0,0,12" ToolTip="Open Full Diagnostics for this Device">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="&#xE712;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Open Full Device Details" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <!-- TAB CONTENT 2: PORTS & SERVICES -->
                            <StackPanel Visibility="{Binding IsInterfacesTabSelected, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,0,12">
                                <TextBlock Text="{Binding SelectedNode.OpenPortsCountText}" FontSize="12" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,8"/>
                                
                                <ItemsControl ItemsSource="{Binding SelectedNode.OpenPorts}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#09111E" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,0,0,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Background="#2038BDF8" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                                        <TextBlock Text="{Binding PortNumber, StringFormat={}Port {0}}" FontSize="10" FontWeight="Bold" Foreground="{Binding BadgeColor}"/>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding ServiceName}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                        <TextBlock Text="{Binding Protocol}" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                    </StackPanel>
                                                    <Border Grid.Column="2" Background="#1510B981" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding State}" FontSize="9" FontWeight="Bold" Foreground="#34D399"/>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="No open ports were recorded during scan" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,15,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedNode.HasOpenPorts}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>

                            <!-- TAB CONTENT 3: TOPOLOGY & NEIGHBORS -->
                            <StackPanel Visibility="{Binding IsTrafficTabSelected, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,0,12">
                                <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="Switch Uplink Port" FontSize="10" FontWeight="Bold" Foreground="#38BDF8"/>
                                        <TextBlock Text="{Binding SelectedNode.SwitchPortText, StringFormat={}Port: {0}}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2,0,0"/>
                                        <TextBlock Text="{Binding SelectedNode.ConnectedSwitchName, StringFormat={}Switch: {0}}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Connected Neighbors List -->
                                <TextBlock Text="Connected Devices &amp; Neighbors" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                                <ItemsControl ItemsSource="{Binding ConnectedNeighbors}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="Transparent" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1" Padding="0,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Icon}" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="#38BDF8" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding Role}" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2" Text="{Binding IPAddress}" FontSize="10" Foreground="#38BDF8" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                    <Ellipse Grid.Column="3" Width="6" Height="6" Fill="{Binding StatusColor}" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                        </StackPanel>
                    </ScrollViewer>

                    <!-- Export Topology Button -->
                    <Button Grid.Row="3" Command="{Binding ExportTopologyCommand}" Style="{StaticResource BtnSecondary}" Height="34" Margin="0,10,0,0" ToolTip="Export Topology PNG / JSON">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="&#xE78C;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Export Topology" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>