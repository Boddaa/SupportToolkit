<Page x:Class="NetworkDiscoveryTool.UI.Views.OperationHistory.OperationHistoryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:core="clr-namespace:NetworkDiscoveryTool.Core.Models;assembly=NetworkDiscoveryTool.Core"
      Title="Operation History"
      Background="{DynamicResource PageBgBrush}"
      Loaded="Page_Loaded">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="📋 Operation History" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
            <TextBlock Text="{Binding StatusText}" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Filter Bar -->
        <Border Grid.Row="1" Background="{DynamicResource CardBgBrush}" Padding="16" CornerRadius="10"
                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Margin="0,0,0,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Filter Row 1 -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ComboBox Grid.Column="0" ItemsSource="{Binding OperationNames}" SelectedItem="{Binding FilterOperation}"
                              Height="32" FontSize="12" Background="{DynamicResource InputBgBrush}"
                              BorderBrush="{DynamicResource InputBorderBrush}" Margin="0,0,8,0">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontSize="12"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <TextBox Grid.Column="1" Text="{Binding FilterUsername}" Height="32" FontSize="12" Padding="4"
                             Background="{DynamicResource InputBgBrush}" BorderBrush="{DynamicResource InputBorderBrush}"
                             Margin="0,0,8,0"/>

                    <ComboBox Grid.Column="2" ItemsSource="{Binding ResultOptions}" SelectedItem="{Binding FilterResult}"
                              Height="32" FontSize="12" Background="{DynamicResource InputBgBrush}"
                              BorderBrush="{DynamicResource InputBorderBrush}" Margin="0,0,8,0"/>

                    <StackPanel Grid.Column="3" Orientation="Horizontal">
                        <DatePicker SelectedDate="{Binding FilterFrom}" Height="32" FontSize="12" Width="130"
                                    Background="{DynamicResource InputBgBrush}" BorderBrush="{DynamicResource InputBorderBrush}"
                                    Margin="0,0,8,0"/>
                        <TextBlock Text="—" VerticalAlignment="Center" FontSize="14" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,8,0"/>
                        <DatePicker SelectedDate="{Binding FilterTo}" Height="32" FontSize="12" Width="130"
                                    Background="{DynamicResource InputBgBrush}" BorderBrush="{DynamicResource InputBorderBrush}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="4" Orientation="Horizontal" Margin="8,0,0,0">
                        <Button Command="{Binding SearchCommand}" Content="🔍 Search" Height="32" Width="80" Margin="0,0,6,0"
                                Background="{DynamicResource AccentBrush}" Foreground="White" FontWeight="Bold" FontSize="12" BorderThickness="0" Cursor="Hand"/>
                        <Button Command="{Binding ClearFiltersCommand}" Content="Clear" Height="32" Width="70" Margin="0,0,6,0"
                                Background="{DynamicResource InputBgBrush}" Foreground="{DynamicResource TextSecondaryBrush}"
                                BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1" Cursor="Hand"/>
                        <Button Command="{Binding RefreshCommand}" Content="⟳" Height="32" Width="36"
                                Background="{DynamicResource InputBgBrush}" Foreground="{DynamicResource TextSecondaryBrush}"
                                BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1" Cursor="Hand"/>
                    </StackPanel>
                </Grid>

                <!-- Stats Row -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="{DynamicResource InputBgBrush}" Padding="10,6" CornerRadius="6" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Total: " FontSize="12" Foreground="{DynamicResource TextMutedBrush}"/>
                            <TextBlock Text="{Binding TotalCount}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="  ·  Filtered: " FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="8,0,0,0"/>
                            <TextBlock Text="{Binding FilteredCount}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>
                    </Border>

                    <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" MaxWidth="400">
                        <TextBlock Text="{Binding OperationStatsText}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                    </ScrollViewer>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Command="{Binding ExportToExcelCommand}" Content="📊 Export to Excel" Height="30" Width="130" Margin="0,0,8,0"
                                Background="{DynamicResource SuccessBrush}" Foreground="White" FontWeight="Bold" FontSize="11" BorderThickness="0" Cursor="Hand"/>
                        <Button Command="{Binding DeleteEntryCommand}" Content="🗑 Delete Selected" Height="30" Width="110" Margin="0,0,8,0"
                                Background="{DynamicResource DangerBrush}" Foreground="White" FontWeight="Bold" FontSize="11" BorderThickness="0" Cursor="Hand"/>
                        <Button Command="{Binding ClearAllCommand}" Content="Clear All" Height="30" Width="80"
                                Background="{DynamicResource InputBgBrush}" Foreground="{DynamicResource TextSecondaryBrush}"
                                BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1" Cursor="Hand"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- History DataGrid -->
        <Border Grid.Row="2" Background="{DynamicResource CardBgBrush}" Padding="16" CornerRadius="10"
                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
            <Grid>
                <DataGrid ItemsSource="{Binding Entries}" SelectedItem="{Binding SelectedEntry}"
                          AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                          Background="Transparent" BorderThickness="0" RowHeaderWidth="0"
                          AlternatingRowBackground="{DynamicResource InputBgBrush}" RowBackground="Transparent"
                          HeadersVisibility="Column" FontSize="12">
                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="{DynamicResource InputBgBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextLabelBrush}"/>
                            <Setter Property="FontSize" Value="11"/>
                            <Setter Property="Height" Value="32"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        </Style>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            <Setter Property="FontSize" Value="12"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="4,0"/>
                        </Style>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Height" Value="34"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
                            <Setter Property="BorderThickness" Value="0,0,0,0.5"/>
                        </Style>
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Operation" Binding="{Binding OperationName}" Width="140"/>
                        <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
                        <DataGridTextColumn Header="Date" Binding="{Binding Timestamp, StringFormat={}{0:yyyy-MM-dd}}" Width="100"/>
                        <DataGridTextColumn Header="Time" Binding="{Binding Timestamp, StringFormat={}{0:HH:mm:ss}}" Width="80"/>
                        <DataGridTextColumn Header="Result" Binding="{Binding Result}" Width="90">
                            <DataGridTextColumn.CellStyle>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                    <Setter Property="FontSize" Value="12"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Padding" Value="4,0"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Result}" Value="Success">
                                            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Result}" Value="Failed">
                                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTextColumn.CellStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Duration (ms)" Binding="{Binding DurationMs}" Width="100"/>
                        <DataGridTextColumn Header="User" Binding="{Binding Username}" Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Loading Overlay -->
                <Border Background="{DynamicResource CardBgBrush}" Opacity="0.8"
                        Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="⟳" FontSize="24" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Loading..." FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Page>
