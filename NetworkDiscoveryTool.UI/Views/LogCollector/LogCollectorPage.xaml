<Page x:Class="NetworkDiscoveryTool.UI.Views.LogCollector.LogCollectorPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
      Title="Log Collector"
      Background="{DynamicResource PageBgBrush}"
      Loaded="Page_Loaded">

    <Page.Resources>
        <Style x:Key="LogCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16"/>
        </Style>

        <Style x:Key="SourceToggle" TargetType="Border" BasedOn="{StaticResource LogCard}">
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ActionBtn" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="md:ButtonAssist.CornerRadius" Value="8"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.9"/></Trigger>
                <Trigger Property="IsPressed" Value="True"><Setter Property="Opacity" Value="0.8"/></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TimelineBar" TargetType="Border">
            <Setter Property="Height" Value="18"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.Margin>24</Grid.Margin>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ============================================================ -->
        <!-- LEFT PANEL — Config, Sources, Drop Zone, Stats, Actions      -->
        <!-- ============================================================ -->
        <ScrollViewer Style="{StaticResource Scroller}" Margin="0,0,12,0">
            <StackPanel>

                <!-- Header -->
                <StackPanel Margin="0,0,0,16">
                    <TextBlock Text="Log Collector" Style="{StaticResource HeadingXL}"/>
                    <TextBlock Text="Collect and package log files from multiple sources"
                               Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                </StackPanel>

                <!-- ======== SOURCE TOGGLE: APPLICATION LOGS ======== -->
                <Border Style="{StaticResource SourceToggle}" Margin="0,0,0,8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="34" Height="34" CornerRadius="8"
                                    Background="{DynamicResource AccentMutedBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1">
                                <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Application Logs" Style="{StaticResource Body}" FontWeight="SemiBold"/>
                                <TextBlock Text=".log files from app directory" Style="{StaticResource Caption}"/>
                            </StackPanel>
                            <CheckBox Grid.Column="2" IsChecked="{Binding CollectAppLogs}"
                                      Style="{StaticResource ChkBox}"/>
                        </Grid>
                        <StackPanel Grid.Row="1" Margin="42,10,0,0"
                                    Visibility="{Binding CollectAppLogs, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="Folder Path" Style="{StaticResource Caption}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding AppLogPath}" Style="{StaticResource TxtBox}" Height="30" FontSize="12"/>
                            <TextBlock Text="File Pattern" Style="{StaticResource Caption}" Margin="0,8,0,4"/>
                            <TextBox Text="{Binding AppLogPattern}" Style="{StaticResource TxtBox}" Height="30" FontSize="12"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ======== SOURCE TOGGLE: EVENT LOGS ======== -->
                <Border Style="{StaticResource SourceToggle}" Margin="0,0,0,8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="34" Height="34" CornerRadius="8"
                                    Background="{DynamicResource WarningBgBrush}" BorderBrush="{DynamicResource WarningBrush}" BorderThickness="1">
                                <TextBlock Text="&#xE9F9;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource WarningBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Windows Event Logs" Style="{StaticResource Body}" FontWeight="SemiBold"/>
                                <TextBlock Text="Application, System, Security events" Style="{StaticResource Caption}"/>
                            </StackPanel>
                            <CheckBox Grid.Column="2" IsChecked="{Binding CollectEventLogs}"
                                      Style="{StaticResource ChkBox}"/>
                        </Grid>
                        <TextBlock Grid.Row="1" Margin="42,10,0,0" Style="{StaticResource BodySm}"
                                   Text="Exports recent events from Windows Event Log"
                                   Visibility="{Binding CollectEventLogs, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    </Grid>
                </Border>

                <!-- ======== SOURCE TOGGLE: IIS LOGS ======== -->
                <Border Style="{StaticResource SourceToggle}" Margin="0,0,0,8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="34" Height="34" CornerRadius="8"
                                    Background="{DynamicResource SuccessBgBrush}" BorderBrush="{DynamicResource SuccessBrush}" BorderThickness="1">
                                <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource SuccessBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="IIS Web Server Logs" Style="{StaticResource Body}" FontWeight="SemiBold"/>
                                <TextBlock Text="W3C formatted web server log files" Style="{StaticResource Caption}"/>
                            </StackPanel>
                            <CheckBox Grid.Column="2" IsChecked="{Binding CollectIisLogs}"
                                      Style="{StaticResource ChkBox}"/>
                        </Grid>
                        <StackPanel Grid.Row="1" Margin="42,10,0,0"
                                    Visibility="{Binding CollectIisLogs, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="IIS Log Path" Style="{StaticResource Caption}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding IisLogPath}" Style="{StaticResource TxtBox}" Height="30" FontSize="12"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ======== SOURCE TOGGLE: CUSTOM FOLDER ======== -->
                <Border Style="{StaticResource SourceToggle}" Margin="0,0,0,14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="34" Height="34" CornerRadius="8"
                                    Background="{DynamicResource InfoBgBrush}" BorderBrush="{DynamicResource InfoBrush}" BorderThickness="1">
                                <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource InfoBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Custom Directory" Style="{StaticResource Body}" FontWeight="SemiBold"/>
                                <TextBlock Text="Any localized directory with log files" Style="{StaticResource Caption}"/>
                            </StackPanel>
                            <CheckBox Grid.Column="2" IsChecked="{Binding CollectCustomFolder}"
                                      Style="{StaticResource ChkBox}"/>
                        </Grid>
                        <StackPanel Grid.Row="1" Margin="42,10,0,0"
                                    Visibility="{Binding CollectCustomFolder, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="Folder Path" Style="{StaticResource Caption}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding CustomFolderPath}" Style="{StaticResource TxtBox}" Height="30" FontSize="12"/>
                            <TextBlock Text="File Pattern" Style="{StaticResource Caption}" Margin="0,8,0,4"/>
                            <TextBox Text="{Binding CustomFilePattern}" Style="{StaticResource TxtBox}" Height="30" FontSize="12"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ======== DRAG & DROP ZONE ======== -->
                <Border x:Name="DropZone" AllowDrop="True" Padding="20" CornerRadius="10"
                        Background="{DynamicResource CardBgBrush}" Margin="0,0,0,14"
                        DragEnter="DropZone_DragEnter" DragLeave="DropZone_DragLeave" Drop="DropZone_Drop"
                        BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1.5">
                    <StackPanel HorizontalAlignment="Center">
                        <Border Width="48" Height="48" CornerRadius="24"
                                Background="{DynamicResource AccentMutedBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                                HorizontalAlignment="Center" Margin="0,0,0,10">
                            <TextBlock Text="&#xE898;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="{DynamicResource AccentBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Drop log files or directories here" Style="{StaticResource Body}"
                                   Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" FontWeight="SemiBold"/>
                        <TextBlock Text="or click Browse to manually select files" Style="{StaticResource Caption}"
                                   HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        <Button Style="{StaticResource ActionBtn}"
                                Background="{DynamicResource AccentBrush}" Height="32" Padding="16,0"
                                HorizontalAlignment="Center" Margin="0,10,0,0"
                                Click="BrowseFiles_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Browse Local Files" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- ======== DATE RANGE ======== -->
                <Border Style="{StaticResource LogCard}" Margin="0,0,0,14" Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource AccentBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Date Filter Range" Style="{StaticResource Label}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Grid Grid.Row="1" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="42"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="From" Style="{StaticResource Caption}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            <DatePicker Grid.Column="1" SelectedDate="{Binding FromDate}"
                                        Height="32" FontSize="12"
                                        Background="{DynamicResource InputBgBrush}"
                                        BorderBrush="{DynamicResource InputBorderBrush}"
                                        Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </Grid>
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="42"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="To" Style="{StaticResource Caption}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            <DatePicker Grid.Column="1" SelectedDate="{Binding ToDate}"
                                        Height="32" FontSize="12"
                                        Background="{DynamicResource InputBgBrush}"
                                        BorderBrush="{DynamicResource InputBorderBrush}"
                                        Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </Grid>
                    </Grid>
                </Border>

                <!-- ======== STATS ======== -->
                <Border Style="{StaticResource LogCard}" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Files Found" Style="{StaticResource Caption}"/>
                            <TextBlock Text="{Binding PreviewCount, FallbackValue=0}" FontSize="24" FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Total Size" Style="{StaticResource Caption}"/>
                            <TextBlock Text="{Binding PreviewSize, FallbackValue=0 B}" FontSize="24" FontWeight="Bold"
                                       Foreground="{DynamicResource AccentBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ======== PROGRESS ======== -->
                <Border Style="{StaticResource LogCard}" Margin="0,0,0,14" Padding="14"
                        Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding StatusText}" Style="{StaticResource BodySm}"/>
                            <TextBlock Grid.Column="1" Text="processing..." Style="{StaticResource Caption}"/>
                        </Grid>
                        <ProgressBar Style="{StaticResource LoadingSpinner}" Height="4"
                                     Foreground="{DynamicResource AccentBrush}"/>
                    </StackPanel>
                </Border>

                <!-- ======== RESULT ======== -->
                <Border Padding="16" Margin="0,0,0,14"
                        Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource LogCard}">
                            <Setter Property="Padding" Value="16"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasResult}" Value="True">
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                 From="0" To="1" Duration="0:0:0.4"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="40" Height="40" CornerRadius="10"
                                Background="{DynamicResource SuccessBgBrush}" BorderBrush="{DynamicResource SuccessBrush}" BorderThickness="1">
                            <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{DynamicResource SuccessBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                            <TextBlock Text="Collection Complete" Style="{StaticResource Body}" FontWeight="Bold"
                                       Foreground="{DynamicResource SuccessBrush}"/>
                            <TextBlock Text="{Binding CollectResult.PackageSize}"
                                       Style="{StaticResource Caption}"/>
                            <TextBlock Text="{Binding CollectResult.FileCount, StringFormat='{}{0} files archived'}"
                                       Style="{StaticResource Caption}"/>
                        </StackPanel>
                        <Button Grid.Column="2" Command="{Binding OpenPackageFolderCommand}"
                                Style="{StaticResource ActionBtn}"
                                Background="{DynamicResource AccentBrush}" Height="32" Padding="12,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8DA;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Open Folder" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!-- ======== ACTIONS ======== -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Command="{Binding PreviewCommand}"
                            Style="{StaticResource ActionBtn}"
                            Background="{DynamicResource AccentBrush}" Margin="0,0,6,0"
                            IsEnabled="{Binding IsLoading, Converter={StaticResource BooleanNotConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8A1;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Preview" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="1" Command="{Binding CollectCommand}"
                            Style="{StaticResource ActionBtn}"
                            Background="{DynamicResource SuccessBrush}" Margin="6,0,6,0"
                            IsEnabled="{Binding IsLoading, Converter={StaticResource BooleanNotConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7B8;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Collect &amp; ZIP" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="2" Command="{Binding ClearAllCommand}"
                            Style="{StaticResource ActionBtn}"
                            Background="{DynamicResource InputBgBrush}" Foreground="{DynamicResource TextSecondaryBrush}"
                            BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1"
                            Width="75">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE894;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Clear" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- ======== ERROR ======== -->
                <Border Background="{DynamicResource DangerBgBrush}" Padding="12" CornerRadius="8"
                        BorderBrush="{DynamicResource DangerBrush}" BorderThickness="1"
                        Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE783;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource DangerBrush}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding ErrorMessage}" Style="{StaticResource BodySm}"
                                   Foreground="{DynamicResource DangerBrush}" Margin="8,0,0,0" TextWrapping="Wrap" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- ============================================================ -->
        <!-- RIGHT PANEL — Preview DataGrid, Timeline, ZIP Preview        -->
        <!-- ============================================================ -->
        <Grid Grid.Column="1" Margin="12,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ======== PREVIEW DATAGRID ======== -->
            <Border Style="{StaticResource LogCard}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Padding="14,12"
                            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Preview Files" Style="{StaticResource HeadingSm}"/>
                            <Border Grid.Column="1" Margin="10,0,0,0"
                                    Background="{DynamicResource AccentBrush}"
                                    CornerRadius="4" Padding="8,2" BorderThickness="0"
                                    Visibility="{Binding PreviewCount, Converter={StaticResource IntToVisibilityConverter}}">
                                <TextBlock Text="{Binding PreviewCount, StringFormat={}{0} files}"
                                           FontSize="10" FontWeight="Bold" Foreground="White"/>
                            </Border>
                            <TextBlock Grid.Column="2" Text="{Binding PreviewSize}"
                                       Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding PreviewFiles}"
                              AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="False"
                              Style="{StaticResource DGrid}" RowHeight="36">
                        <DataGrid.Resources>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource DGridColHeader}"/>
                            <Style TargetType="DataGridCell" BasedOn="{StaticResource DGridCell}"/>
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource DGridRow}"/>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="" Binding="{Binding Selected}" Width="36">
                                <DataGridCheckBoxColumn.ElementStyle>
                                    <Style TargetType="CheckBox">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridCheckBoxColumn.ElementStyle>
                            </DataGridCheckBoxColumn>
                            <DataGridTextColumn Header="Source" Binding="{Binding Source}"
                                                SortMemberPath="Source" Width="80"/>
                            <DataGridTextColumn Header="File Name" Binding="{Binding FileName}"
                                                SortMemberPath="FileName" Width="*"/>
                            <DataGridTextColumn Header="Size" Binding="{Binding SizeDisplay}"
                                                SortMemberPath="SizeBytes" Width="80"/>
                            <DataGridTextColumn Header="Modified" Binding="{Binding LastModified, StringFormat={}{0:yyyy-MM-dd HH:mm}}"
                                                SortMemberPath="LastModified" Width="140"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- ======== TIMELINE ======== -->
            <Border Grid.Row="1" Padding="16" Margin="0,12,0,0"
                    Visibility="{Binding PreviewCount, Converter={StaticResource IntToVisibilityConverter}}">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource LogCard}">
                        <Setter Property="Padding" Value="16"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding PreviewCount}" Value="0">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Timeline" Style="{StaticResource Label}"/>
                            <TextBlock Text="Files by modification date" Style="{StaticResource Caption}"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding TimelineDays.Count, StringFormat='{}{0} days'}"
                                   Style="{StaticResource Caption}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding TimelineDays}" MaxHeight="160">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="30"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Label}" Style="{StaticResource Caption}"
                                               VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Count}" Style="{StaticResource Caption}"
                                               FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <Grid Grid.Column="2" Height="18" Margin="8,0,0,0">
                                        <Border Background="{DynamicResource InputBgBrush}" CornerRadius="3"/>
                                        <Border Background="{DynamicResource AccentBrush}" CornerRadius="3"
                                                HorizontalAlignment="Left" Width="{Binding BarWidth}"
                                                Opacity="{Binding BarOpacity}"/>
                                        <Border CornerRadius="3" HorizontalAlignment="Left"
                                                Width="{Binding BarWidth}" Background="Transparent">
                                            <TextBlock Text="{Binding Count, StringFormat='{}{0} files'}"
                                                       FontSize="9" Foreground="White" Margin="6,0"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ======== ZIP PREVIEW ======== -->
            <Border Grid.Row="2" Margin="0,12,0,0"
                    Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibilityConverter}}">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource LogCard}">
                        <Setter Property="Margin" Value="0,12,0,0"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasResult}" Value="True">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                             From="0" To="1" Duration="0:0:0.4"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="40" Height="40" CornerRadius="8"
                            Background="{DynamicResource AccentMutedBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1">
                        <TextBlock Text="&#xE7B8;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{DynamicResource AccentBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                        <TextBlock Text="ZIP Archive Ready" Style="{StaticResource Body}" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock Text="{Binding CollectResult.FileCount, StringFormat='{}{0} files archived'}"
                                       Style="{StaticResource Caption}" Margin="0,0,10,0"/>
                            <TextBlock Text="•" Style="{StaticResource Caption}" Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding CollectResult.PackageSize}"
                                       Style="{StaticResource Caption}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Command="{Binding OpenPackageFolderCommand}"
                                Style="{StaticResource ActionBtn}"
                                Background="{DynamicResource AccentBrush}" Height="32" Padding="14,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8DA;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Open" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
