<Page x:Class="NetworkDiscoveryTool.UI.Views.Compare.ComparePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Compare Scans"
      Background="{DynamicResource PageBgBrush}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Compare Scans" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,20"/>

        <Border Grid.Row="1" Background="{DynamicResource CardBgBrush}" Padding="20" CornerRadius="8" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Scan A" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextLabelBrush}"/>
                <ComboBox Grid.Column="1" ItemsSource="{Binding Scans}" DisplayMemberPath="Date" SelectedItem="{Binding ScanA}" Height="34" FontSize="13" Margin="8,0"/>
                <TextBlock Grid.Column="2" Text="Scan B" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextLabelBrush}"/>
                <ComboBox Grid.Column="3" ItemsSource="{Binding Scans}" DisplayMemberPath="Date" SelectedItem="{Binding ScanB}" Height="34" FontSize="13" Margin="8,0"/>
                <Button Grid.Column="4" Command="{Binding CompareCommand}" Content="Compare" Height="34" Width="90" Background="{DynamicResource AccentBrush}" Foreground="White" FontWeight="Bold" FontSize="13" BorderThickness="0" Cursor="Hand"/>
            </Grid>
        </Border>

        <!-- Comparison Stats -->
        <Border Grid.Row="2" Background="{DynamicResource CardBgBrush}" Padding="20" CornerRadius="8" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Margin="0,0,0,16">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="New" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding NewDevices}" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}" HorizontalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                        <TextBlock Text="Missing" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding MissingDevices}" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource DangerBrush}" HorizontalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                        <TextBlock Text="Hostname Changed" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding ChangedHostname}" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource WarningBrush}" HorizontalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                        <TextBlock Text="Vendor Changed" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding ChangedVendor}" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource ChartColor5}" HorizontalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4" HorizontalAlignment="Center">
                        <TextBlock Text="Status Changed" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding ChangedStatus}" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="5" HorizontalAlignment="Center">
                        <TextBlock Text="Unchanged" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding UnchangedDevices}" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
                <TextBlock Text="{Binding CompareStatus}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,8,0,0"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{DynamicResource CardBgBrush}" CornerRadius="8" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Margin="0,0,8,0">
                <DataGrid ItemsSource="{Binding ScanADevices}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" BorderThickness="0" FontSize="11" RowHeight="28" HeadersVisibility="Column"
                          AlternatingRowBackground="{DynamicResource InputBgBrush}">
                    <DataGrid.Resources><Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="{DynamicResource InputBgBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextLabelBrush}"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Height" Value="32"/><Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/><Setter Property="BorderThickness" Value="0,0,0,1"/></Style>
                    <Style TargetType="DataGridCell"><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/><Setter Property="BorderThickness" Value="0"/></Style></DataGrid.Resources>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="IP" Binding="{Binding IP}" Width="*"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="60"/>
                        <DataGridTextColumn Header="Hostname" Binding="{Binding Hostname}" Width="*"/>
                        <DataGridTextColumn Header="Vendor" Binding="{Binding Vendor}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
            <Border Grid.Column="1" Background="{DynamicResource CardBgBrush}" CornerRadius="8" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Margin="8,0,0,0">
                <DataGrid ItemsSource="{Binding ScanBDevices}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" BorderThickness="0" FontSize="11" RowHeight="28" HeadersVisibility="Column"
                          AlternatingRowBackground="{DynamicResource InputBgBrush}">
                    <DataGrid.Resources><Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="{DynamicResource InputBgBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextLabelBrush}"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Height" Value="32"/><Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/><Setter Property="BorderThickness" Value="0,0,0,1"/></Style>
                    <Style TargetType="DataGridCell"><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/><Setter Property="BorderThickness" Value="0"/></Style></DataGrid.Resources>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="IP" Binding="{Binding IP}" Width="*"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="60"/>
                        <DataGridTextColumn Header="Hostname" Binding="{Binding Hostname}" Width="*"/>
                        <DataGridTextColumn Header="Vendor" Binding="{Binding Vendor}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>
    </Grid>
</Page>
