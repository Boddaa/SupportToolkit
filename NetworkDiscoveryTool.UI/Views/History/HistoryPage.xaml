<Page x:Class="NetworkDiscoveryTool.UI.Views.History.HistoryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Scan History"
      Background="{DynamicResource PageBgBrush}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="3*"/>
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="Scan History" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Command="{Binding ClearAllHistoryCommand}" Content="Clear All" Height="34" Width="90" Margin="0,0,8,0"
                    Background="{DynamicResource DangerBrush}" Foreground="White" FontWeight="Bold" FontSize="13" BorderThickness="0" Cursor="Hand"
                    Visibility="{Binding IsAdmin, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            <Button Grid.Column="2" Command="{Binding LoadHistoryCommand}" Content="Refresh"
                    Height="34" Width="90" Background="{DynamicResource AccentBrush}" Foreground="White" FontWeight="Bold" FontSize="13" BorderThickness="0" Cursor="Hand"/>
        </Grid>

        <Border Grid.Row="1" Background="{DynamicResource CardBgBrush}" CornerRadius="8" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Margin="0,0,0,12">
            <DataGrid ItemsSource="{Binding Scans}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                      AlternatingRowBackground="{DynamicResource InputBgBrush}" BorderThickness="0" FontSize="12" RowHeight="36" HeadersVisibility="Column"
                      SelectionMode="Single" MouseDoubleClick="HistoryGrid_MouseDoubleClick" SelectionChanged="DataGrid_SelectionChanged">
                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="{DynamicResource InputBgBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextLabelBrush}"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Height" Value="36"/><Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/><Setter Property="BorderThickness" Value="0,0,0,1"/></Style>
                    <Style TargetType="DataGridCell"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="BorderThickness" Value="0"/></Style>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                    <DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" Width="160"/>
                    <DataGridTextColumn Header="Start IP" Binding="{Binding StartIP}" Width="120"/>
                    <DataGridTextColumn Header="End IP" Binding="{Binding EndIP}" Width="120"/>
                    <DataGridTextColumn Header="Duration" Binding="{Binding DurationMs, StringFormat={}{0}ms}" Width="90"/>
                    <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
                    <DataGridTemplateColumn Header="" Width="60" IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Delete" Height="26" Width="50" Background="{DynamicResource DangerBrush}" Foreground="White" FontWeight="Bold" FontSize="10" BorderThickness="0" Cursor="Hand"
                                        Command="{Binding DataContext.DeleteScanCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"
                                        Visibility="{Binding DataContext.IsAdmin, RelativeSource={RelativeSource AncestorType=DataGrid}, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <TextBlock Grid.Row="2" Text="Selected Scan Devices" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12"/>

        <Border Grid.Row="3" Background="{DynamicResource CardBgBrush}" CornerRadius="8" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
            <DataGrid ItemsSource="{Binding SelectedScanDevices}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                      AlternatingRowBackground="{DynamicResource InputBgBrush}" BorderThickness="0" FontSize="12" RowHeight="32" HeadersVisibility="Column">
                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="{DynamicResource InputBgBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextLabelBrush}"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Height" Value="36"/></Style>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="IP" Binding="{Binding IP}" Width="130"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="70"/>
                    <DataGridTextColumn Header="MAC" Binding="{Binding MAC}" Width="140"/>
                    <DataGridTextColumn Header="Hostname" Binding="{Binding Hostname}" Width="*"/>
                    <DataGridTextColumn Header="Type" Binding="{Binding DeviceType}" Width="130"/>
                    <DataGridTextColumn Header="Vendor" Binding="{Binding Vendor}" Width="110"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Page>
