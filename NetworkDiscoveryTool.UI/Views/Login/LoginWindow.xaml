<Window x:Class="NetworkDiscoveryTool.UI.Views.Login.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="SupportToolKit - IT Operations Authentication"
        Icon="pack://application:,,,/SupportToolKit;component/Assets/app.ico"
        Height="540"
        Width="860"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <Window.Resources>
        <!-- Logo pulse animation -->
        <Storyboard x:Key="LogoPulse" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="LogoIcon"
                             Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                             To="1.05" Duration="0:0:3"/>
            <DoubleAnimation Storyboard.TargetName="LogoIcon"
                             Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                             To="1.05" Duration="0:0:3"/>
            <DoubleAnimation Storyboard.TargetName="LogoGlow"
                             Storyboard.TargetProperty="Opacity"
                             To="0.6" Duration="0:0:3"/>
        </Storyboard>

        <!-- Error shake animation -->
        <Storyboard x:Key="ErrorShake">
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                             From="0" To="10" Duration="0:0:0.04" AutoReverse="True"
                             RepeatBehavior="3x"/>
        </Storyboard>

        <!-- Storyboards for code-behind compatibility -->
        <Storyboard x:Key="FloatBlob1"/>
        <Storyboard x:Key="FloatBlob2"/>
        <Storyboard x:Key="FloatBlob3"/>

        <!-- Card fade-in on load -->
        <Storyboard x:Key="CardFadeIn">
            <DoubleAnimation Storyboard.TargetName="MainContainer"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.45"/>
            <DoubleAnimation Storyboard.TargetName="MainContainer"
                             Storyboard.TargetProperty="RenderTransform.(TranslateTransform.Y)"
                             From="15" To="0" Duration="0:0:0.45"
                             DecelerationRatio="0.3"/>
        </Storyboard>

        <!-- Window Control Button Style -->
        <Style x:Key="LoginWinBtn" TargetType="Button">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource HoverBgBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="LoginWinCloseBtn" TargetType="Button" BasedOn="{StaticResource LoginWinBtn}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource DangerBrush}"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Primary Cyber Button Style -->
        <Style x:Key="CyberPrimaryBtn" TargetType="Button">
            <Setter Property="Height" Value="44"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#4038BDF8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" CornerRadius="10" BorderThickness="{TemplateBinding BorderThickness}"
                                BorderBrush="{TemplateBinding BorderBrush}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#0284C7" Offset="0"/>
                                    <GradientStop Color="#0EA5E9" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="BorderBrush" Value="#8038BDF8"/>
                                <Setter Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="18" Color="#0EA5E9" Opacity="0.45" ShadowDepth="0"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom Input Box Style with Left Icon Support -->
        <Style x:Key="CyberInputContainer" TargetType="Border">
            <Setter Property="Height" Value="42"/>
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Background" Value="{DynamicResource InputBgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <!-- Main Window Shell with Outer Border & Glow -->
    <Border x:Name="MainContainer" CornerRadius="16" Background="{DynamicResource SurfaceBgBrush}"
            BorderBrush="{DynamicResource SurfaceBorderBrush}" BorderThickness="1" SnapsToDevicePixels="True"
            Opacity="0" RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
            <TranslateTransform/>
        </Border.RenderTransform>
        <Border.Effect>
            <DropShadowEffect BlurRadius="32" Color="#000000" Opacity="0.45" ShadowDepth="4"/>
        </Border.Effect>

        <Grid>
            <Grid.ColumnDefinitions>
                <!-- 0: Left Cyber Showcase (Width: 380) -->
                <ColumnDefinition Width="380"/>
                <!-- 1: Right Authentication Hub (Width: *) -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ======================================================== -->
            <!-- LEFT PANEL: CYBER SHOWCASE & FEATURE SUITE               -->
            <!-- ======================================================== -->
            <Border Grid.Column="0" CornerRadius="15,0,0,15" ClipToBounds="True" MouseLeftButtonDown="WindowDrag_MouseLeftButtonDown">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#060B14" Offset="0"/>
                        <GradientStop Color="#091326" Offset="0.5"/>
                        <GradientStop Color="#050912" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>

                <Grid>
                    <!-- Background Radar Wave Pattern (Subtle) -->
                    <Canvas IsHitTestVisible="False" Opacity="0.06">
                        <Ellipse Width="400" Height="400" Stroke="#38BDF8" StrokeThickness="1" Canvas.Left="-100" Canvas.Top="-80"/>
                        <Ellipse Width="600" Height="600" Stroke="#38BDF8" StrokeThickness="1" Canvas.Left="-200" Canvas.Top="-180"/>
                        <Ellipse Width="800" Height="800" Stroke="#38BDF8" StrokeThickness="1" Canvas.Left="-300" Canvas.Top="-280"/>
                    </Canvas>

                    <!-- Content Layout -->
                    <Grid Margin="32,28,32,24">
                        <Grid.RowDefinitions>
                            <!-- 0: Brand Header -->
                            <RowDefinition Height="Auto"/>
                            <!-- 1: Feature Showcase -->
                            <RowDefinition Height="*"/>
                            <!-- 2: Security Assurance Footer -->
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Brand Header with Glowing Icon -->
                        <StackPanel Grid.Row="0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Glowing Hexagon/Waveform Icon -->
                                <Border x:Name="LogoIcon" Width="44" Height="44" CornerRadius="12"
                                        Background="#0C2D48" BorderBrush="#0EA5E9" BorderThickness="1.5"
                                        Margin="0,0,14,0" RenderTransformOrigin="0.5,0.5">
                                    <Border.RenderTransform>
                                        <ScaleTransform ScaleX="1" ScaleY="1"/>
                                    </Border.RenderTransform>
                                    <Grid>
                                        <!-- Glow Filter -->
                                        <Border x:Name="LogoGlow" CornerRadius="12" Background="#0EA5E9" Opacity="0.3">
                                            <Border.Effect>
                                                <BlurEffect Radius="14"/>
                                            </Border.Effect>
                                        </Border>
                                        <TextBlock Text="&#xEC27;" FontFamily="Segoe MDL2 Assets" FontSize="21"
                                                   Foreground="#0EA5E9" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="SupportToolKit" FontSize="18" FontWeight="Bold" Foreground="#F8FAFC"/>
                                    <TextBlock Text="Network Discovery &amp; IT Operations" FontSize="11" Foreground="#38BDF8"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>

                        <!-- Feature Bullet Showcase -->
                        <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,16,0,16">
                            <!-- Feature 1 -->
                            <Border Background="#0B162C" BorderBrush="#1E2E4A" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="30" Height="30" CornerRadius="8" Background="#150EA5E9" BorderBrush="#350EA5E9" BorderThickness="1" Margin="0,0,12,0" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE701;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#0EA5E9" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Live Subnet Discovery" FontSize="12" FontWeight="SemiBold" Foreground="#F8FAFC"/>
                                        <TextBlock Text="High-throughput ARP &amp; ICMP sweeps" FontSize="10" Foreground="#64748B"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Feature 2 -->
                            <Border Background="#0B162C" BorderBrush="#1E2E4A" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="30" Height="30" CornerRadius="8" Background="#1510B981" BorderBrush="#3510B981" BorderThickness="1" Margin="0,0,12,0" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE968;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#10B981" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Socket &amp; Port Auditing" FontSize="12" FontWeight="SemiBold" Foreground="#F8FAFC"/>
                                        <TextBlock Text="Deep banner grabbing &amp; service ID" FontSize="10" Foreground="#64748B"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Feature 3 -->
                            <Border Background="#0B162C" BorderBrush="#1E2E4A" BorderThickness="1" CornerRadius="10" Padding="14,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="30" Height="30" CornerRadius="8" Background="#15A855F7" BorderBrush="#35A855F7" BorderThickness="1" Margin="0,0,12,0" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE770;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#A855F7" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Service &amp; IIS Forensic Supervisor" FontSize="12" FontWeight="SemiBold" Foreground="#F8FAFC"/>
                                        <TextBlock Text="Real-time daemon control &amp; health" FontSize="10" Foreground="#64748B"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- ======================================================== -->
            <!-- RIGHT PANEL: AUTHENTICATION & ONBOARDING CONSOLE         -->
            <!-- ======================================================== -->
            <Grid Grid.Column="1" Background="{DynamicResource SurfaceBgBrush}">
                <Grid.RowDefinitions>
                    <!-- 0: Top Window Chrome (Minimize / Close) -->
                    <RowDefinition Height="40"/>
                    <!-- 1: Interactive Auth Form -->
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Top Window Controls and Drag Bar -->
                <Border Grid.Row="0" Background="Transparent" MouseLeftButtonDown="WindowDrag_MouseLeftButtonDown">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,8,0">
                        <Button Style="{StaticResource LoginWinBtn}" Content="&#xE921;" ToolTip="Minimize" Click="MinimizeBtn_Click"/>
                        <Button Style="{StaticResource LoginWinCloseBtn}" Content="&#xE8BB;" ToolTip="Close" Click="CloseBtn_Click"/>
                    </StackPanel>
                </Border>

                <!-- Auth Scroll Area -->
                <Grid Grid.Row="1" Margin="44,0,44,24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Header & Mode Switcher -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,20">
                        <!-- Dynamic Title -->
                        <TextBlock FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="Workstation Sign In"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ShowRegister}" Value="True">
                                            <Setter Property="Text" Value="Create Administrator Profile"/>
                                        </DataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding HasRememberedProfile}" Value="True"/>
                                                <Condition Binding="{Binding ShowManualLogin}" Value="False"/>
                                                <Condition Binding="{Binding ShowRegister}" Value="False"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Text" Value="Welcome Back"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <TextBlock FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="Authenticate your identity to launch the network discovery console."/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ShowRegister}" Value="True">
                                            <Setter Property="Text" Value="Set up your local credentials to manage network discovery assets."/>
                                        </DataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding HasRememberedProfile}" Value="True"/>
                                                <Condition Binding="{Binding ShowManualLogin}" Value="False"/>
                                                <Condition Binding="{Binding ShowRegister}" Value="False"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Text" Value="Saved profile detected. Click to restore your previous session."/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- Error Banner (Animated Shake) -->
                        <Border x:Name="ErrorBorder"
                                Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}"
                                Background="{DynamicResource DangerBgBrush}" BorderBrush="{DynamicResource DangerBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="12,8" Margin="0,14,0,0" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <TranslateTransform/>
                            </Border.RenderTransform>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE783;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource DangerBrush}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding ErrorMessage}" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource DangerBrush}" Margin="8,0,0,0" TextWrapping="Wrap" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Live Telegram Approval Waiting Banner -->
                        <Border Visibility="{Binding IsWaitingForApproval, Converter={StaticResource BoolToVisibilityConverter}}"
                                Background="{DynamicResource WarningBgBrush}" BorderBrush="{DynamicResource WarningBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="12,10" Margin="0,14,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="28" Height="28" CornerRadius="14" Background="{DynamicResource WarningBrush}" Margin="0,0,10,0" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE715;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="Black" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Waiting for Administrator Approval..." FontSize="11" FontWeight="Bold" Foreground="{DynamicResource WarningBrush}"/>
                                    <TextBlock Text="Your authorization request is pending admin confirmation" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Command="{Binding CheckApprovalNowCommand}" Height="24" Padding="8,0"
                                            Background="{DynamicResource AccentBrush}" Foreground="White" FontSize="10" FontWeight="Bold"
                                            BorderThickness="0" Cursor="Hand" md:ButtonAssist.CornerRadius="4" Margin="0,0,4,0">
                                        <TextBlock Text="Check Now"/>
                                    </Button>
                                    <Button Command="{Binding CancelWaitingCommand}" Height="24" Width="24"
                                            Background="Transparent" Foreground="{DynamicResource TextMutedBrush}"
                                            BorderThickness="0" Cursor="Hand" ToolTip="Cancel">
                                        <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- Form Content Area -->
                    <Grid Grid.Row="1">

                        <!-- ==================================================== -->
                        <!-- 0. REMEMBERED WORKSTATION PROFILE VIEW               -->
                        <!-- ==================================================== -->
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding HasRememberedProfile}" Value="True"/>
                                                <Condition Binding="{Binding ShowManualLogin}" Value="False"/>
                                                <Condition Binding="{Binding ShowRegister}" Value="False"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <!-- Workstation Host Pill -->
                            <Border HorizontalAlignment="Left" Background="#120EA5E9" BorderBrush="#300EA5E9" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="0,0,0,12">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE7F8;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="#38BDF8" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="WORKSTATION: " FontSize="10" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding RememberedWorkstation}" FontSize="10" FontWeight="SemiBold" Foreground="#F8FAFC" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- Clickable Interactive Profile Card -->
                            <Border Cursor="Hand" Background="#0B162C" BorderBrush="#2538BDF8" BorderThickness="1" CornerRadius="12" Padding="16,14" Margin="0,0,0,16">
                                <Border.InputBindings>
                                    <MouseBinding MouseAction="LeftClick" Command="{Binding QuickLoginCommand}"/>
                                </Border.InputBindings>
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="BorderBrush" Value="#0EA5E9"/>
                                                <Setter Property="Background" Value="#0F1E3A"/>
                                                <Setter Property="Effect">
                                                    <Setter.Value>
                                                        <DropShadowEffect BlurRadius="16" Color="#0EA5E9" Opacity="0.35" ShadowDepth="0"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Avatar with online badge -->
                                    <Grid Grid.Column="0" Margin="0,0,14,0" VerticalAlignment="Center">
                                        <Border Width="52" Height="52" CornerRadius="26" BorderBrush="#0EA5E9" BorderThickness="2">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#0284C7" Offset="0"/>
                                                    <GradientStop Color="#0EA5E9" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <TextBlock Text="{Binding RememberedAvatarLetter}" FontSize="22" FontWeight="Bold" Foreground="White"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <Border Width="12" Height="12" CornerRadius="6" Background="#10B981" BorderBrush="#0B162C" BorderThickness="2"
                                                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-1,-1">
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="6" Color="#10B981" Opacity="0.8" ShadowDepth="0"/>
                                            </Border.Effect>
                                        </Border>
                                    </Grid>

                                    <!-- User Details -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding RememberedUsername}" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,8,0"/>
                                            <Border Background="#150EA5E9" BorderBrush="#350EA5E9" BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding RememberedRole}" FontSize="9" FontWeight="Bold" Foreground="#38BDF8"/>
                                            </Border>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <TextBlock Text="&#xEC92;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                            <TextBlock Text="{Binding RememberedLastActive}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Arrow Icon -->
                                    <Border Grid.Column="2" Width="32" Height="32" CornerRadius="8" Background="#150EA5E9" BorderBrush="#300EA5E9" BorderThickness="1" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#38BDF8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Primary Action Button -->
                            <Button Command="{Binding QuickLoginCommand}"
                                    Height="44" Margin="0,0,0,14"
                                    IsEnabled="{Binding IsLoading, Converter={StaticResource BooleanNotConverter}}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource CyberPrimaryBtn}">
                                        <Setter Property="IsDefault" Value="False"/>
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding HasRememberedProfile}" Value="True"/>
                                                    <Condition Binding="{Binding ShowManualLogin}" Value="False"/>
                                                    <Condition Binding="{Binding ShowRegister}" Value="False"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="IsDefault" Value="True"/>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Grid>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE785;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Unlock &amp; Restore Session" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <!-- Secondary Options -->
                            <Grid Margin="0,2,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0" Command="{Binding SwitchAccountCommand}" Style="{StaticResource BtnGhost}" Height="34" HorizontalAlignment="Left">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE748;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Switch Account" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Button Grid.Column="1" Command="{Binding ForgetWorkstationCommand}" Style="{StaticResource BtnGhost}" Height="34" HorizontalAlignment="Right" Foreground="{DynamicResource TextMutedBrush}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Forget Workstation" FontSize="11" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>

                        <!-- ==================================================== -->
                        <!-- 1. SIGN IN FORM VIEW                                 -->
                        <!-- ==================================================== -->
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding ShowRegister}" Value="False"/>
                                                <Condition Binding="{Binding HasRememberedProfile}" Value="False"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </MultiDataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding ShowRegister}" Value="False"/>
                                                <Condition Binding="{Binding ShowManualLogin}" Value="True"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <!-- Return to Saved Profile link (visible when switching accounts from remembered profile) -->
                            <Button Command="{Binding BackToProfileCommand}" Style="{StaticResource BtnGhost}"
                                    Height="28" Padding="6,2" Margin="0,0,0,10" HorizontalAlignment="Left"
                                    Visibility="{Binding HasRememberedProfile, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Return to saved profile" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- Username Input -->
                            <StackPanel Margin="0,0,0,16">
                                <TextBlock Text="ADMINISTRATOR USERNAME" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextLabelBrush}" Margin="0,0,0,6"/>
                                <Border Style="{StaticResource CyberInputContainer}">
                                    <Grid Margin="12,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="24"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                                        <TextBox x:Name="UsernameBox" Grid.Column="1" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                                                 Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextPrimaryBrush}"
                                                 FontSize="13" FontWeight="SemiBold" VerticalContentAlignment="Center"
                                                 CaretBrush="{DynamicResource AccentBrush}"/>
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <!-- Password Input -->
                            <StackPanel Margin="0,0,0,14">
                                <TextBlock Text="SECURITY PASSWORD" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextLabelBrush}" Margin="0,0,0,6"/>
                                <Border Style="{StaticResource CyberInputContainer}">
                                    <Grid Margin="12,0,4,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="24"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="34"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="&#xE8D7;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                                        
                                        <!-- Masked Password -->
                                        <PasswordBox x:Name="PasswordBox" Grid.Column="1" Background="Transparent" BorderThickness="0"
                                                     Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" VerticalContentAlignment="Center"
                                                     PasswordChanged="PasswordBox_PasswordChanged"/>
                                        
                                        <!-- Plaintext Password -->
                                        <TextBox x:Name="PasswordRevealBox" Grid.Column="1" Background="Transparent" BorderThickness="0"
                                                 Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" FontWeight="SemiBold" VerticalContentAlignment="Center"
                                                 CaretBrush="{DynamicResource AccentBrush}"
                                                 TextChanged="PasswordRevealBox_TextChanged" Visibility="Collapsed"/>

                                        <!-- Eye Toggle Button -->
                                        <Button x:Name="RevealBtn" Grid.Column="2" Width="30" Height="30" Background="Transparent" BorderThickness="0"
                                                Cursor="Hand" Click="RevealBtn_Click" ToolTip="Toggle password visibility">
                                            <TextBlock x:Name="RevealIcon" Text="&#xE7B3;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"/>
                                        </Button>
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <!-- Remember Me Checkbox -->
                            <Grid Margin="0,2,0,18" Cursor="Hand" MouseDown="RememberMe_MouseDown">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="18" Height="18" CornerRadius="5" Background="{DynamicResource InputBgBrush}"
                                        BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1">
                                    <TextBlock x:Name="CheckMark" Text="&#xE73E;" FontFamily="Segoe MDL2 Assets"
                                               FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Visibility="{Binding RememberMe, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="Remember this workstation" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Sign In Primary Button -->
                            <Button Command="{Binding LoginCommand}"
                                    IsEnabled="{Binding IsLoading, Converter={StaticResource BooleanNotConverter}}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource CyberPrimaryBtn}">
                                        <Setter Property="IsDefault" Value="False"/>
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding ShowRegister}" Value="False"/>
                                                    <Condition Binding="{Binding HasRememberedProfile}" Value="False"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="IsDefault" Value="True"/>
                                            </MultiDataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding ShowRegister}" Value="False"/>
                                                    <Condition Binding="{Binding ShowManualLogin}" Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="IsDefault" Value="True"/>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Grid>
                                    <StackPanel x:Name="BtnText" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE785;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Launch Console" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <!-- Loading Spinner -->
                                    <StackPanel x:Name="BtnSpinner" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                                        <TextBlock Text="Authenticating..." FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <!-- Toggle to Register Link -->
                            <TextBlock HorizontalAlignment="Center" Margin="0,18,0,0">
                                <TextBlock Text="Need a new account? " FontSize="12" Foreground="{DynamicResource TextMutedBrush}"/>
                                <Hyperlink Command="{Binding ToggleRegisterCommand}" Foreground="{DynamicResource AccentBrush}" FontSize="12" FontWeight="SemiBold">
                                    Create Administrator Profile
                                </Hyperlink>
                            </TextBlock>
                        </StackPanel>

                        <!-- ==================================================== -->
                        <!-- 2. REGISTER FORM VIEW                                -->
                        <!-- ==================================================== -->
                        <StackPanel Visibility="{Binding ShowRegister, Converter={StaticResource BoolToVisibilityConverter}}">

                            <!-- Register Username -->
                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Text="DESIRED USERNAME" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextLabelBrush}" Margin="0,0,0,4"/>
                                <Border Style="{StaticResource CyberInputContainer}">
                                    <Grid Margin="12,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="24"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="1" Text="{Binding RegisterUsername, UpdateSourceTrigger=PropertyChanged}"
                                                 Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextPrimaryBrush}"
                                                 FontSize="12" FontWeight="SemiBold" VerticalContentAlignment="Center" CaretBrush="{DynamicResource AccentBrush}"/>
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <!-- Register Email -->
                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Text="EMAIL ADDRESS (OPTIONAL)" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextLabelBrush}" Margin="0,0,0,4"/>
                                <Border Style="{StaticResource CyberInputContainer}">
                                    <Grid Margin="12,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="24"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="&#xE715;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="1" Text="{Binding RegisterEmail, UpdateSourceTrigger=PropertyChanged}"
                                                 Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextPrimaryBrush}"
                                                 FontSize="12" FontWeight="SemiBold" VerticalContentAlignment="Center" CaretBrush="{DynamicResource AccentBrush}"/>
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <!-- Register Password -->
                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Text="NEW PASSWORD" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextLabelBrush}" Margin="0,0,0,4"/>
                                <Border Style="{StaticResource CyberInputContainer}">
                                    <Grid Margin="12,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="24"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="&#xE8D7;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                                        <PasswordBox x:Name="RegisterPasswordBox" Grid.Column="1" Background="Transparent" BorderThickness="0"
                                                     Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" VerticalContentAlignment="Center"
                                                     PasswordChanged="RegisterPasswordBox_PasswordChanged"/>
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <!-- Confirm Password -->
                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Text="CONFIRM PASSWORD" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextLabelBrush}" Margin="0,0,0,4"/>
                                <Border Style="{StaticResource CyberInputContainer}">
                                    <Grid Margin="12,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="24"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="&#xE928;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                                        <PasswordBox x:Name="RegisterConfirmPasswordBox" Grid.Column="1" Background="Transparent" BorderThickness="0"
                                                     Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" VerticalContentAlignment="Center"
                                                     PasswordChanged="RegisterConfirmPasswordBox_PasswordChanged"/>
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <!-- Register Message Banner -->
                            <Border BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,0,0,10"
                                    Visibility="{Binding RegisterMessage.Length, Converter={StaticResource IntToVisibilityConverter}}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource DangerBgBrush}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRegisterSuccess}" Value="True">
                                                <Setter Property="Background" Value="#2010B981"/>
                                                <Setter Property="BorderBrush" Value="#10B981"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#10B981" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsRegisterSuccess}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="&#xE783;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource DangerBrush}" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsRegisterSuccess}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Grid.Column="1" Text="{Binding RegisterMessage}" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsRegisterSuccess}" Value="True">
                                                        <Setter Property="Foreground" Value="#10B981"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Border>

                            <!-- Action Button Row -->
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="1.4*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Command="{Binding ToggleRegisterCommand}" Style="{StaticResource BtnGhost}" Height="42">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Back" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="2" Command="{Binding RegisterCommand}" Height="42">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource CyberPrimaryBtn}">
                                            <Setter Property="IsDefault" Value="False"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ShowRegister}" Value="True">
                                                    <Setter Property="IsDefault" Value="True"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Create Profile" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
