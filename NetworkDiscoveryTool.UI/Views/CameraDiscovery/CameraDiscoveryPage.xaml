<Page x:Class="NetworkDiscoveryTool.UI.Views.CameraDiscovery.CameraDiscoveryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:viewmodels="clr-namespace:NetworkDiscoveryTool.UI.ViewModels"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance Type=viewmodels:CameraDiscoveryViewModel}"
      Title="Camera Discovery"
      Background="{DynamicResource PageBgBrush}">

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="28,24">
            <StackPanel MaxWidth="1380" HorizontalAlignment="Stretch">

                <!-- ======================================================== -->
                <!-- HEADER BAR: Title, Subtitle, Discovery Control Actions   -->
                <!-- ======================================================== -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Border Width="38" Height="38" CornerRadius="10" Background="#150EA5E9" BorderBrush="#350EA5E9" BorderThickness="1" Margin="0,0,12,0" VerticalAlignment="Center">
                                <TextBlock Text="&#xE714;" FontFamily="Segoe MDL2 Assets" FontSize="19" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Camera Discovery &amp; LPR Radar" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="Zero-Config automated discovery for i-PRO, Dahua, ARH, Carmen LPR, Traffic Radars &amp; ONVIF cameras without IP range" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <!-- Main Action Buttons -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Discover All Cameras Button -->
                        <Button Command="{Binding DiscoverCamerasCommand}" Style="{StaticResource BtnPrimary}" Height="40" Padding="18,0" Margin="0,0,8,0"
                                IsEnabled="{Binding IsDiscovering, Converter={StaticResource BooleanNotConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xEC27;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Discover All Cameras" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Stop Button -->
                        <Button Command="{Binding StopDiscoveryCommand}" Style="{StaticResource BtnSecondary}" Height="40" Padding="14,0" Margin="0,0,8,0"
                                IsEnabled="{Binding IsDiscovering}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE71A;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="#EF4444"/>
                                <TextBlock Text="Stop" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Clear Results Button -->
                        <Button Command="{Binding ClearResultsCommand}" Style="{StaticResource BtnGhost}" Height="40" Width="40" Margin="0,0,8,0" ToolTip="Clear Results">
                            <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource TextMutedBrush}"/>
                        </Button>

                        <!-- Export CSV Button -->
                        <Button Command="{Binding ExportCsvCommand}" Style="{StaticResource BtnGhost}" Height="40" Width="40" Margin="0,0,8,0" ToolTip="Export to CSV">
                            <TextBlock Text="&#xE78C;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource TextMutedBrush}"/>
                        </Button>

                        <!-- Export JSON Button -->
                        <Button Command="{Binding ExportJsonCommand}" Style="{StaticResource BtnGhost}" Height="40" Width="40" ToolTip="Export to JSON">
                            <TextBlock Text="&#xEDE3;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource TextMutedBrush}"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- ======================================================== -->
                <!-- CONFIGURATION & INSTANT SEARCH TOOLBAR                  -->
                <!-- ======================================================== -->
                <Border Style="{StaticResource NetScopeCard}" Padding="18,14" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="280"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: Network Adapter Selector -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Network Interface / Adapter" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,6"/>
                            <ComboBox Style="{StaticResource ModernDarkComboBox}"
                                      ItemsSource="{Binding NetworkInterfaces}"
                                      SelectedItem="{Binding SelectedNetworkInterface}"
                                      Height="38"
                                      IsEnabled="{Binding IsDiscovering, Converter={StaticResource BooleanNotConverter}}"/>
                        </StackPanel>

                        <!-- Right: Universal Instant Search Box -->
                        <StackPanel Grid.Column="2">
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Instant Search Filter (by Brand, IP, MAC, Model, Serial)" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}"/>
                                <TextBlock Grid.Column="1" Text="Type 'ipro', 'dahua', 'radar', 'arh'..." FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                            </Grid>
                            <Border Height="38" CornerRadius="8" Background="{DynamicResource InputBgBrush}" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0"
                                             Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" VerticalContentAlignment="Center" CaretBrush="{DynamicResource AccentBrush}"/>
                                    <TextBlock Grid.Column="1" IsHitTestVisible="False" Text="Search discovered cameras (e.g. ipro, dahua, 192.168.1, ac:cc:8e, carmen)..."
                                               FontSize="12" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SearchText}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding SearchText}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <Button Grid.Column="2" Width="30" Height="30" Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="0,0,4,0"
                                            Command="{Binding ClearResultsCommand}" Visibility="{Binding SearchText, Converter={StaticResource BooleanNotToVisibilityConverter}}">
                                        <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                                    </Button>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ======================================================== -->
                <!-- PROGRESS & STATUS BAR                                    -->
                <!-- ======================================================== -->
                <Border Style="{StaticResource NetScopeCard}" Padding="16,12" Margin="0,0,0,16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="8" Height="8" Fill="{DynamicResource AccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Status:" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding StatusText}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Protocols: ONVIF | Dahua-DP | SSDP | SADP | ARP" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"/>
                            </StackPanel>
                        </Grid>

                        <ProgressBar Grid.Row="1" Height="3" Margin="0,10,0,0" IsIndeterminate="{Binding IsDiscovering}"
                                     Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource CardBgAltBrush}" BorderThickness="0"
                                     Visibility="{Binding IsDiscovering, Converter={StaticResource BooleanNotToVisibilityConverter}}"/>
                    </Grid>
                </Border>

                <!-- ======================================================== -->
                <!-- KPI STAT CARDS (Camera Breakdown)                        -->
                <!-- ======================================================== -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 1. Total Cameras -->
                    <Border Grid.Column="0" Style="{StaticResource NetScopeCard}" Padding="16,14" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="TOTAL CAMERAS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding TotalCount}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="Discovered Nodes" FontSize="10" Foreground="{DynamicResource AccentBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- 2. i-PRO Cameras -->
                    <Border Grid.Column="1" Style="{StaticResource NetScopeCard}" Padding="16,14" Margin="0,0,10,0" Cursor="Hand">
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding FilterByBrandCommand}" CommandParameter="i-PRO"/>
                        </Border.InputBindings>
                        <StackPanel>
                            <TextBlock Text="i-PRO / PANASONIC" FontSize="10" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding IProCount}" FontSize="24" FontWeight="Bold" Foreground="#38BDF8"/>
                            <TextBlock Text="AI &amp; Security Cams" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- 3. Dahua Cameras -->
                    <Border Grid.Column="2" Style="{StaticResource NetScopeCard}" Padding="16,14" Margin="0,0,10,0" Cursor="Hand">
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding FilterByBrandCommand}" CommandParameter="Dahua"/>
                        </Border.InputBindings>
                        <StackPanel>
                            <TextBlock Text="DAHUA / IMOU" FontSize="10" FontWeight="Bold" Foreground="#F97316" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding DahuaCount}" FontSize="24" FontWeight="Bold" Foreground="#F97316"/>
                            <TextBlock Text="ConfigTool &amp; ONVIF" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- 4. ARH / LPR -->
                    <Border Grid.Column="3" Style="{StaticResource NetScopeCard}" Padding="16,14" Margin="0,0,10,0" Cursor="Hand">
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding FilterByBrandCommand}" CommandParameter="ARH / LPR"/>
                        </Border.InputBindings>
                        <StackPanel>
                            <TextBlock Text="ARH / CARMEN LPR" FontSize="10" FontWeight="Bold" Foreground="#F59E0B" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding ArhLprCount}" FontSize="24" FontWeight="Bold" Foreground="#F59E0B"/>
                            <TextBlock Text="ANPR &amp; Traffic Units" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- 5. Hikvision -->
                    <Border Grid.Column="4" Style="{StaticResource NetScopeCard}" Padding="16,14" Margin="0,0,10,0" Cursor="Hand">
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding FilterByBrandCommand}" CommandParameter="Hikvision"/>
                        </Border.InputBindings>
                        <StackPanel>
                            <TextBlock Text="HIKVISION" FontSize="10" FontWeight="Bold" Foreground="#A855F7" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding HikvisionCount}" FontSize="24" FontWeight="Bold" Foreground="#A855F7"/>
                            <TextBlock Text="SADP &amp; ONVIF Cams" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- 6. Subnet Mismatch Alert Card -->
                    <Border Grid.Column="5" Style="{StaticResource NetScopeCard}" Padding="16,14">
                        <StackPanel>
                            <TextBlock Text="SUBNET MISMATCH" FontSize="10" FontWeight="Bold" Foreground="#EF4444" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding SubnetMismatchCount}" FontSize="24" FontWeight="Bold" Foreground="#EF4444"/>
                            <TextBlock Text="Different IP Subnets" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ======================================================== -->
                <!-- BRAND QUICK FILTER CHIPS                                -->
                <!-- ======================================================== -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                    <TextBlock Text="Filter by Brand:" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <ItemsControl ItemsSource="{Binding BrandFilters}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.FilterByBrandCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource BtnSecondary}" Height="30" Padding="12,0" Margin="0,0,6,0">
                                    <TextBlock Text="{Binding}" FontSize="11" FontWeight="SemiBold"/>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- ======================================================== -->
                <!-- RESULTS TABLE (DATAGRID)                                 -->
                <!-- ======================================================== -->
                <Border Style="{StaticResource NetScopeCard}" Padding="0" MinHeight="360">
                    <Grid>
                        <!-- DataGrid -->
                        <DataGrid ItemsSource="{Binding FilteredCameras}"
                                  SelectedItem="{Binding SelectedCamera}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="None"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  RowHeight="46"
                                  CanUserSortColumns="True"
                                  CanUserResizeColumns="True"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto">

                            <DataGrid.Columns>
                                <!-- 1. Brand & Logo Pill -->
                                <DataGridTemplateColumn Header="Brand" Width="130">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="6" Padding="8,4" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#150EA5E9"/>
                                                        <Setter Property="BorderBrush" Value="#350EA5E9"/>
                                                        <Setter Property="BorderThickness" Value="1"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Brand}" Value="i-PRO">
                                                                <Setter Property="Background" Value="#150284C7"/>
                                                                <Setter Property="BorderBrush" Value="#4038BDF8"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Brand}" Value="Dahua">
                                                                <Setter Property="Background" Value="#15F97316"/>
                                                                <Setter Property="BorderBrush" Value="#40F97316"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Brand}" Value="ARH / LPR">
                                                                <Setter Property="Background" Value="#15F59E0B"/>
                                                                <Setter Property="BorderBrush" Value="#40F59E0B"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Brand}" Value="Radar / Traffic">
                                                                <Setter Property="Background" Value="#15EF4444"/>
                                                                <Setter Property="BorderBrush" Value="#40EF4444"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Brand}" Value="Hikvision">
                                                                <Setter Property="Background" Value="#15A855F7"/>
                                                                <Setter Property="BorderBrush" Value="#40A855F7"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE714;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                    <TextBlock Text="{Binding Brand}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- 2. Camera Model -->
                                <DataGridTemplateColumn Header="Model &amp; Hardware" Width="200">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel VerticalAlignment="Center" Margin="4,0">
                                                <TextBlock Text="{Binding Model}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding ExtraInfo}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis" Visibility="{Binding ExtraInfo, Converter={StaticResource BooleanNotToVisibilityConverter}}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- 3. IP Address & Subnet Warning -->
                                <DataGridTemplateColumn Header="IP Address" Width="170">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel VerticalAlignment="Center" Margin="4,0">
                                                <TextBlock Text="{Binding IPAddress}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                                <Border Visibility="{Binding IsSubnetMismatch, Converter={StaticResource BooleanNotToVisibilityConverter}}"
                                                        Background="#20EF4444" CornerRadius="4" Padding="4,1" Margin="0,2,0,0" HorizontalAlignment="Left">
                                                    <TextBlock Text="⚠️ Subnet Mismatch" FontSize="9" FontWeight="SemiBold" Foreground="#EF4444"/>
                                                </Border>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- 4. MAC Address -->
                                <DataGridTemplateColumn Header="MAC Address" Width="160">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding MACAddress, FallbackValue='Resolving...'}" FontSize="11" FontFamily="Consolas" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="4,0"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- 5. Protocol -->
                                <DataGridTemplateColumn Header="Discovery Protocol" Width="140">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource CardBgAltBrush}" CornerRadius="6" Padding="6,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Protocol}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- 6. Status -->
                                <DataGridTemplateColumn Header="Status" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Ellipse Width="7" Height="7" Fill="#10B981" Margin="0,0,6,0"/>
                                                <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="SemiBold" Foreground="#10B981"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- 7. Quick Actions -->
                                <DataGridTemplateColumn Header="Actions" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <!-- Open Web UI -->
                                                <Button Command="{Binding DataContext.OpenWebUiCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource BtnSecondary}" Height="28" Padding="8,0" Margin="0,0,6,0" ToolTip="Open Camera Web Interface">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="Web" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>

                                                <!-- Copy RTSP -->
                                                <Button Command="{Binding DataContext.CopyRtspCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource BtnSecondary}" Height="28" Padding="8,0" Margin="0,0,6,0" ToolTip="Copy RTSP Stream URL">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xE714;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="RTSP" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>

                                                <!-- Copy IP -->
                                                <Button Command="{Binding DataContext.CopyIpCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource BtnGhost}" Height="28" Width="28" Margin="0,0,4,0" ToolTip="Copy IP Address">
                                                    <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                                                </Button>

                                                <!-- Copy MAC -->
                                                <Button Command="{Binding DataContext.CopyMacCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource BtnGhost}" Height="28" Width="28" ToolTip="Copy MAC Address">
                                                    <TextBlock Text="&#xE772;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                                                </Button>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Empty State Overlay -->
                        <Border Background="{DynamicResource PageBgBrush}" Visibility="{Binding HasNoResults, Converter={StaticResource BooleanNotToVisibilityConverter}}"
                                Padding="40" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <StackPanel HorizontalAlignment="Center">
                                <Border Width="64" Height="64" CornerRadius="16" Background="#100EA5E9" BorderBrush="#250EA5E9" BorderThickness="1" HorizontalAlignment="Center" Margin="0,0,0,16">
                                    <TextBlock Text="&#xE714;" FontFamily="Segoe MDL2 Assets" FontSize="28" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="No Cameras Discovered Yet" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                <TextBlock Text="Click 'Discover All Cameras' above to broadcast ONVIF, Dahua, i-PRO &amp; SADP discovery packets across the network." FontSize="12" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="500"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
