<Page x:Class="NetworkDiscoveryTool.UI.Views.Screenshot.ScreenshotPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:models="clr-namespace:NetworkDiscoveryTool.UI.Models"
      Title="Screenshot"
      Background="{DynamicResource PageBgBrush}"
      Loaded="Page_Loaded">

    <Page.Resources>
        <Style x:Key="ScCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="20"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource CardBgAltBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CaptureBtn" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="50"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="md:ButtonAssist.CornerRadius" Value="12"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.92"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Opacity" Value="0.8"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.4"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ActionPill" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="md:ButtonAssist.CornerRadius" Value="8"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.9"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Opacity" Value="0.8"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.4"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="MetaChip" TargetType="Border">
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Background" Value="{DynamicResource InputBgBrush}"/>
            <Setter Property="Margin" Value="0,0,0,0"/>
        </Style>
    </Page.Resources>

    <Grid>
        <ProgressBar Style="{StaticResource LoadingSpinner}"
                     Visibility="{Binding IsCapturing, Converter={StaticResource BoolToVisibilityConverter}}"
                     VerticalAlignment="Top" Panel.ZIndex="10"/>

        <ScrollViewer Style="{StaticResource Scroller}" Margin="0,0,-17,0">
            <Grid Margin="28">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ============================================ -->
                <!-- HEADER                                        -->
                <!-- ============================================ -->
                <Border Style="{StaticResource ScCard}" Padding="24,18" Margin="0,0,0,22">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="46" Height="46" CornerRadius="12"
                                Background="{DynamicResource TextPrimaryBrush}" Opacity="0.12">
                            <TextBlock Text="&#x1F4F7;" FontFamily="Segoe UI Emoji" FontSize="24"
                                       Foreground="{DynamicResource AccentBrush}"
                                       HorizontalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Screenshot Tool" Style="{StaticResource HeadingXL}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock Text="{Binding StatusText}" Style="{StaticResource BodySm}"/>
                                <Ellipse Width="4" Height="4" Fill="{DynamicResource ChartColor3}"
                                         Margin="10,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding ImageSize, TargetNullValue=''}" Style="{StaticResource Caption}"/>
                            </StackPanel>
                        </StackPanel>
                        <Button Grid.Column="2" Command="{Binding OpenSaveFolderCommand}"
                                Content="&#x1F4C2;  Open Folder" Style="{StaticResource BtnSecondary}"
                                ToolTip="Open screenshots folder" FontFamily="Segoe UI Emoji"/>
                    </Grid>
                </Border>

                <!-- ============================================ -->
                <!-- MAIN: CAPTURE + PREVIEW                       -->
                <!-- ============================================ -->
                <Grid Grid.Row="1" Margin="0,0,0,22">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="360"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- ======== LEFT: CAPTURE CONTROLS ======== -->
                    <Border Style="{StaticResource ScCard}" Padding="22" Margin="0,0,14,0">
                        <StackPanel>
                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="30" Height="30" CornerRadius="8"
                                        Background="{DynamicResource SidebarTextBrush}" Opacity="0.12">
                                    <TextBlock Text="&#x2699;" FontFamily="Segoe UI Emoji" FontSize="15"
                                               Foreground="{DynamicResource CardBgBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Capture" Style="{StaticResource HeadingSm}"/>
                                    <TextBlock Text="Take new screenshots" Style="{StaticResource Caption}"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Capture Mode" Style="{StaticResource FieldLabel}"/>
                            <ComboBox SelectedIndex="{Binding SelectedCaptureMode}" Height="36" FontSize="12"
                                      Margin="0,0,0,18"
                                      Background="{DynamicResource InputBgBrush}"
                                      BorderBrush="{DynamicResource InputBorderBrush}"
                                      Foreground="{DynamicResource TextPrimaryBrush}"
                                      md:TextFieldAssist.HasOutlinedTextField="True">
                                <ComboBoxItem Content="&#x1F5A5;  Full Screen" FontFamily="Segoe UI Emoji"/>
                                <ComboBoxItem Content="&#x1FA9F;  Active Window" FontFamily="Segoe UI Emoji"/>
                            </ComboBox>

                            <Button Command="{Binding CaptureCommand}"
                                    IsEnabled="{Binding IsCapturing, Converter={StaticResource BooleanNotConverter}}"
                                    Background="{DynamicResource AccentBrush}"
                                    Margin="0,0,0,20" Click="Button_Click">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource CaptureBtn}">
                                        <Setter Property="Content">
                                            <Setter.Value>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <Border Width="28" Height="28" CornerRadius="6"
                                                            Background="White" Opacity="0.18" Margin="0,0,10,0">
                                                        <TextBlock Text="&#x1F4F7;" FontFamily="Segoe UI Emoji" FontSize="14"
                                                                   HorizontalAlignment="Center" Foreground="Black" Height="28" VerticalAlignment="Top" Margin="0,2,0,0"/>
                                                    </Border>
                                                    <TextBlock Text="Capture Screenshot" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCapturing}" Value="True">
                                                <Setter Property="IsEnabled" Value="False"/>
                                                <Setter Property="Content">
                                                    <Setter.Value>
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                            <ProgressBar Style="{StaticResource LoadingSpinner}"
                                                                         Width="18" Height="18"
                                                                         Margin="0,0,12,0" VerticalAlignment="Center"/>
                                                            <TextBlock Text="Capturing..." VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <Separator Style="{StaticResource Separator}" Margin="0,0,0,20"/>

                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="26" Height="26" CornerRadius="6"
                                        Background="{DynamicResource ChartColor2}" Opacity="0.12">
                                    <TextBlock Text="&#x1F4BE;" FontFamily="Segoe UI Emoji" FontSize="13"
                                               Foreground="{DynamicResource CardBgAltBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Save Options" Style="{StaticResource Label}"/>
                                    <TextBlock Text="Notes, folder &amp; export" Style="{StaticResource Caption}"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Notes" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" Height="60"
                                     Style="{StaticResource TxtBox}"
                                     TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,16"/>

                            <TextBlock Text="Save Folder" Style="{StaticResource FieldLabel}"/>
                            <Grid Margin="0,0,0,18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding SaveFolder}" Style="{StaticResource TxtBox}" Height="34"
                                         IsReadOnly="True" FontSize="11" Padding="10,0"/>
                                <Button Grid.Column="1" Command="{Binding BrowseSaveFolderCommand}"
                                        Content="&#x1F4C2;" FontFamily="Segoe UI Emoji"
                                        Width="34" Height="34" Margin="8,0,0,0"
                                        Style="{StaticResource BtnSm}" Padding="0" FontSize="14"/>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Command="{Binding SaveCommand}"
                                        Content="&#x1F4BE;  Save" FontFamily="Segoe UI Emoji"
                                        Style="{StaticResource ActionPill}" Background="{DynamicResource SuccessBrush}"
                                        IsEnabled="{Binding HasPreview}"
                                        ToolTip="Save screenshot to disk"/>
                                <Button Grid.Column="2" Command="{Binding CopyToClipboardCommand}"
                                        Content="&#x1F4CB;  Copy" FontFamily="Segoe UI Emoji"
                                        Style="{StaticResource ActionPill}" Background="{DynamicResource AccentBrush}"
                                        IsEnabled="{Binding HasPreview}"
                                        ToolTip="Copy image to clipboard"/>
                                <Button Grid.Column="4" Command="{Binding ClearPreviewCommand}"
                                        Content="&#x1F5D1;  Clear" FontFamily="Segoe UI Emoji"
                                        Style="{StaticResource ActionPill}"
                                        Background="{DynamicResource InputBgBrush}"
                                        Foreground="{DynamicResource TextSecondaryBrush}"
                                        BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                        IsEnabled="{Binding HasPreview}"
                                        ToolTip="Clear current preview"/>
                            </Grid>

                            <Border Background="{DynamicResource DangerBgBrush}"
                                    Padding="12" CornerRadius="8" Margin="0,12,0,0"
                                    BorderBrush="{DynamicResource DangerBrush}" BorderThickness="1"
                                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#x26A0;" FontSize="14" Foreground="{DynamicResource DangerBrush}"
                                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Grid.Column="1" Text="{Binding ErrorMessage}" Style="{StaticResource BodySm}"
                                               Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- ======== RIGHT: PREVIEW ======== -->
                    <Border Grid.Column="1" Style="{StaticResource ScCard}" Padding="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Border Padding="22,16"
                                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="30" Height="30" CornerRadius="8"
                                            Background="{DynamicResource ChartColor5}" Opacity="0.12">
                                        <TextBlock Text="&#x1F4F0;" FontFamily="Segoe UI Emoji" FontSize="15"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="Preview" Style="{StaticResource HeadingSm}"/>
                                        <TextBlock Text="Screenshot preview" Style="{StaticResource Caption}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                Visibility="{Binding HasPreview, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <Border Style="{StaticResource MetaChip}" Background="{DynamicResource AccentBrush}">
                                            <TextBlock Style="{StaticResource Caption}" FontWeight="SemiBold">
                                                <Run Text="{Binding ImageDimensions}"/>
                                            </TextBlock>
                                        </Border>
                                        <Border Style="{StaticResource MetaChip}" Margin="8,0,0,0" Background="{DynamicResource TextMutedBrush}">
                                            <TextBlock Style="{StaticResource Caption}" FontWeight="SemiBold">
                                                <Run Text="{Binding ImageSize}"/>
                                            </TextBlock>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Grid.Row="1" Margin="22" CornerRadius="12"
                                    Background="{DynamicResource InputBgBrush}"
                                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                                <Grid>
                                    <Image Source="{Binding PreviewImage}" Stretch="Uniform"
                                           MaxWidth="820" MaxHeight="480"
                                           Visibility="{Binding HasPreview, Converter={StaticResource BoolToVisibilityConverter}}"
                                           Margin="14"/>

                                    <Border CornerRadius="12" Background="{DynamicResource InputBgBrush}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasPreview}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Border Width="72" Height="72" CornerRadius="36"
                                                    Background="{DynamicResource SidebarTextBrush}" Opacity="0.06"
                                                    HorizontalAlignment="Center" Margin="0,0,0,14">
                                                <TextBlock Text="&#x1F4F7;" FontFamily="Segoe UI Emoji" FontSize="32"
                                                           Foreground="{DynamicResource CardBgBrush}"
                                                           HorizontalAlignment="Center" Margin="0,8,0,17"/>
                                            </Border>
                                            <TextBlock Text="No screenshot captured" Style="{StaticResource Body}"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       HorizontalAlignment="Center"/>
                                            <TextBlock Text="Adjust settings and click Capture"
                                                       Style="{StaticResource Caption}"
                                                       HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>

                            <Border Grid.Row="2" Padding="18,12"
                                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,1,0,0"
                                    Visibility="{Binding HasPreview, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Command="{Binding SaveCommand}"
                                            Content="&#x1F4BE;  Save to Disk" FontFamily="Segoe UI Emoji"
                                            Style="{StaticResource ActionPill}" Background="{DynamicResource SuccessBrush}"
                                            IsEnabled="{Binding HasPreview}"/>
                                    <Button Command="{Binding CopyToClipboardCommand}"
                                            Content="&#x1F4CB;  Copy to Clipboard" FontFamily="Segoe UI Emoji"
                                            Style="{StaticResource ActionPill}" Background="{DynamicResource AccentBrush}"
                                            Margin="10,0,0,0"
                                            IsEnabled="{Binding HasPreview}"/>
                                    <Button Command="{Binding ClearPreviewCommand}"
                                            Content="&#x1F5D1;  Discard" FontFamily="Segoe UI Emoji"
                                            Style="{StaticResource ActionPill}" Background="{DynamicResource InputBgBrush}"
                                            Foreground="{DynamicResource TextSecondaryBrush}"
                                            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                            Margin="10,0,0,0"
                                            IsEnabled="{Binding HasPreview}"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ============================================ -->
                <!-- GALLERY                                       -->
                <!-- ============================================ -->
                <Border Grid.Row="2" Style="{StaticResource ScCard}" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Padding="22,16"
                                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="30" Height="30" CornerRadius="8"
                                        Background="{DynamicResource AccentBrush}" Opacity="0.12">
                                    <TextBlock Text="&#x1F4C1;" FontFamily="Segoe UI Emoji" FontSize="18"
                                               Foreground="{DynamicResource ChartColor3}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Screenshot Gallery" Style="{StaticResource HeadingSm}"/>
                                        <Border CornerRadius="10" Padding="8,2" Margin="10,0,0,0"
                                                Background="{DynamicResource ChartColor1}" Opacity="0.12">
                                            <TextBlock Text="{Binding History.Count, Mode=OneWay, StringFormat={}{0} items}"
                                                       Style="{StaticResource Caption}" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource AccentBrush}"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="Browse and manage captured screenshots" Style="{StaticResource Caption}"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Row="1" Padding="16,10"
                                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1"
                                Background="{DynamicResource InputBgBrush}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Command="{Binding OpenHistoryEntryCommand}"
                                        Content="&#x1F4C2;  Open Folder"
                                        Background="{DynamicResource AccentBrush}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource BtnSm}">
                                            <Setter Property="IsEnabled" Value="True"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedHistoryEntry}" Value="{x:Null}">
                                                    <Setter Property="IsEnabled" Value="False"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Command="{Binding DeleteHistoryEntryCommand}"
                                        Content="&#x1F5D1;  Delete"
                                        Background="{DynamicResource DangerBrush}" Margin="8,0,0,0">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource BtnSm}">
                                            <Setter Property="IsEnabled" Value="True"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedHistoryEntry}" Value="{x:Null}">
                                                    <Setter Property="IsEnabled" Value="False"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Command="{Binding ClearHistoryCommand}"
                                        Content="Clear All" Style="{StaticResource BtnSm}"
                                        Background="{DynamicResource InputBgBrush}" Margin="8,0,0,0"
                                        Foreground="{DynamicResource TextSecondaryBrush}"
                                        BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"/>
                            </StackPanel>
                        </Border>

                        <!-- Thumbnail Strip -->
                        <Border Grid.Row="2" Padding="20,14" MinHeight="130"
                                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1"
                                Visibility="{Binding History.Count, Converter={StaticResource IntToVisibilityConverter}}">
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                          Style="{StaticResource Scroller}">
                                <ItemsControl ItemsSource="{Binding History}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="models:ScreenshotEntry">
                                            <Button Command="{Binding DataContext.OpenHistoryEntryCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                    Width="160" Height="100" Margin="0,0,10,10">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="Bd"
                                                                Background="{DynamicResource InputBgBrush}"
                                                                BorderBrush="{DynamicResource CardBorderBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="8"
                                                                Cursor="Hand"
                                                                SnapsToDevicePixels="True">
                                                            <ContentPresenter Margin="12,10"
                                                                              HorizontalAlignment="Stretch"
                                                                              VerticalAlignment="Stretch"
                                                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardBgAltBrush}"/>
                                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="*"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>
                                                    <TextBlock Text="{Binding Icon}" FontFamily="Segoe UI Emoji" FontSize="20"
                                                               HorizontalAlignment="Left"/>
                                                    <TextBlock Grid.Row="1" Text="{Binding FileName}" Style="{StaticResource BodySm}"
                                                               FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,6,0,0"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,4,0,0">
                                                        <TextBlock Text="{Binding SizeDisplay}" Style="{StaticResource Caption}" FontSize="9"/>
                                                        <Ellipse Width="3" Height="3" Fill="{DynamicResource TextMutedBrush}"
                                                                 Margin="6,0,6,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding CapturedDisplay}" Style="{StaticResource Caption}" FontSize="9"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>

                        <DataGrid Grid.Row="3" ItemsSource="{Binding History}"
                                  SelectedItem="{Binding SelectedHistoryEntry}"
                                  Style="{StaticResource DGrid}" RowHeight="38"
                                  Margin="0" SelectionChanged="DataGrid_SelectionChanged">
                            <DataGrid.Resources>
                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource DGridColHeader}"/>
                                <Style TargetType="DataGridCell" BasedOn="{StaticResource DGridCell}"/>
                                <Style TargetType="DataGridRow" BasedOn="{StaticResource DGridRow}"/>
                            </DataGrid.Resources>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Mode" SortMemberPath="CaptureMode" Width="60">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Icon}" FontFamily="Segoe UI Emoji" FontSize="16"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="File Name" Binding="{Binding FileName}"
                                                    SortMemberPath="FileName" Width="*"/>
                                <DataGridTextColumn Header="Size" Binding="{Binding SizeDisplay}"
                                                    SortMemberPath="SizeBytes" Width="90"/>
                                <DataGridTextColumn Header="Captured" Binding="{Binding CapturedDisplay}"
                                                    SortMemberPath="CapturedAt" Width="160"/>
                                <DataGridTextColumn Header="Notes" Binding="{Binding Notes}"
                                                    SortMemberPath="Notes" Width="200"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

            </Grid>
        </ScrollViewer>
    </Grid>
</Page>