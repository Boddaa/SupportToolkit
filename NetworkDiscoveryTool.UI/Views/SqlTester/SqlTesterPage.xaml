<Page x:Class="NetworkDiscoveryTool.UI.Views.SqlTester.SqlTesterPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
      Title="SQL Server Tester"
      Background="{DynamicResource PageBgBrush}"
      Loaded="Page_Loaded">

    <Page.Resources>
        <!-- Primary Action Button -->
        <Style x:Key="SqlPrimaryBtn" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Background" Value="#0284C7"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#38BDF8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="md:ButtonAssist.CornerRadius" Value="8"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#0369A1"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Opacity" Value="0.75"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.4"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Ghost Action Button -->
        <Style x:Key="SqlGhostBtn" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="md:ButtonAssist.CornerRadius" Value="8"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource HoverBgBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Input Container Box -->
        <Style x:Key="SqlInputContainer" TargetType="Border">
            <Setter Property="Height" Value="38"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Background" Value="{DynamicResource InputBgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Tab Header Toggle Button -->
        <Style x:Key="SqlTabBtn" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="TabBorder" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}" Margin="0,0,6,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource HoverBgBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource AccentMutedBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <!-- Left Column: Parameters (420px) -->
            <ColumnDefinition Width="420"/>
            <!-- Right Column: Diagnostics / Profiles / History (*) -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ============================================================ -->
        <!-- LEFT COLUMN: TARGET INSTANCE PARAMETERS                      -->
        <!-- ============================================================ -->
        <ScrollViewer Grid.Column="0" Style="{StaticResource Scroller}" Margin="0,0,16,0">
            <StackPanel>
                <!-- Title Header -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="42" Height="42" CornerRadius="10" Background="{DynamicResource AccentMutedBrush}"
                            BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" Margin="0,0,12,0" VerticalAlignment="Center">
                        <TextBlock Text="&#xEA47;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{DynamicResource AccentBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="SQL Server Tester" Style="{StaticResource HeadingXL}"/>
                        <TextBlock Text="Connection diagnostics, latency auditing &amp; instance health" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- Configuration Card -->
                <Border Style="{StaticResource NetScopeCard}" Padding="18" Margin="0,0,0,16">
                    <StackPanel>
                        <!-- Header -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Target Instance Parameters" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Server Host / Instance -->
                        <TextBlock Text="SERVER / INSTANCE" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextLabelBrush}" Margin="0,0,0,4"/>
                        <Border Style="{StaticResource SqlInputContainer}">
                            <Grid Margin="10,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Text="{Binding ServerHost, UpdateSourceTrigger=PropertyChanged}"
                                         Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextPrimaryBrush}"
                                         FontSize="12" FontWeight="SemiBold" VerticalContentAlignment="Center" CaretBrush="{DynamicResource AccentBrush}"/>
                            </Grid>
                        </Border>

                        <!-- Port and Database Grid -->
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Port -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="PORT" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextLabelBrush}" Margin="0,0,0,4"/>
                                <Border Style="{StaticResource SqlInputContainer}">
                                    <TextBox Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}"
                                             Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextPrimaryBrush}"
                                             FontSize="12" FontWeight="SemiBold" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                             CaretBrush="{DynamicResource AccentBrush}"/>
                                </Border>
                            </StackPanel>

                            <!-- Database -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="DATABASE (OPTIONAL)" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextLabelBrush}" Margin="0,0,0,4"/>
                                <Border Style="{StaticResource SqlInputContainer}">
                                    <Grid Margin="10,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="22"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="&#xEA47;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="1" Text="{Binding Database, UpdateSourceTrigger=PropertyChanged}"
                                                 Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextPrimaryBrush}"
                                                 FontSize="12" FontWeight="SemiBold" VerticalContentAlignment="Center" CaretBrush="{DynamicResource AccentBrush}"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- Authentication Mode Radio Options -->
                        <TextBlock Text="AUTHENTICATION MODE" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextLabelBrush}" Margin="0,4,0,6"/>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" CornerRadius="8" Background="{DynamicResource InputBgBrush}" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1" Padding="10,8">
                                <RadioButton Content="Windows Auth" IsChecked="{Binding UseWindowsAuth}" GroupName="SqlAuthGroup"
                                             Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" FontWeight="SemiBold" Cursor="Hand"/>
                            </Border>

                            <Border Grid.Column="2" CornerRadius="8" Background="{DynamicResource InputBgBrush}" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1" Padding="10,8">
                                <RadioButton Content="SQL Server Auth" IsChecked="{Binding UseWindowsAuth, Converter={StaticResource BooleanNotConverter}}" GroupName="SqlAuthGroup"
                                             Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" FontWeight="SemiBold" Cursor="Hand"/>
                            </Border>
                        </Grid>

                        <!-- SQL Auth Fields (Username & Password) -->
                        <StackPanel Visibility="{Binding UseWindowsAuth, Converter={StaticResource BooleanNotToVisibilityConverter}}">
                            <TextBlock Text="DB USERNAME" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextLabelBrush}" Margin="0,0,0,4"/>
                            <Border Style="{StaticResource SqlInputContainer}">
                                <Grid Margin="10,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="22"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                                             Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextPrimaryBrush}"
                                             FontSize="12" FontWeight="SemiBold" VerticalContentAlignment="Center" CaretBrush="{DynamicResource AccentBrush}"/>
                                </Grid>
                            </Border>

                            <TextBlock Text="DB PASSWORD" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextLabelBrush}" Margin="0,0,0,4"/>
                            <Border Style="{StaticResource SqlInputContainer}">
                                <Grid Margin="10,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="22"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE8D7;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                                    <PasswordBox x:Name="PasswordBox" Grid.Column="1" PasswordChanged="PasswordBox_PasswordChanged"
                                                 Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextPrimaryBrush}"
                                                 FontSize="12" VerticalContentAlignment="Center"/>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- Advanced Connection Options Toggle -->
                        <Border Margin="0,6,0,12" Background="{DynamicResource CardBgAltBrush}" CornerRadius="8" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                            <StackPanel>
                                <Button Command="{Binding ToggleAdvancedCommand}" Style="{StaticResource BtnGhost}" HorizontalContentAlignment="Stretch" Padding="12,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Advanced Connection Options" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding IsAdvancedExpanded, Converter={StaticResource BooleanNotConverter}, StringFormat={}{0}}" Visibility="Collapsed"/>
                                        <TextBlock Grid.Column="1" Text="▼" FontSize="9" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"
                                                   RenderTransformOrigin="0.5,0.5">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsAdvancedExpanded}" Value="True">
                                                            <Setter Property="RenderTransform">
                                                                <Setter.Value>
                                                                    <RotateTransform Angle="180"/>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Button>

                                <StackPanel Visibility="{Binding IsAdvancedExpanded, Converter={StaticResource BoolToVisibilityConverter}}" Margin="12,4,12,12">
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Connect Timeout (s)" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,3"/>
                                            <Border Style="{StaticResource SqlInputContainer}" Height="32">
                                                <TextBox Text="{Binding ConnectTimeout, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0"
                                                         Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
                                            </Border>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Command Timeout (s)" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,3"/>
                                            <Border Style="{StaticResource SqlInputContainer}" Height="32">
                                                <TextBox Text="{Binding CommandTimeout, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0"
                                                         Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
                                            </Border>
                                        </StackPanel>
                                    </Grid>

                                    <CheckBox Content="Encrypt Connection" IsChecked="{Binding EncryptConnection}" Margin="0,0,0,6"
                                              Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" FontWeight="SemiBold"/>
                                    <CheckBox Content="Trust Server Certificate" IsChecked="{Binding TrustServerCertificate}" Margin="0,0,0,6"
                                              Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" FontWeight="SemiBold"/>

                                    <TextBlock Text="Application Name" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,3"/>
                                    <Border Style="{StaticResource SqlInputContainer}" Height="32" Margin="0">
                                        <TextBox Text="{Binding ApplicationName, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0"
                                                 Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11" VerticalContentAlignment="Center" Padding="8,0"/>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Validation Message Banner -->
                        <Border Margin="0,0,0,10" Background="{DynamicResource DangerBgBrush}" BorderBrush="{DynamicResource DangerBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="10,8" Visibility="{Binding HasValidationMessage, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE783;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource DangerBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding ValidationMessage}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource DangerBrush}"
                                           TextWrapping="Wrap" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Action Buttons -->
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" Command="{Binding ClearFormCommand}" Style="{StaticResource SqlGhostBtn}" ToolTip="Clear input parameters">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE894;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Clear" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Grid.Column="2" Command="{Binding OpenSaveProfileDialogCommand}" Style="{StaticResource SqlGhostBtn}" ToolTip="Save connection profile">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Save Profile" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Grid.Column="4" Command="{Binding TestConnectionCommand}" Style="{StaticResource SqlPrimaryBtn}"
                                    IsEnabled="{Binding IsTesting, Converter={StaticResource BooleanNotConverter}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Test Connection" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ============================================================ -->
        <!-- RIGHT COLUMN: DIAGNOSTICS, PROFILES, HISTORY                 -->
        <!-- ============================================================ -->
        <Border Grid.Column="1" Style="{StaticResource NetScopeCard}" Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <!-- Row 0: Top Tab Headers -->
                    <RowDefinition Height="Auto"/>
                    <!-- Row 1: Tab Content View -->
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Top Navigation Tabs -->
                <Border Grid.Row="0" Margin="0,0,0,16" Padding="0,0,0,12" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal">
                            <RadioButton Content="⚡ Connection Diagnostics" Style="{StaticResource SqlTabBtn}"
                                         IsChecked="{Binding IsDiagnosticsTabSelected}" Command="{Binding SelectTabCommand}" CommandParameter="0"/>
                            <RadioButton Content="⭐ Saved Profiles" Style="{StaticResource SqlTabBtn}"
                                         IsChecked="{Binding IsProfilesTabSelected}" Command="{Binding SelectTabCommand}" CommandParameter="1"/>
                            <RadioButton Content="🕒 History" Style="{StaticResource SqlTabBtn}"
                                         IsChecked="{Binding IsHistoryTabSelected}" Command="{Binding SelectTabCommand}" CommandParameter="2"/>
                        </StackPanel>

                        <!-- Refresh / Clear Tab Actions -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Command="{Binding ClearAllHistoryCommand}" Style="{StaticResource BtnGhost}" Height="30" Padding="8,0"
                                    Visibility="{Binding IsHistoryTabSelected, Converter={StaticResource BoolToVisibilityConverter}}"
                                    ToolTip="Clear history records">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Clear History" FontSize="11" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ======================================================== -->
                <!-- TAB 0: CONNECTION DIAGNOSTICS VIEW                       -->
                <!-- ======================================================== -->
                <ScrollViewer Grid.Row="1" Style="{StaticResource Scroller}"
                              Visibility="{Binding IsDiagnosticsTabSelected, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel>

                        <!-- STATE 1: Initial Empty State -->
                        <Border Padding="40,60" CornerRadius="12" Background="{DynamicResource CardBgAltBrush}"
                                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Margin="0,0,0,16"
                                Visibility="{Binding IsInitialState, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel HorizontalAlignment="Center">
                                <Border Width="64" Height="64" CornerRadius="32" Background="{DynamicResource AccentMutedBrush}"
                                        BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" Margin="0,0,0,16" HorizontalAlignment="Center">
                                    <TextBlock Text="&#xEA47;" FontFamily="Segoe MDL2 Assets" FontSize="26" Foreground="{DynamicResource AccentBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Ready to test connection" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="Configure server parameters and click 'Test Connection' to initiate multi-stage connectivity diagnostics, latency profiling, and instance health assessment."
                                           FontSize="12" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="460" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- STATE 2: In-Progress Testing Indicator -->
                        <Border Padding="24" CornerRadius="12" Background="{DynamicResource CardBgAltBrush}"
                                BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" Margin="0,0,0,16"
                                Visibility="{Binding IsTesting, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ProgressBar Style="{StaticResource LoadingSpinner}" Width="28" Height="28" Margin="0,0,16,0" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Executing Multi-Stage Connection Diagnostics..." FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Performing DNS resolution, TCP port probing, TLS handshake, and authentication..."
                                               FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="2" Command="{Binding CancelTestCommand}" Style="{StaticResource SqlGhostBtn}" Height="32" Padding="12,0" VerticalAlignment="Center">
                                    <TextBlock Text="Cancel" FontSize="11" FontWeight="Bold"/>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Results Container (Visible when DiagnosticResult is present and not Initial) -->
                        <StackPanel Visibility="{Binding IsInitialState, Converter={StaticResource BooleanNotToVisibilityConverter}}">

                            <!-- SUCCESS BANNER -->
                            <Border Margin="0,0,0,14" CornerRadius="10" Padding="16,12" Background="#064E3B" BorderBrush="#10B981" BorderThickness="1"
                                    Visibility="{Binding DiagnosticResult.Success, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="32" Height="32" CornerRadius="16" Background="#10B981" Margin="0,0,12,0" VerticalAlignment="Center">
                                        <TextBlock Text="✓" FontSize="16" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Connection Successful" FontSize="14" FontWeight="Bold" Foreground="#34D399"/>
                                        <TextBlock Text="Successfully established session and authenticated with SQL Server instance." FontSize="11" Foreground="#A7F3D0" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Border Grid.Column="2" Background="#047857" CornerRadius="6" Padding="10,4" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DiagnosticResult.SummaryResponseTime}" FontSize="12" FontWeight="Bold" Foreground="#ECFDF5"/>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- FAILURE BANNER -->
                            <Border Margin="0,0,0,14" CornerRadius="10" Padding="16,12" Background="#4C0519" BorderBrush="#EF4444" BorderThickness="1"
                                    Visibility="{Binding DiagnosticResult.Success, Converter={StaticResource BooleanNotToVisibilityConverter}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="32" Height="32" CornerRadius="16" Background="#EF4444" Margin="0,0,12,0" VerticalAlignment="Center">
                                        <TextBlock Text="✕" FontSize="14" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DiagnosticResult.OverallStatus, StringFormat={}Connection Failed ({0})}" FontSize="14" FontWeight="Bold" Foreground="#F87171"/>
                                        <TextBlock Text="{Binding DiagnosticResult.FailureSummary}" FontSize="11" Foreground="#FECDD3" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Border Grid.Column="2" Background="#9F1239" CornerRadius="6" Padding="10,4" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DiagnosticResult.SummaryResponseTime}" FontSize="12" FontWeight="Bold" Foreground="#FFF1F2"/>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- SUMMARY STAT CARDS -->
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Background="{DynamicResource InputBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10">
                                    <StackPanel>
                                        <TextBlock Text="SERVER" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextLabelBrush}"/>
                                        <TextBlock Text="{Binding DiagnosticResult.SummaryServer}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2" Background="{DynamicResource InputBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10">
                                    <StackPanel>
                                        <TextBlock Text="DATABASE" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextLabelBrush}"/>
                                        <TextBlock Text="{Binding DiagnosticResult.SummaryDatabase}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="4" Background="{DynamicResource InputBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10">
                                    <StackPanel>
                                        <TextBlock Text="AUTHENTICATION" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextLabelBrush}"/>
                                        <TextBlock Text="{Binding DiagnosticResult.SummaryAuth}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="6" Background="{DynamicResource InputBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10">
                                    <StackPanel>
                                        <TextBlock Text="RESPONSE TIME" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextLabelBrush}"/>
                                        <TextBlock Text="{Binding DiagnosticResult.SummaryResponseTime}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- SECTION 1: CONNECTIVITY CHECKS CHECKLIST -->
                            <Border Background="{DynamicResource InputBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,14">
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock Text="Connectivity Checks" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding DiagnosticResult.OverallStatus, StringFormat={}Overall: {0}}"
                                                   FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                                    </Grid>

                                    <ItemsControl ItemsSource="{Binding ConnectivityChecks}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Padding="10,8" Margin="0,2" CornerRadius="6" Background="{DynamicResource CardBgBrush}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="26"/>
                                                            <ColumnDefinition Width="150"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <!-- Status Icon -->
                                                        <TextBlock Text="{Binding StatusIcon}" FontSize="13" FontWeight="Bold" Foreground="{Binding StatusColor}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                        <!-- Name -->
                                                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                                        <!-- Details -->
                                                        <TextBlock Grid.Column="2" Text="{Binding Details}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                        <!-- Latency -->
                                                        <TextBlock Grid.Column="3" Text="{Binding LatencyText}" FontSize="11" FontWeight="Bold" Foreground="{Binding StatusColor}" VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- SECTION 2: FAILURE DIAGNOSTICS & REMEDIATION (Visible on Failure) -->
                            <Border Background="{DynamicResource CardBgAltBrush}" BorderBrush="{DynamicResource DangerBrush}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,14"
                                    Visibility="{Binding DiagnosticResult.Success, Converter={StaticResource BooleanNotToVisibilityConverter}}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource DangerBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="Possible Root Causes &amp; Troubleshooting Steps" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource DangerBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <ItemsControl ItemsSource="{Binding DiagnosticResult.PossibleCauses}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Margin="0,3">
                                                    <TextBlock Text="•" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource DangerBrush}" Margin="0,0,8,0"/>
                                                    <TextBlock Text="{Binding}" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Technical Details Toggle -->
                                    <Button Command="{Binding ToggleTechnicalDetailsCommand}" Style="{StaticResource BtnGhost}" Margin="0,12,0,0" Padding="10,6" HorizontalAlignment="Left">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE943;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Toggle Technical Error Details" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- Expandable Technical Details Box -->
                                    <Border Margin="0,8,0,0" Padding="12" CornerRadius="6" Background="#020617" BorderBrush="#1E293B" BorderThickness="1"
                                            Visibility="{Binding ShowTechnicalDetails, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding DiagnosticResult.TechnicalDetails.ExceptionType, StringFormat={}Exception: {0}}" FontSize="11" FontWeight="Bold" Foreground="#38BDF8"/>
                                            <TextBlock Text="{Binding DiagnosticResult.TechnicalDetails.ErrorNumber, StringFormat={}SQL Error Number: {0}}" FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0"/>
                                            <TextBlock Text="{Binding DiagnosticResult.TechnicalDetails.Message, StringFormat={}Message: {0}}" FontSize="11" Foreground="#CBD5E1" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- SECTION 3: SQL SERVER INFORMATION (Visible on Success) -->
                            <Border Background="{DynamicResource InputBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,14"
                                    Visibility="{Binding DiagnosticResult.Success, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <TextBlock Text="&#xE78B;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="SQL Server Information" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Version -->
                                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,10">
                                            <TextBlock Text="VERSION" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextLabelBrush}"/>
                                            <TextBlock Text="{Binding DiagnosticResult.ServerInfo.Version}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <!-- Edition -->
                                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,10">
                                            <TextBlock Text="EDITION" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextLabelBrush}"/>
                                            <TextBlock Text="{Binding DiagnosticResult.ServerInfo.Edition}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <!-- Operating System -->
                                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,10,10">
                                            <TextBlock Text="OPERATING SYSTEM" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextLabelBrush}"/>
                                            <TextBlock Text="{Binding DiagnosticResult.ServerInfo.OperatingSystem}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <!-- Instance Name -->
                                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,10">
                                            <TextBlock Text="INSTANCE NAME" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextLabelBrush}"/>
                                            <TextBlock Text="{Binding DiagnosticResult.ServerInfo.InstanceName}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <!-- Server Uptime -->
                                        <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,10,10">
                                            <TextBlock Text="SERVER UPTIME" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextLabelBrush}"/>
                                            <TextBlock Text="{Binding DiagnosticResult.ServerInfo.ServerUptime}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <!-- Service Status -->
                                        <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,0,10">
                                            <TextBlock Text="SQL SERVICE STATUS" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextLabelBrush}"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                <Ellipse Width="8" Height="8" Fill="#10B981" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <TextBlock Text="{Binding DiagnosticResult.ServerInfo.ServiceStatus}" FontSize="12" FontWeight="SemiBold" Foreground="#10B981"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- TCP Port -->
                                        <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,10,0">
                                            <TextBlock Text="TCP PORT" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextLabelBrush}"/>
                                            <TextBlock Text="{Binding DiagnosticResult.ServerInfo.TcpPort}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <!-- Current Database -->
                                        <StackPanel Grid.Row="3" Grid.Column="1">
                                            <TextBlock Text="CURRENT DATABASE" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextLabelBrush}"/>
                                            <TextBlock Text="{Binding DiagnosticResult.ServerInfo.CurrentDatabase}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- SECTION 4: SERVER HEALTH OVERVIEW (Visible on Success) -->
                            <Border Background="{DynamicResource InputBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16"
                                    Visibility="{Binding DiagnosticResult.Success, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <TextBlock Text="&#xE958;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="Server Health Overview" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/><ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/><ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Active Connections -->
                                        <Border Grid.Row="0" Grid.Column="0" Background="{DynamicResource CardBgBrush}" CornerRadius="8" Padding="10" Margin="0,0,0,8">
                                            <StackPanel>
                                                <TextBlock Text="ACTIVE CONNECTIONS" FontSize="8" FontWeight="Bold" Foreground="{DynamicResource TextLabelBrush}"/>
                                                <TextBlock Text="{Binding DiagnosticResult.ServerHealth.ActiveConnections}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Databases Count -->
                                        <Border Grid.Row="0" Grid.Column="2" Background="{DynamicResource CardBgBrush}" CornerRadius="8" Padding="10" Margin="0,0,0,8">
                                            <StackPanel>
                                                <TextBlock Text="TOTAL DATABASES" FontSize="8" FontWeight="Bold" Foreground="{DynamicResource TextLabelBrush}"/>
                                                <TextBlock Text="{Binding DiagnosticResult.ServerHealth.DatabaseCount}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Blocked Processes -->
                                        <Border Grid.Row="0" Grid.Column="4" Background="{DynamicResource CardBgBrush}" CornerRadius="8" Padding="10" Margin="0,0,0,8">
                                            <StackPanel>
                                                <TextBlock Text="BLOCKED PROCESSES" FontSize="8" FontWeight="Bold" Foreground="{DynamicResource TextLabelBrush}"/>
                                                <TextBlock Text="{Binding DiagnosticResult.ServerHealth.BlockedProcesses}" FontSize="16" FontWeight="Bold" Foreground="#10B981" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Memory Usage -->
                                        <Border Grid.Row="1" Grid.Column="0" Background="{DynamicResource CardBgBrush}" CornerRadius="8" Padding="10">
                                            <StackPanel>
                                                <TextBlock Text="SQL MEMORY USED" FontSize="8" FontWeight="Bold" Foreground="{DynamicResource TextLabelBrush}"/>
                                                <TextBlock Text="{Binding DiagnosticResult.ServerHealth.MemoryUsage}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- TempDB Space -->
                                        <Border Grid.Row="1" Grid.Column="2" Background="{DynamicResource CardBgBrush}" CornerRadius="8" Padding="10">
                                            <StackPanel>
                                                <TextBlock Text="TEMPDB RESERVED" FontSize="8" FontWeight="Bold" Foreground="{DynamicResource TextLabelBrush}"/>
                                                <TextBlock Text="{Binding DiagnosticResult.ServerHealth.TempDbUsage}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- CPU Usage -->
                                        <Border Grid.Row="1" Grid.Column="4" Background="{DynamicResource CardBgBrush}" CornerRadius="8" Padding="10">
                                            <StackPanel>
                                                <TextBlock Text="CPU USAGE" FontSize="8" FontWeight="Bold" Foreground="{DynamicResource TextLabelBrush}"/>
                                                <TextBlock Text="{Binding DiagnosticResult.ServerHealth.CpuUsage}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- ======================================================== -->
                <!-- TAB 1: SAVED PROFILES VIEW                               -->
                <!-- ======================================================== -->
                <ScrollViewer Grid.Row="1" Style="{StaticResource Scroller}"
                              Visibility="{Binding IsProfilesTabSelected, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel>
                        <!-- Empty State -->
                        <Border Padding="30" CornerRadius="10" Background="{DynamicResource CardBgAltBrush}"
                                Visibility="{Binding SavedProfiles.Count, Converter={StaticResource IntToVisibilityConverter}, ConverterParameter=invert}">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="No saved profiles yet." FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="Click 'Save Profile' in the left pane to store configurations for instant testing."
                                           FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Profile Cards -->
                        <ItemsControl ItemsSource="{Binding SavedProfiles}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource InputBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                            CornerRadius="10" Padding="14" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Width="38" Height="38" CornerRadius="8" Background="{DynamicResource AccentMutedBrush}"
                                                    BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" Margin="0,0,12,0" VerticalAlignment="Center">
                                                <TextBlock Text="&#xEA47;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource AccentBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                    <TextBlock Text="{Binding Server}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                    <TextBlock Text="  •  " FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                                                    <TextBlock Text="{Binding Database}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                                                    <TextBlock Text="  •  " FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                                                    <TextBlock Text="{Binding LastStatus}" FontSize="11" FontWeight="Bold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsHealthy}" Value="True">
                                                                        <Setter Property="Foreground" Value="#10B981"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding LastStatus}" Value="Failed">
                                                                        <Setter Property="Foreground" Value="#EF4444"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- Actions -->
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Command="{Binding DataContext.LoadAndConnectProfileCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}" Style="{StaticResource SqlPrimaryBtn}" Height="32" Padding="12,0" Margin="0,0,6,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="10" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="Connect" FontSize="11" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>

                                                <Button Command="{Binding DataContext.LoadProfileToFormCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}" Style="{StaticResource SqlGhostBtn}" Height="32" Padding="10,0" Margin="0,0,6,0" ToolTip="Edit in form">
                                                    <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="11" VerticalAlignment="Center"/>
                                                </Button>

                                                <Button Command="{Binding DataContext.DeleteProfileCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}" Style="{StaticResource SqlGhostBtn}" Height="32" Padding="10,0" ToolTip="Delete profile">
                                                    <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="#EF4444" VerticalAlignment="Center"/>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- ======================================================== -->
                <!-- TAB 2: HISTORY VIEW                                      -->
                <!-- ======================================================== -->
                <Grid Grid.Row="1" Visibility="{Binding IsHistoryTabSelected, Converter={StaticResource BoolToVisibilityConverter}}">
                    <!-- Empty State -->
                    <Border Padding="30" CornerRadius="10" Background="{DynamicResource CardBgAltBrush}"
                            Visibility="{Binding HistoryItems.Count, Converter={StaticResource IntToVisibilityConverter}, ConverterParameter=invert}">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="No test history records." FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="Past SQL connection tests will be automatically logged here."
                                       FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- History DataGrid -->
                    <DataGrid ItemsSource="{Binding HistoryItems}" Style="{StaticResource DGrid}" AutoGenerateColumns="False" IsReadOnly="True"
                              SelectionMode="Single" SelectionUnit="FullRow"
                              Visibility="{Binding HistoryItems.Count, Converter={StaticResource IntToVisibilityConverter}}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Time" Binding="{Binding TimeFormatted}" Width="80"/>
                            <DataGridTextColumn Header="Server / Instance" Binding="{Binding Server}" Width="160"/>
                            <DataGridTextColumn Header="Database" Binding="{Binding Database}" Width="110"/>
                            <DataGridTextColumn Header="Auth" Binding="{Binding AuthType}" Width="110"/>
                            <DataGridTemplateColumn Header="Result" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#064E3B"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Success}" Value="False">
                                                            <Setter Property="Background" Value="#4C0519"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding ResultText}" FontSize="10" FontWeight="Bold" Foreground="{Binding ResultColor}"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Latency" Binding="{Binding LatencyText}" Width="80"/>
                            <DataGridTextColumn Header="Details / Error" Binding="{Binding ErrorMessage}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Grid>
        </Border>

        <!-- ============================================================ -->
        <!-- SAVE PROFILE MODAL DIALOG                                    -->
        <!-- ============================================================ -->
        <Border Grid.ColumnSpan="2" Background="{DynamicResource OverlayBgBrush}"
                Visibility="{Binding ShowSaveProfileDialog, Converter={StaticResource BoolToVisibilityConverter}}"
                Panel.ZIndex="100">
            <Border Width="420" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Background="{DynamicResource CardBgBrush}" CornerRadius="14" Padding="24"
                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Save Connection Profile" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="Store instance parameters for fast recall" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Command="{Binding CloseSaveProfileDialogCommand}" Width="28" Height="28"
                                Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="Cancel">
                            <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"/>
                        </Button>
                    </Grid>

                    <TextBlock Text="PROFILE NAME" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextLabelBrush}" Margin="0,0,0,4"/>
                    <Border Style="{StaticResource SqlInputContainer}">
                        <TextBox Text="{Binding ProfileNameInput, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0"
                                 Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" FontWeight="SemiBold"
                                 Padding="10,0" VerticalContentAlignment="Center" CaretBrush="{DynamicResource AccentBrush}"/>
                    </Border>

                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Command="{Binding CloseSaveProfileDialogCommand}" Style="{StaticResource SqlGhostBtn}" Content="Cancel"/>
                        <Button Grid.Column="2" Command="{Binding SaveProfileConfirmedCommand}" Style="{StaticResource SqlPrimaryBtn}" Content="Save Profile"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Page>
