<Page x:Class="NetworkDiscoveryTool.UI.Views.Dashboard.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
      Title="Dashboard"
      Background="{DynamicResource PageBgBrush}"
      SnapsToDevicePixels="True"
      UseLayoutRounding="True"
      TextOptions.TextFormattingMode="Display"
      TextOptions.TextRenderingMode="ClearType"
      RenderOptions.ClearTypeHint="Enabled">

    <Page.Resources>
        <!-- Sparkline helper path brush -->
        <LinearGradientBrush x:Key="BlueSparkGrad" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#400EA5E9" Offset="0"/>
            <GradientStop Color="#000EA5E9" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="GreenSparkGrad" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#4010B981" Offset="0"/>
            <GradientStop Color="#0010B981" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="PurpleSparkGrad" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#40A855F7" Offset="0"/>
            <GradientStop Color="#00A855F7" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="AmberSparkGrad" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#40F59E0B" Offset="0"/>
            <GradientStop Color="#00F59E0B" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="CyanSparkGrad" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#4006B6D4" Offset="0"/>
            <GradientStop Color="#0006B6D4" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="RoseSparkGrad" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#40F43F5E" Offset="0"/>
            <GradientStop Color="#00F43F5E" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="WaveFillGrad" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#300EA5E9" Offset="0"/>
            <GradientStop Color="#020EA5E9" Offset="1"/>
        </LinearGradientBrush>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="20,16,20,24">
        <StackPanel MaxWidth="1480" HorizontalAlignment="Stretch">

            <!-- ======================================================== -->
            <!-- ROW 1: 4 GLOWING KPI METRIC CARDS                        -->
            <!-- ======================================================== -->
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- CARD 1: TOTAL DEVICES -->
                <Border Grid.Column="0" Style="{StaticResource MetricCardBlue}" Margin="0,0,10,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header: Icon, Title & Menu -->
                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <!-- Icon Box -->
                            <Border Width="40" Height="40" CornerRadius="10" Background="#100EA5E9" BorderBrush="#350EA5E9" BorderThickness="1">
                                <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#0EA5E9"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                                <TextBlock Text="Total Devices" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="&#xE712;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Top"/>
                        </Grid>

                        <!-- Value & Active Badge -->
                        <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,10">
                            <TextBlock Text="{Binding TotalDevices}" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,10,0"/>
                            <Border Background="{DynamicResource SuccessBgBrush}" BorderBrush="{DynamicResource SuccessBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding OnlineDevices}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}" Margin="0,0,4,0"/>
                                    <TextBlock Text="Active" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SuccessBrush}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Trend & Mini Sparkline -->
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#x2191; Latest Scan Active" FontSize="11" FontWeight="Medium" Foreground="#0EA5E9" VerticalAlignment="Bottom"/>
                            <!-- Blue Sparkline Path -->
                            <Canvas Grid.Column="1" Height="26" Width="100" HorizontalAlignment="Right">
                                <Path Data="M 0,22 Q 15,10 30,18 T 60,6 T 85,14 L 100,4 L 100,26 L 0,26 Z" Fill="{StaticResource BlueSparkGrad}"/>
                                <Path Data="M 0,22 Q 15,10 30,18 T 60,6 T 85,14 L 100,4" Stroke="#0EA5E9" StrokeThickness="2"/>
                            </Canvas>
                        </Grid>
                    </Grid>
                </Border>

                <!-- CARD 2: ONLINE HOST HEALTH -->
                <Border Grid.Column="1" Style="{StaticResource MetricCardGreen}" Margin="0,0,10,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header: Icon, Title & Menu -->
                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="40" Height="40" CornerRadius="10" Background="#1010B981" BorderBrush="#3510B981" BorderThickness="1">
                                <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#10B981"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                                <TextBlock Text="Online Host Health" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="&#xE712;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Top"/>
                        </Grid>

                        <!-- Value -->
                        <TextBlock Grid.Row="1" Text="{Binding OnlinePercent, StringFormat={}{0:F1}%}" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,10"/>

                        <!-- Trend & Mini Sparkline -->
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding OfflineDevices, StringFormat={}{0} Hosts Offline}" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Bottom"/>
                            <!-- Green Sparkline Path -->
                            <Canvas Grid.Column="1" Height="26" Width="100" HorizontalAlignment="Right">
                                <Path Data="M 0,20 Q 20,24 40,12 T 70,8 T 90,14 L 100,4 L 100,26 L 0,26 Z" Fill="{StaticResource GreenSparkGrad}"/>
                                <Path Data="M 0,20 Q 20,24 40,12 T 70,8 T 90,14 L 100,4" Stroke="#10B981" StrokeThickness="2"/>
                            </Canvas>
                        </Grid>
                    </Grid>
                </Border>

                <!-- CARD 3: AVERAGE LATENCY -->
                <Border Grid.Column="2" Style="{StaticResource MetricCardPurple}" Margin="0,0,10,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header: Icon, Title & Menu -->
                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="40" Height="40" CornerRadius="10" Background="#10A855F7" BorderBrush="#35A855F7" BorderThickness="1">
                                <TextBlock Text="&#xE916;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#A855F7"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                                <TextBlock Text="Average Latency" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="&#xE712;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Top"/>
                        </Grid>

                        <!-- Value -->
                        <TextBlock Grid.Row="1" Text="{Binding AverageLatencyMs, StringFormat={}{0}ms}" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,10"/>

                        <!-- Trend & Mini Sparkline -->
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Real Network Ping" FontSize="11" FontWeight="Medium" Foreground="#A855F7" VerticalAlignment="Bottom"/>
                            <!-- Purple Sparkline Path -->
                            <Canvas Grid.Column="1" Height="26" Width="100" HorizontalAlignment="Right">
                                <Path Data="M 0,8 Q 25,18 50,12 T 80,22 L 100,10 L 100,26 L 0,26 Z" Fill="{StaticResource PurpleSparkGrad}"/>
                                <Path Data="M 0,8 Q 25,18 50,12 T 80,22 L 100,10" Stroke="#A855F7" StrokeThickness="2"/>
                            </Canvas>
                        </Grid>
                    </Grid>
                </Border>

                <!-- CARD 4: OPEN PORTS / VULNERABILITIES -->
                <Border Grid.Column="3" Style="{StaticResource MetricCardAmber}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header: Icon, Title & Menu -->
                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="40" Height="40" CornerRadius="10" Background="#10F59E0B" BorderBrush="#35F59E0B" BorderThickness="1">
                                <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#F59E0B"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                                <TextBlock Text="Open Ports / Risks" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="&#xE712;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Top"/>
                        </Grid>

                        <!-- Value -->
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="{Binding OpenPortsCount}" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text=" / " FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}"/>
                            <TextBlock Text="{Binding VulnerabilitiesCount}" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource DangerBrush}"/>
                        </StackPanel>

                        <!-- Trend & Mini Sparkline -->
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Identified Ports" FontSize="11" FontWeight="Medium" Foreground="#F59E0B" VerticalAlignment="Bottom"/>
                            <!-- Amber Sparkline Path -->
                            <Canvas Grid.Column="1" Height="26" Width="100" HorizontalAlignment="Right">
                                <Path Data="M 0,22 Q 20,18 45,24 T 75,10 L 100,6 L 100,26 L 0,26 Z" Fill="{StaticResource AmberSparkGrad}"/>
                                <Path Data="M 0,22 Q 20,18 45,24 T 75,10 L 100,6" Stroke="#F59E0B" StrokeThickness="2"/>
                            </Canvas>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- ======================================================== -->
            <!-- ROW 1.5: 3 SPECIALIZED DEVICE STATS (CAMERAS, PRINTERS, SERVERS) -->
            <!-- ======================================================== -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- STAT 1: IP CAMERAS -->
                <Border Grid.Column="0" Style="{StaticResource MetricCardAmber}" Margin="0,0,10,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="38" Height="38" CornerRadius="10" Background="#15F59E0B" BorderBrush="#40F59E0B" BorderThickness="1">
                                <TextBlock Text="&#xE714;" FontFamily="Segoe MDL2 Assets" FontSize="17" Foreground="#F59E0B"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                                <TextBlock Text="IP Cameras" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="CCTV &amp; Video Streams" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"/>
                            </StackPanel>
                            <Border Grid.Column="2" Background="#15F59E0B" BorderBrush="#35F59E0B" BorderThickness="1" CornerRadius="8" Padding="6,2" VerticalAlignment="Center">
                                <TextBlock Text="RTSP / ONVIF" FontSize="9" FontWeight="Bold" Foreground="#F59E0B"/>
                            </Border>
                        </Grid>

                        <!-- Value & Active Badge -->
                        <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
                            <TextBlock Text="{Binding CameraCount}" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,10,0"/>
                            <Border Background="{DynamicResource SuccessBgBrush}" BorderBrush="{DynamicResource SuccessBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding ActiveCameraCount}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}" Margin="0,0,4,0"/>
                                    <TextBlock Text="Online" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SuccessBrush}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Subtitle & Sparkline -->
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Surveillance Nodes" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Bottom"/>
                            <Canvas Grid.Column="1" Height="22" Width="90" HorizontalAlignment="Right">
                                <Path Data="M 0,18 Q 20,6 45,15 T 75,8 L 90,4 L 90,22 L 0,22 Z" Fill="{StaticResource AmberSparkGrad}"/>
                                <Path Data="M 0,18 Q 20,6 45,15 T 75,8 L 90,4" Stroke="#F59E0B" StrokeThickness="2"/>
                            </Canvas>
                        </Grid>
                    </Grid>
                </Border>

                <!-- STAT 2: PRINTERS -->
                <Border Grid.Column="1" Style="{StaticResource MetricCardCyan}" Margin="0,0,10,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="38" Height="38" CornerRadius="10" Background="#1506B6D4" BorderBrush="#4006B6D4" BorderThickness="1">
                                <TextBlock Text="&#xE749;" FontFamily="Segoe MDL2 Assets" FontSize="17" Foreground="#06B6D4"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                                <TextBlock Text="Network Printers" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="Spoolers &amp; JetDirect" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"/>
                            </StackPanel>
                            <Border Grid.Column="2" Background="#1506B6D4" BorderBrush="#3506B6D4" BorderThickness="1" CornerRadius="8" Padding="6,2" VerticalAlignment="Center">
                                <TextBlock Text="IPP / RAW" FontSize="9" FontWeight="Bold" Foreground="#06B6D4"/>
                            </Border>
                        </Grid>

                        <!-- Value & Active Badge -->
                        <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
                            <TextBlock Text="{Binding PrinterCount}" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,10,0"/>
                            <Border Background="{DynamicResource SuccessBgBrush}" BorderBrush="{DynamicResource SuccessBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding ActivePrinterCount}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}" Margin="0,0,4,0"/>
                                    <TextBlock Text="Online" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SuccessBrush}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Subtitle & Sparkline -->
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Active Print Services" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Bottom"/>
                            <Canvas Grid.Column="1" Height="22" Width="90" HorizontalAlignment="Right">
                                <Path Data="M 0,16 Q 25,20 50,8 T 80,14 L 90,6 L 90,22 L 0,22 Z" Fill="{StaticResource CyanSparkGrad}"/>
                                <Path Data="M 0,16 Q 25,20 50,8 T 80,14 L 90,6" Stroke="#06B6D4" StrokeThickness="2"/>
                            </Canvas>
                        </Grid>
                    </Grid>
                </Border>

                <!-- STAT 3: SERVERS -->
                <Border Grid.Column="2" Style="{StaticResource MetricCardPurple}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="38" Height="38" CornerRadius="10" Background="#15A855F7" BorderBrush="#40A855F7" BorderThickness="1">
                                <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" FontSize="17" Foreground="#A855F7"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                                <TextBlock Text="Servers &amp; Nodes" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="Web, DB &amp; Domain Controllers" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"/>
                            </StackPanel>
                            <Border Grid.Column="2" Background="#15A855F7" BorderBrush="#35A855F7" BorderThickness="1" CornerRadius="8" Padding="6,2" VerticalAlignment="Center">
                                <TextBlock Text="HOST / VM" FontSize="9" FontWeight="Bold" Foreground="#A855F7"/>
                            </Border>
                        </Grid>

                        <!-- Value & Active Badge -->
                        <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
                            <TextBlock Text="{Binding ServerCount}" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,10,0"/>
                            <Border Background="{DynamicResource SuccessBgBrush}" BorderBrush="{DynamicResource SuccessBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding ActiveServerCount}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}" Margin="0,0,4,0"/>
                                    <TextBlock Text="Online" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SuccessBrush}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Subtitle & Sparkline -->
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Core Infrastructure" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Bottom"/>
                            <Canvas Grid.Column="1" Height="22" Width="90" HorizontalAlignment="Right">
                                <Path Data="M 0,10 Q 25,18 50,10 T 75,18 L 90,8 L 90,22 L 0,22 Z" Fill="{StaticResource PurpleSparkGrad}"/>
                                <Path Data="M 0,10 Q 25,18 50,10 T 75,18 L 90,8" Stroke="#A855F7" StrokeThickness="2"/>
                            </Canvas>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- ======================================================== -->
            <!-- ROW 2: REAL SCAN ANALYTICS & OS DISTRIBUTION             -->
            <!-- ======================================================== -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="6.2*"/>
                    <ColumnDefinition Width="3.8*"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT: LATEST SCAN PERFORMANCE & RECENT SCANS HISTORY -->
                <Border Grid.Column="0" Style="{StaticResource NetScopeCard}" Margin="0,0,12,0" MinHeight="260">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Grid Grid.Row="0" Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Latest Scan Activity &amp; History" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            
                            <!-- Real-time Status Badge -->
                            <Border Grid.Column="1" Background="{DynamicResource SuccessBgBrush}" BorderBrush="{DynamicResource SuccessBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="8,2" Margin="12,0,0,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="6" Height="6" Fill="{DynamicResource SuccessBrush}" Margin="0,0,6,0"/>
                                    <TextBlock Text="Database Connected" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SuccessBrush}"/>
                                </StackPanel>
                            </Border>

                            <!-- Refresh Button -->
                            <Button Grid.Column="3" Style="{StaticResource BtnActionIcon}" Command="{Binding LoadAllDataCommand}" ToolTip="Refresh Scan History">
                                <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Button>
                        </Grid>

                        <!-- Scan Metrics Strip -->
                        <Border Grid.Row="1" Background="{DynamicResource CardBgAltBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Metric 1: Last Scan Time -->
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Last Scan Time" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"/>
                                    <TextBlock Text="{Binding LastScanTime}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2,0,0"/>
                                </StackPanel>

                                <Border Grid.Column="1" Width="1" Height="20" Background="{DynamicResource CardBorderBrush}" Margin="8,0"/>

                                <!-- Metric 2: Target Range -->
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Subnet Range" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"/>
                                    <TextBlock Text="{Binding LastScanRange}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Margin="0,2,0,0"/>
                                </StackPanel>

                                <Border Grid.Column="3" Width="1" Height="20" Background="{DynamicResource CardBorderBrush}" Margin="8,0"/>

                                <!-- Metric 3: Scan Duration -->
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Scan Duration" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"/>
                                    <TextBlock Text="{Binding LastScanDurationMs, StringFormat={}{0} ms}" FontSize="11" FontWeight="SemiBold" Foreground="#10B981" Margin="0,2,0,0"/>
                                </StackPanel>

                                <Border Grid.Column="5" Width="1" Height="20" Background="{DynamicResource CardBorderBrush}" Margin="8,0"/>

                                <!-- Metric 4: Hosts Scanned -->
                                <StackPanel Grid.Column="6">
                                    <TextBlock Text="Scanned Hosts" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"/>
                                    <TextBlock Text="{Binding LastScanDeviceCount, StringFormat={}{0} Devices}" FontSize="11" FontWeight="SemiBold" Foreground="#A855F7" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Recent Scans DataGrid -->
                        <DataGrid Grid.Row="2" ItemsSource="{Binding RecentScans}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                  Background="Transparent" BorderThickness="0" RowHeight="32" HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource CardBorderBrush}">
                            <DataGrid.Resources>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="{DynamicResource InputBgBrush}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="FontSize" Value="11"/>
                                    <Setter Property="Height" Value="28"/>
                                    <Setter Property="Padding" Value="8,0"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                </Style>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Padding" Value="8,0"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                    <Setter Property="FontSize" Value="11"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource HoverBgBrush}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource HoverBgBrush}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.Resources>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Scan Date" Binding="{Binding Date}" Width="130"/>
                                <DataGridTextColumn Header="Target Subnet" Binding="{Binding Range}" Width="160"/>
                                <DataGridTextColumn Header="Duration" Binding="{Binding Duration}" Width="90"/>
                                <DataGridTextColumn Header="Description / Label" Binding="{Binding Description}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <!-- RIGHT: OS & PLATFORM DISTRIBUTION CARD (DYNAMIC BARS) -->
                <Border Grid.Column="1" Style="{StaticResource NetScopeCard}" MinHeight="260">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Grid Grid.Row="0" Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="OS &amp; Platform Distribution" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Content="View Scanner" Command="{Binding ViewAllOSCommand}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"
                                    Background="Transparent" BorderThickness="0" Cursor="Hand"/>
                        </Grid>

                        <!-- Dynamic Progress Bars List -->
                        <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,4,0,0">
                            <!-- Windows -->
                            <Grid Margin="0,0,0,12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="8" Height="8" CornerRadius="2" Background="#0284C7" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Grid.Column="1" Text="Windows OS" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding WindowsPercentText}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </Grid>
                                <ProgressBar Grid.Row="1" Value="{Binding WindowsPercent}" Minimum="0" Maximum="100" Height="6"
                                             Background="#15FFFFFF" Foreground="#0284C7" BorderThickness="0"/>
                            </Grid>

                            <!-- Linux / Unix -->
                            <Grid Margin="0,0,0,12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="8" Height="8" CornerRadius="2" Background="#10B981" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Grid.Column="1" Text="Linux / Unix" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding LinuxPercentText}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </Grid>
                                <ProgressBar Grid.Row="1" Value="{Binding LinuxPercent}" Minimum="0" Maximum="100" Height="6"
                                             Background="#15FFFFFF" Foreground="#10B981" BorderThickness="0"/>
                            </Grid>

                            <!-- IoT / Embedded Devices -->
                            <Grid Margin="0,0,0,12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="8" Height="8" CornerRadius="2" Background="#A855F7" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Grid.Column="1" Text="IoT &amp; Cameras" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding IotPercentText}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </Grid>
                                <ProgressBar Grid.Row="1" Value="{Binding IotPercent}" Minimum="0" Maximum="100" Height="6"
                                             Background="#15FFFFFF" Foreground="#A855F7" BorderThickness="0"/>
                            </Grid>

                            <!-- Network Devices & Gateways -->
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="8" Height="8" CornerRadius="2" Background="#F59E0B" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Grid.Column="1" Text="Network &amp; Printers" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding NetworkDevicesPercentText}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </Grid>
                                <ProgressBar Grid.Row="1" Value="{Binding NetworkDevicesPercent}" Minimum="0" Maximum="100" Height="6"
                                             Background="#15FFFFFF" Foreground="#F59E0B" BorderThickness="0"/>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- ======================================================== -->
            <!-- ROW 3: SYSTEM HEALTH & HARDWARE DIAGNOSTICS SECTION       -->
            <!-- ======================================================== -->
            <Border Style="{StaticResource NetScopeCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Title with icon -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="28" Height="28" CornerRadius="8" Background="#1510B981" BorderBrush="#3510B981" BorderThickness="1" Margin="0,0,10,0">
                                <TextBlock Text="&#xE950;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#10B981" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="System Health &amp; Hardware Diagnostics" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Operational Badge -->
                        <Border Grid.Column="1" Background="{DynamicResource SuccessBgBrush}" BorderBrush="{DynamicResource SuccessBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="8,3" Margin="14,0,0,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="6" Height="6" Fill="{DynamicResource SuccessBrush}" Margin="0,0,6,0"/>
                                <TextBlock Text="All Systems Normal" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SuccessBrush}"/>
                            </StackPanel>
                        </Border>

                        <!-- Refresh Diagnostics Button -->
                        <Button Grid.Column="3" Style="{StaticResource BtnActionIcon}" Command="{Binding LoadAllDataCommand}" ToolTip="Refresh System Metrics">
                            <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Button>
                    </Grid>

                    <!-- Main Gauges / Progress Bars (CPU, RAM, DISK) -->
                    <Grid Grid.Row="1" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 1. CPU GAUGE CARD -->
                        <Border Grid.Column="0" Background="{DynamicResource CardBgAltBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,10,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                
                                <Grid Grid.Row="0" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE950;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#F59E0B" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Processor (CPU)" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding CpuUsage}" FontSize="14" FontWeight="Bold" Foreground="#F59E0B"/>
                                </Grid>

                                <!-- Progress Bar -->
                                <ProgressBar Grid.Row="1" Value="{Binding CpuPercent}" Minimum="0" Maximum="100" Height="8"
                                             Background="#15FFFFFF" Foreground="#F59E0B" BorderThickness="0" Margin="0,0,0,8"/>

                                <TextBlock Grid.Row="2" Text="Total CPU Load &amp; Execution" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"/>
                            </Grid>
                        </Border>

                        <!-- 2. RAM GAUGE CARD -->
                        <Border Grid.Column="1" Background="{DynamicResource CardBgAltBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,10,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#A855F7" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Memory (RAM)" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding RamUsage}" FontSize="14" FontWeight="Bold" Foreground="#A855F7"/>
                                </Grid>

                                <!-- Progress Bar -->
                                <ProgressBar Grid.Row="1" Value="{Binding RamPercent}" Minimum="0" Maximum="100" Height="8"
                                             Background="#15FFFFFF" Foreground="#A855F7" BorderThickness="0" Margin="0,0,0,8"/>

                                <TextBlock Grid.Row="2" FontSize="10" Foreground="{DynamicResource TextMutedBrush}">
                                    <Run Text="{Binding RamUsed}"/>
                                    <Run Text=" used of "/>
                                    <Run Text="{Binding RamTotal}"/>
                                </TextBlock>
                            </Grid>
                        </Border>

                        <!-- 3. DISK GAUGE CARD -->
                        <Border Grid.Column="2" Background="{DynamicResource CardBgAltBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xEDA2;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#0EA5E9" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Storage Drive" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding DiskUsage}" FontSize="14" FontWeight="Bold" Foreground="#0EA5E9"/>
                                </Grid>

                                <!-- Progress Bar -->
                                <ProgressBar Grid.Row="1" Value="{Binding DiskPercent}" Minimum="0" Maximum="100" Height="8"
                                             Background="#15FFFFFF" Foreground="#0EA5E9" BorderThickness="0" Margin="0,0,0,8"/>

                                <TextBlock Grid.Row="2" FontSize="10" Foreground="{DynamicResource TextMutedBrush}">
                                    <Run Text="{Binding DiskFree}"/>
                                    <Run Text=" free of "/>
                                    <Run Text="{Binding DiskTotal}"/>
                                </TextBlock>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Support Services Bar -->
                    <Border Grid.Row="2" Background="{DynamicResource InputBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Windows Services -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Windows Services: " FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding RunningServices, StringFormat={}{0} Running}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center" Margin="4,0,4,0"/>
                                <TextBlock Text="{Binding StoppedServices, StringFormat={} / {0} Stopped}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                            </StackPanel>

                            <Border Grid.Column="1" Width="1" Height="16" Background="#20FFFFFF" VerticalAlignment="Center" Margin="10,0"/>

                            <!-- SQL Server -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#0EA5E9" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="SQL Server: " FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding SqlStatus}" FontSize="11" FontWeight="Bold" Foreground="#0EA5E9" VerticalAlignment="Center" Margin="4,0,0,0"/>
                            </StackPanel>

                            <Border Grid.Column="3" Width="1" Height="16" Background="#20FFFFFF" VerticalAlignment="Center" Margin="10,0"/>

                            <!-- IIS Web Server -->
                            <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#F59E0B" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="IIS Web Server: " FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding IisStatus}" FontSize="11" FontWeight="Bold" Foreground="#F59E0B" VerticalAlignment="Center" Margin="4,0,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>