<Page x:Class="NetworkDiscoveryTool.UI.Views.SystemInfo.SystemInfoPage"
      x:Name="ThisPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
      Title="Device Details"
      Background="{DynamicResource PageBgBrush}"
      Loaded="Page_Loaded">

    <Grid>
        <!-- Loading Spinner Bar -->
        <ProgressBar Style="{StaticResource LoadingSpinner}"
                     Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                     VerticalAlignment="Top" Panel.ZIndex="10"/>

        <!-- Main Scrollable Content -->
        <ScrollViewer Style="{StaticResource Scroller}" VerticalScrollBarVisibility="Auto" Padding="28,20">
            <StackPanel MaxWidth="1400" HorizontalAlignment="Stretch">

                <!-- ============================================================ -->
                <!-- 1. HERO HEADER: System Identity & Action Toolbar              -->
                <!-- ============================================================ -->
                <Border Style="{StaticResource NetScopeCard}" Padding="20,18" Margin="0,0,0,18">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: Large Device Icon Avatar -->
                        <Border Width="56" Height="56" CornerRadius="12" Background="{DynamicResource AccentMutedBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1.5" Margin="0,0,18,0" VerticalAlignment="Center">
                            <TextBlock Text="&#xE7F8;" FontFamily="Segoe MDL2 Assets" FontSize="26" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <!-- Middle: Computer & User Identity -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Machine Name -->
                                <TextBlock Text="{Binding ComputerName}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,12,0"/>

                                <!-- Online Status Pill -->
                                <Border CornerRadius="12" Padding="10,3" Background="{DynamicResource SuccessBgBrush}" BorderBrush="{DynamicResource SuccessBorderBrush}" BorderThickness="1" VerticalAlignment="Center" Margin="0,0,10,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="6" Height="6" Fill="{DynamicResource SuccessBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Operational" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}"/>
                                    </StackPanel>
                                </Border>

                                <!-- Architecture Pill -->
                                <Border CornerRadius="6" Padding="8,2" Background="{DynamicResource AccentMutedBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding OSArchitecture}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                                </Border>
                            </StackPanel>

                            <!-- User & OS Row -->
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <TextBlock Text="User: " FontSize="12" Foreground="{DynamicResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding UserName}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,18,0"/>

                                <TextBlock Text="OS: " FontSize="12" Foreground="{DynamicResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding WindowsVersion}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,18,0" TextTrimming="CharacterEllipsis" MaxWidth="400"/>

                                <TextBlock Text="{Binding ElementName=ThisPage, Path=LastRefreshTime, FallbackValue='Last updated: --'}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Right: Action Toolbar -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Refresh -->
                            <Button Command="{Binding LoadSystemInfoCommand}" Style="{StaticResource BtnPrimary}" Height="36" Padding="14,0"
                                    IsEnabled="{Binding IsLoading, Converter={StaticResource BooleanNotConverter}}" ToolTip="Refresh System Information">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="White" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Refresh" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- Copy -->
                            <Button Click="CopyInfo_Click" Style="{StaticResource BtnSecondary}" Height="36" Padding="12,0" Margin="8,0,0,0" ToolTip="Copy System Info to Clipboard">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource AccentBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Copy" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- TXT -->
                            <Button Click="ExportTxt_Click" Style="{StaticResource BtnSecondary}" Height="36" Padding="12,0" Margin="8,0,0,0" ToolTip="Export as Text File">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="TXT" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- JSON -->
                            <Button Click="ExportJson_Click" Style="{StaticResource BtnSecondary}" Height="36" Padding="12,0" Margin="8,0,0,0" ToolTip="Export as JSON File">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE943;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="JSON" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ============================================================ -->
                <!-- 2. SUMMARY KPI STAT CARDS (6 CARDS IN 2x3 GRID)               -->
                <!-- ============================================================ -->
                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- KPI 1: CPU Usage -->
                    <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource NetScopeCard}" Margin="0,0,10,10" Padding="16,14">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource AccentMutedBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" Margin="0,0,10,0">
                                    <TextBlock Text="&#xE950;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="CPU Usage" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock FontSize="20" FontWeight="Bold" Foreground="{Binding CpuUsageColor}" Margin="0,0,0,2">
                                <Run Text="{Binding CpuUsage}"/>
                            </TextBlock>
                            <TextBlock Text="Processor utilization" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                        </StackPanel>
                    </Border>

                    <!-- KPI 2: RAM Usage -->
                    <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource NetScopeCard}" Margin="0,0,10,10" Padding="16,14">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource SuccessBgBrush}" BorderBrush="{DynamicResource SuccessBorderBrush}" BorderThickness="1" Margin="0,0,10,0">
                                    <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource SuccessBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="RAM Usage" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock FontSize="20" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}" Margin="0,0,0,2">
                                <Run Text="{Binding AvailableRam}"/><Run Text=" free"/>
                            </TextBlock>
                            <TextBlock FontSize="11" Foreground="{DynamicResource TextMutedBrush}">
                                <Run Text="Installed: "/><Run Text="{Binding InstalledRam}" FontWeight="SemiBold"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- KPI 3: Disk Usage -->
                    <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource NetScopeCard}" Margin="0,0,0,10" Padding="16,14">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource WarningBgBrush}" BorderBrush="{DynamicResource WarningBorderBrush}" BorderThickness="1" Margin="0,0,10,0">
                                    <TextBlock Text="&#xEDA2;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource WarningBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="Disk Storage" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock FontSize="20" FontWeight="Bold" Foreground="{DynamicResource WarningBrush}" Margin="0,0,0,2">
                                <Run Text="{Binding Drives.Count, Mode=OneWay}"/><Run Text=" drives"/>
                            </TextBlock>
                            <TextBlock Text="Storage devices online" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                        </StackPanel>
                    </Border>

                    <!-- KPI 4: Network Status -->
                    <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource NetScopeCard}" Margin="0,0,10,0" Padding="16,14">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource AccentMutedBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" Margin="0,0,10,0">
                                    <TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="Network Connectivity" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                <Ellipse Width="8" Height="8" Fill="{DynamicResource SuccessBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Connected" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding IpAddress}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                        </StackPanel>
                    </Border>

                    <!-- KPI 5: System Uptime -->
                    <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource NetScopeCard}" Margin="0,0,10,0" Padding="16,14">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource PurpleBgBrush}" BorderBrush="{DynamicResource PurpleBorderBrush}" BorderThickness="1" Margin="0,0,10,0">
                                    <TextBlock Text="&#xEC92;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource PurpleBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="System Uptime" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock Text="{Binding UpTime}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}" Margin="0,0,0,2"/>
                            <TextBlock Text="Since last system reboot" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                        </StackPanel>
                    </Border>

                    <!-- KPI 6: Windows Health -->
                    <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource NetScopeCard}" Padding="16,14">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource SuccessBgBrush}" BorderBrush="{DynamicResource SuccessBorderBrush}" BorderThickness="1" Margin="0,0,10,0">
                                    <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource SuccessBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="System Status" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                <Ellipse Width="8" Height="8" Fill="{DynamicResource SuccessBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Healthy" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}"/>
                            </StackPanel>
                            <TextBlock Text="All systems operational" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ============================================================ -->
                <!-- 3. ERROR BANNER (if any)                                     -->
                <!-- ============================================================ -->
                <Border Background="{DynamicResource DangerBgBrush}" Padding="14,12" CornerRadius="8" Margin="0,0,0,18"
                        BorderBrush="{DynamicResource DangerBrush}" BorderThickness="1"
                        Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE783;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource DangerBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Grid.Column="1" Text="{Binding ErrorMessage}" FontSize="12" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                        <Button Grid.Column="2" Command="{Binding LoadSystemInfoCommand}" Content="Retry" Style="{StaticResource BtnDanger}" Height="30" Padding="12,0" Margin="12,0,0,0"/>
                    </Grid>
                </Border>

                <!-- ============================================================ -->
                <!-- 4. SYSTEM INFORMATION DETAILS CARD                           -->
                <!-- ============================================================ -->
                <Border Style="{StaticResource NetScopeCard}" Padding="22,18" Margin="0,0,0,18">
                    <StackPanel>
                        <!-- Card Header -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <Border Width="28" Height="28" CornerRadius="6" Background="{DynamicResource AccentMutedBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" Margin="0,0,10,0">
                                <TextBlock Text="&#xE770;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="System Identity &amp; Platform" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- 4-Column Grid -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Machine Name -->
                            <Border Grid.Row="0" Grid.Column="0" Background="{DynamicResource InputBgBrush}" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,8,8">
                                <StackPanel>
                                    <TextBlock Text="Machine Name" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding MachineName}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </StackPanel>
                            </Border>

                            <!-- Computer Name -->
                            <Border Grid.Row="0" Grid.Column="1" Background="{DynamicResource InputBgBrush}" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,8,8">
                                <StackPanel>
                                    <TextBlock Text="Computer Name" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding ComputerName}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                </StackPanel>
                            </Border>

                            <!-- Current User -->
                            <Border Grid.Row="0" Grid.Column="2" Background="{DynamicResource InputBgBrush}" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,8,8">
                                <StackPanel>
                                    <TextBlock Text="Current User" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding UserName}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </StackPanel>
                            </Border>

                            <!-- Architecture -->
                            <Border Grid.Row="0" Grid.Column="3" Background="{DynamicResource InputBgBrush}" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="Architecture" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding OSArchitecture}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                </StackPanel>
                            </Border>

                            <!-- Windows Edition -->
                            <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Background="{DynamicResource InputBgBrush}" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="Windows Edition" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding WindowsVersion}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Border>

                            <!-- System Uptime -->
                            <Border Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" Background="{DynamicResource InputBgBrush}" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10">
                                <StackPanel>
                                    <TextBlock Text="Uptime Duration" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding UpTime}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ============================================================ -->
                <!-- 5. PROCESSOR + MEMORY (SIDE BY SIDE CARDS)                   -->
                <!-- ============================================================ -->
                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Processor Card -->
                    <Border Grid.Column="0" Style="{StaticResource NetScopeCard}" Margin="0,0,10,0" Padding="22,18">
                        <StackPanel>
                            <!-- Header -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                <Border Width="28" Height="28" CornerRadius="6" Background="{DynamicResource AccentMutedBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" Margin="0,0,10,0">
                                    <TextBlock Text="&#xE950;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Processor" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- CPU Name -->
                            <Border Background="{DynamicResource InputBgBrush}" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="CPU Model Name" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding ProcessorName}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Border>

                            <!-- Live Usage -->
                            <Border Background="{DynamicResource InputBgBrush}" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Live CPU Utilization" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <TextBlock Text="Continuous hardware polling" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding CpuUsage}" FontSize="22" FontWeight="Bold" Foreground="{Binding CpuUsageColor}" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- CPU bar -->
                            <Border Height="6" CornerRadius="3" Background="{Binding CpuUsageColor}"/>
                        </StackPanel>
                    </Border>

                    <!-- Memory Card -->
                    <Border Grid.Column="1" Style="{StaticResource NetScopeCard}" Margin="10,0,0,0" Padding="22,18">
                        <StackPanel>
                            <!-- Header -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                <Border Width="28" Height="28" CornerRadius="6" Background="{DynamicResource SuccessBgBrush}" BorderBrush="{DynamicResource SuccessBorderBrush}" BorderThickness="1" Margin="0,0,10,0">
                                    <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource SuccessBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="System Memory (RAM)" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- RAM Specs -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Installed RAM -->
                                <Border Grid.Column="0" Background="{DynamicResource InputBgBrush}" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,6,0">
                                    <StackPanel>
                                        <TextBlock Text="Installed Physical RAM" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                        <TextBlock Text="{Binding InstalledRam}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                    </StackPanel>
                                </Border>

                                <!-- Available RAM -->
                                <Border Grid.Column="1" Background="{DynamicResource InputBgBrush}" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="6,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Available Free Memory" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                        <TextBlock Text="{Binding AvailableRam}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Utilization Bar -->
                            <Border Background="{DynamicResource InputBgBrush}" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10">
                                <StackPanel>
                                    <Grid Margin="0,0,0,6">
                                        <TextBlock Text="Memory Allocation" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <TextBlock Text="Active Virtual Memory Pool" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Border Height="6" CornerRadius="3" Background="{DynamicResource CardBorderBrush}">
                                        <Border CornerRadius="3" HorizontalAlignment="Left" Width="140" Background="{DynamicResource AccentBrush}"/>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ============================================================ -->
                <!-- 6. STORAGE & LOCAL DRIVES                                    -->
                <!-- ============================================================ -->
                <Border Style="{StaticResource NetScopeCard}" Padding="22,18" Margin="0,0,0,18">
                    <StackPanel>
                        <!-- Header -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="28" Height="28" CornerRadius="6" Background="{DynamicResource WarningBgBrush}" BorderBrush="{DynamicResource WarningBorderBrush}" BorderThickness="1" Margin="0,0,10,0">
                                    <TextBlock Text="&#xEDA2;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource WarningBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Local Storage &amp; Drives" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text=" (" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Drives.Count, Mode=OneWay}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text=" Drives)" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <!-- Drives List -->
                        <ItemsControl ItemsSource="{Binding Drives}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="16,12" Margin="0,0,0,10" CornerRadius="8"
                                            Background="{DynamicResource InputBgBrush}"
                                            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="48"/>
                                                    <ColumnDefinition Width="140"/>
                                                    <ColumnDefinition Width="140"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Drive Letter Badge -->
                                                <Border Width="38" Height="38" CornerRadius="8" Background="{DynamicResource AccentMutedBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1">
                                                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>

                                                <!-- Drive Label -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,12,0">
                                                    <TextBlock Text="{Binding Label}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Name, StringFormat='Local Disk ({0})'}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                                                </StackPanel>

                                                <!-- Sizes -->
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,12,0">
                                                    <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}">
                                                        <Run Text="{Binding FreeSpace}"/><Run Text=" free"/>
                                                    </TextBlock>
                                                    <TextBlock FontSize="11" Foreground="{DynamicResource TextMutedBrush}">
                                                        <Run Text="of "/><Run Text="{Binding TotalSize}"/>
                                                    </TextBlock>
                                                </StackPanel>

                                                <!-- Usage Percentage Badge -->
                                                <StackPanel Grid.Column="4" VerticalAlignment="Center">
                                                    <Border CornerRadius="12" Padding="10,3" Background="{DynamicResource SuccessBgBrush}" BorderBrush="{DynamicResource SuccessBorderBrush}" BorderThickness="1" HorizontalAlignment="Right">
                                                        <TextBlock FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}">
                                                            <Run Text="{Binding UsagePercent, StringFormat={}{0:F1}}"/><Run Text="% Used"/>
                                                        </TextBlock>
                                                    </Border>
                                                </StackPanel>
                                            </Grid>

                                            <!-- Usage Progress Bar -->
                                            <Border Grid.Row="1" Height="6" CornerRadius="3" Margin="0,10,0,0" ClipToBounds="True" Background="{DynamicResource CardBorderBrush}">
                                                <Border CornerRadius="3" HorizontalAlignment="Left"
                                                        Width="{Binding UsagePercent, Converter={StaticResource PercentToWidthConverter}, ConverterParameter=800}"
                                                        Background="{DynamicResource SuccessBrush}"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- ============================================================ -->
                <!-- 7. NETWORK INTERFACE DETAILS                                 -->
                <!-- ============================================================ -->
                <Border Style="{StaticResource NetScopeCard}" Padding="22,18" Margin="0,0,0,18">
                    <StackPanel>
                        <!-- Header -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <Border Width="28" Height="28" CornerRadius="6" Background="{DynamicResource AccentMutedBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" Margin="0,0,10,0">
                                <TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Network Adapters &amp; IP Configuration" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Network Grid -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Hostname -->
                            <Border Grid.Row="0" Grid.Column="0" Background="{DynamicResource InputBgBrush}" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,8,8">
                                <StackPanel>
                                    <TextBlock Text="Hostname" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding ComputerName}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </StackPanel>
                            </Border>

                            <!-- IPv4 -->
                            <Border Grid.Row="0" Grid.Column="1" Background="{DynamicResource InputBgBrush}" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,8,8">
                                <StackPanel>
                                    <TextBlock Text="IPv4 Address" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding IpAddress}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                </StackPanel>
                            </Border>

                            <!-- MAC -->
                            <Border Grid.Row="0" Grid.Column="2" Background="{DynamicResource InputBgBrush}" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="MAC Address" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding MacAddress}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="Consolas, Cascadia Code"/>
                                </StackPanel>
                            </Border>

                            <!-- Status -->
                            <Border Grid.Row="1" Grid.Column="0" Background="{DynamicResource InputBgBrush}" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="Interface State" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="6" Height="6" Fill="{DynamicResource SuccessBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="Connected &amp; Active" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Network Adapter -->
                            <Border Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Background="{DynamicResource InputBgBrush}" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10">
                                <StackPanel>
                                    <TextBlock Text="Physical Adapter Name" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding NetworkAdapter}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ============================================================ -->
                <!-- 8. QUICK ACTIONS TOOLBAR                                     -->
                <!-- ============================================================ -->
                <Border Style="{StaticResource NetScopeCard}" Padding="20,16" Margin="0,0,0,24">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                            <Border Width="28" Height="28" CornerRadius="6" Background="{DynamicResource AccentMutedBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" Margin="0,0,10,0">
                                <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Quick Actions" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Command="{Binding LoadSystemInfoCommand}" Style="{StaticResource BtnPrimary}" Height="36" Padding="14,0"
                                    IsEnabled="{Binding IsLoading, Converter={StaticResource BooleanNotConverter}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="White" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Refresh System Specs" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Click="CopyInfo_Click" Style="{StaticResource BtnSecondary}" Height="36" Padding="14,0" Margin="8,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource AccentBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Copy Diagnostics" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Click="OpenNetworkSettings_Click" Style="{StaticResource BtnSecondary}" Height="36" Padding="14,0" Margin="8,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource AccentBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Windows Network Settings" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Bottom Spacer -->
                <Border Height="30" Background="Transparent"/>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
