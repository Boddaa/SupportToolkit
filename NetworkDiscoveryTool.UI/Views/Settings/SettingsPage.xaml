<Page
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d" x:Class="NetworkDiscoveryTool.UI.Views.Settings.SettingsPage"
      Title="Settings"
      Background="{DynamicResource PageBgBrush}"
      Loaded="Page_Loaded">

    <Page.Resources>
        <!-- Windows 11-style Toggle Switch -->
        <Style x:Key="ToggleSwitch" TargetType="{x:Type CheckBox}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type CheckBox}">
                        <Border x:Name="Track" Width="44" Height="24" CornerRadius="12"
                                Background="{DynamicResource InputBorderBrush}"
                                BorderThickness="0" SnapsToDevicePixels="True" Cursor="Hand">
                            <Border x:Name="Thumb" Width="20" Height="20" CornerRadius="10"
                                    Background="White" HorizontalAlignment="Left" VerticalAlignment="Center"
                                    Margin="2,0,0,0">
                                <Border.RenderTransform>
                                    <TranslateTransform X="0"/>
                                </Border.RenderTransform>
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Thumb"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                             To="20" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Thumb"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                             To="0" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Track" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Category Card with left accent bar -->
        <Style x:Key="CategoryCard" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="{DynamicResource CardBgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Margin" Value="0,0,0,18"/>
        </Style>

        <!-- Settings row label -->
        <Style x:Key="SettingLabel" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource TextLabelBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Field value style -->
        <Style x:Key="FieldValue" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Stat label for About section -->
        <Style x:Key="StatLabel" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="StatValue" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
    </Page.Resources>

    <Grid>
        <ProgressBar Style="{StaticResource LoadingSpinner}"
                     Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                     VerticalAlignment="Top" Panel.ZIndex="10"/>

        <ScrollViewer Style="{StaticResource Scroller}" Margin="0,0,-17,0">
            <StackPanel Margin="36,28">

                <!-- ============================================ -->
                <!-- HEADER                                        -->
                <!-- ============================================ -->
                <StackPanel Margin="0,0,0,30">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="48" Height="48" CornerRadius="12"
                                Background="{DynamicResource InputBgBrush}" Opacity="0.12">
                            <TextBlock Text="⚙" FontFamily="Segoe UI Emoji" FontSize="26"
                                       Foreground="{DynamicResource AccentBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Settings" Style="{StaticResource HeadingXXL}"/>
                            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource BodySm}" Margin="0,3,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="2" Command="{Binding SaveAllSettingsCommand}"
                                Content="💾  Save All" FontFamily="Segoe UI Emoji"
                                Style="{StaticResource BtnPrimary}" VerticalAlignment="Center"
                                IsEnabled="{Binding IsSaving, Converter={StaticResource BooleanNotConverter}}"/>
                    </Grid>
                </StackPanel>

                <!-- ============================================ -->
                <!-- 1. APPEARANCE                                 -->

                <!-- ============================================ -->
                <!-- 2. NOTIFICATIONS                              -->

                <!-- ============================================ -->
                <!-- 3. DATABASE                                    -->

                <!-- ============================================ -->
                <!-- 4. LOGS                                        -->

                <!-- ============================================ -->
                <!-- 5. UPDATES                                     -->

                <!-- ============================================ -->
                <!-- 6. ABOUT                                       -->

                <!-- ============================================ -->
                <!-- 7. USER MANAGEMENT (Admin only)                -->

                <!-- ============================================ -->
                <!-- 8. SAVE CHANGES                                -->
                <!-- ============================================ -->
                <Border x:Name="AppearanceCard" Style="{StaticResource CategoryCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="4"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="{DynamicResource AccentBrush}" CornerRadius="2,0,0,2"/>
                        <StackPanel Grid.Column="1" Margin="24,20">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                                <TextBlock Text="🎨" FontFamily="Segoe UI Emoji" FontSize="20" VerticalAlignment="Center"/>
                                <TextBlock Text="Appearance" Style="{StaticResource HeadingSm}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Theme" Style="{StaticResource SettingLabel}"/>
                                <ComboBox Grid.Column="1" ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme}"
                                           Height="34" FontSize="12" Margin="0,0,24,0"
                                           Background="{DynamicResource InputBgBrush}"
                                           BorderBrush="{DynamicResource InputBorderBrush}"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Grid.Column="2" Text="Language" Style="{StaticResource SettingLabel}" Margin="0,0,0,0"/>
                                <ComboBox Grid.Column="3" ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}"
                                          Height="34" FontSize="12"
                                          Background="{DynamicResource InputBgBrush}"
                                          BorderBrush="{DynamicResource InputBorderBrush}"
                                          Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ============================================ -->
                <Border x:Name="NotificationsCard" Style="{StaticResource CategoryCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="4"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="{DynamicResource SuccessBrush}" CornerRadius="2,0,0,2"/>
                        <StackPanel Grid.Column="1" Margin="24,20">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                                <TextBlock Text="🔔" FontFamily="Segoe UI Emoji" FontSize="20" VerticalAlignment="Center"/>
                                <TextBlock Text="Notifications" Style="{StaticResource HeadingSm}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Enable notifications" Style="{StaticResource SettingLabel}"/>
                                    <TextBlock Text="Receive alerts for scan results and system events" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                          IsChecked="{Binding EnableNotifications}" VerticalAlignment="Center"/>
                            </Grid>
                            <Border Background="{DynamicResource InputBgBrush}" CornerRadius="8"
                                    Padding="16,12" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                    IsEnabled="{Binding EnableNotifications}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Scan complete" Style="{StaticResource SettingLabel}" FontSize="12"/>
                                                <TextBlock Text="When a network scan finishes" Style="{StaticResource Caption}" FontSize="10"/>
                                            </StackPanel>
                                            <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                                      IsChecked="{Binding NotifyOnScanComplete}" VerticalAlignment="Center"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Scan error" Style="{StaticResource SettingLabel}" FontSize="12"/>
                                                <TextBlock Text="When a scan encounters errors" Style="{StaticResource Caption}" FontSize="10"/>
                                            </StackPanel>
                                            <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                                      IsChecked="{Binding NotifyOnScanError}" VerticalAlignment="Center"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Service change" Style="{StaticResource SettingLabel}" FontSize="12"/>
                                                <TextBlock Text="When a monitored service changes state" Style="{StaticResource Caption}" FontSize="10"/>
                                            </StackPanel>
                                            <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                                      IsChecked="{Binding NotifyOnServiceChange}" VerticalAlignment="Center"/>
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="New user registration" Style="{StaticResource SettingLabel}" FontSize="12"/>
                                                <TextBlock Text="When a new user signs up" Style="{StaticResource Caption}" FontSize="10"/>
                                            </StackPanel>
                                            <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                                      IsChecked="{Binding NotifyOnNewUserRegistration}" VerticalAlignment="Center"/>
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ============================================ -->
                <Border x:Name="DatabaseCard" Style="{StaticResource CategoryCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="4"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="{DynamicResource AccentBrush}" CornerRadius="2,0,0,2"/>
                        <StackPanel Grid.Column="1" Margin="24,20">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                                <TextBlock Text="🗄" FontFamily="Segoe UI Emoji" FontSize="20" VerticalAlignment="Center"/>
                                <TextBlock Text="Database" Style="{StaticResource HeadingSm}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Location" Style="{StaticResource SettingLabel}"/>
                                <TextBox Grid.Column="1" Text="{Binding DatabasePath, Mode=OneTime}" Height="32" FontSize="11"
                                         IsReadOnly="True" Background="{DynamicResource InputBgBrush}"
                                         BorderBrush="{DynamicResource InputBorderBrush}"
                                         Foreground="{DynamicResource TextSecondaryBrush}" Padding="10,0"/>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                                <Button Command="{Binding TestConnectionCommand}"
                                        Content="🔗  Test Connection" FontFamily="Segoe UI Emoji"
                                        Style="{StaticResource BtnSecondary}" Height="32" FontSize="11"/>
                                <Button Command="{Binding ResetDatabaseCommand}"
                                        Content="🗑  Reset Database" FontFamily="Segoe UI Emoji"
                                        Style="{StaticResource BtnDanger}" Height="32" FontSize="11" Margin="10,0,0,0"/>
                            </StackPanel>
                            <Separator Style="{StaticResource Separator}" Margin="0,0,0,18"/>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Server" Style="{StaticResource SettingLabel}"/>
                                <TextBox Grid.Column="1" Text="{Binding SqlServer}" Height="32" FontSize="12"
                                         Background="{DynamicResource InputBgBrush}"
                                         BorderBrush="{DynamicResource InputBorderBrush}"
                                         Foreground="{DynamicResource TextPrimaryBrush}" Padding="10,0" Margin="0,0,12,0" TextChanged="TextBox_TextChanged"/>
                                <TextBlock Grid.Column="2" Text="Port" Style="{StaticResource SettingLabel}"/>
                                <TextBox Grid.Column="3" Text="{Binding SqlPort}" Height="32" FontSize="12"
                                         Background="{DynamicResource InputBgBrush}"
                                         BorderBrush="{DynamicResource InputBorderBrush}"
                                         Foreground="{DynamicResource TextPrimaryBrush}" Padding="10,0"/>
                            </Grid>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Database" Style="{StaticResource SettingLabel}"/>
                                <TextBox Grid.Column="1" Text="{Binding SqlDatabase}" Height="32" FontSize="12"
                                         Background="{DynamicResource InputBgBrush}"
                                         BorderBrush="{DynamicResource InputBorderBrush}"
                                         Foreground="{DynamicResource TextPrimaryBrush}" Padding="10,0" Margin="0,0,12,0"/>
                                <TextBlock Grid.Column="2" Text="Username" Style="{StaticResource SettingLabel}"/>
                                <TextBox Grid.Column="3" Text="{Binding SqlUsername}" Height="32" FontSize="12"
                                         Background="{DynamicResource InputBgBrush}"
                                         BorderBrush="{DynamicResource InputBorderBrush}"
                                         Foreground="{DynamicResource TextPrimaryBrush}" Padding="10,0"/>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Password" Style="{StaticResource SettingLabel}"/>
                                <PasswordBox Grid.Column="1" x:Name="SqlPasswordBox" Height="32" FontSize="12"
                                             Background="{DynamicResource InputBgBrush}"
                                             BorderBrush="{DynamicResource InputBorderBrush}" Padding="10,0"/>
                            </Grid>

                            <Separator Style="{StaticResource Separator}" Margin="0,18,0,18"/>

                            <StackPanel Margin="0,0,0,14">
                                <TextBlock Text="Scan Defaults" Style="{StaticResource Label}" Margin="0,0,0,14"/>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Max threads" Style="{StaticResource SettingLabel}" FontSize="11"/>
                                        <TextBox Text="{Binding DefaultMaxThreads}" Height="30" FontSize="11" Margin="0,4,8,0"
                                                 Background="{DynamicResource InputBgBrush}"
                                                 BorderBrush="{DynamicResource InputBorderBrush}"
                                                 Foreground="{DynamicResource TextPrimaryBrush}" Padding="8,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Ping timeout (ms)" Style="{StaticResource SettingLabel}" FontSize="11"/>
                                        <TextBox Text="{Binding DefaultPingTimeout}" Height="30" FontSize="11" Margin="0,4,8,0"
                                                 Background="{DynamicResource InputBgBrush}"
                                                 BorderBrush="{DynamicResource InputBorderBrush}"
                                                 Foreground="{DynamicResource TextPrimaryBrush}" Padding="8,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Port timeout (ms)" Style="{StaticResource SettingLabel}" FontSize="11"/>
                                        <TextBox Text="{Binding DefaultPortTimeout}" Height="30" FontSize="11" Margin="0,4,8,0"
                                                 Background="{DynamicResource InputBgBrush}"
                                                 BorderBrush="{DynamicResource InputBorderBrush}"
                                                 Foreground="{DynamicResource TextPrimaryBrush}" Padding="8,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="3">
                                        <TextBlock Text="Start IP" Style="{StaticResource SettingLabel}" FontSize="11"/>
                                        <TextBox Text="{Binding DefaultStartIP}" Height="30" FontSize="11" Margin="0,4,8,0"
                                                 Background="{DynamicResource InputBgBrush}"
                                                 BorderBrush="{DynamicResource InputBorderBrush}"
                                                 Foreground="{DynamicResource TextPrimaryBrush}" Padding="8,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="End IP" Style="{StaticResource SettingLabel}" FontSize="11"/>
                                        <TextBox Text="{Binding DefaultEndIP}" Height="30" FontSize="11" Margin="0,4,0,0"
                                                 Background="{DynamicResource InputBgBrush}"
                                                 BorderBrush="{DynamicResource InputBorderBrush}"
                                                 Foreground="{DynamicResource TextPrimaryBrush}" Padding="8,0"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ============================================ -->
                <Border x:Name="LogsCard" Style="{StaticResource CategoryCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="4"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="{DynamicResource WarningBrush}" CornerRadius="2,0,0,2"/>
                        <StackPanel Grid.Column="1" Margin="24,20">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                                <TextBlock Text="📋" FontFamily="Segoe UI Emoji" FontSize="20" VerticalAlignment="Center"/>
                                <TextBlock Text="Logs" Style="{StaticResource HeadingSm}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="200"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Log level" Style="{StaticResource SettingLabel}"/>
                                <ComboBox Grid.Column="1" ItemsSource="{Binding LogLevels}" SelectedItem="{Binding LogLevel}"
                                          Height="34" FontSize="12"
                                          Background="{DynamicResource InputBgBrush}"
                                          BorderBrush="{DynamicResource InputBorderBrush}"
                                          Foreground="{DynamicResource TextPrimaryBrush}" SelectionChanged="ComboBox_SelectionChanged" Grid.ColumnSpan="2" Margin="0,0,209,0"/>
                            </Grid>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Auto save" Style="{StaticResource SettingLabel}"/>
                                <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                          IsChecked="{Binding AutoSaveEnabled}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="Automatically save results to disk" Style="{StaticResource Caption}"
                                           Margin="14,0,0,0" VerticalAlignment="Center"/>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Export folder" Style="{StaticResource SettingLabel}"/>
                                <TextBox Grid.Column="1" Text="{Binding ExportFolder}" Height="32" FontSize="11"
                                         IsReadOnly="True" Background="{DynamicResource InputBgBrush}"
                                         BorderBrush="{DynamicResource InputBorderBrush}"
                                         Foreground="{DynamicResource TextSecondaryBrush}" Padding="10,0"/>
                                <Button Grid.Column="2" Command="{Binding BrowseExportFolderCommand}"
                                        Content="📂" FontFamily="Segoe UI Emoji"
                                        Width="32" Height="32" Margin="8,0,0,0"
                                        Style="{StaticResource BtnSm}" Padding="0" FontSize="12"/>
                            </Grid>
                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Default save folder" Style="{StaticResource SettingLabel}"/>
                                <TextBox Grid.Column="1" Text="{Binding DefaultSaveFolder}" Height="32" FontSize="11"
                                         IsReadOnly="True" Background="{DynamicResource InputBgBrush}"
                                         BorderBrush="{DynamicResource InputBorderBrush}"
                                         Foreground="{DynamicResource TextSecondaryBrush}" Padding="10,0"/>
                                <Button Grid.Column="2" Command="{Binding BrowseDefaultSaveFolderCommand}"
                                        Content="📂" FontFamily="Segoe UI Emoji"
                                        Width="32" Height="32" Margin="8,0,0,0"
                                        Style="{StaticResource BtnSm}" Padding="0" FontSize="12"/>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ============================================ -->
                <Border x:Name="UpdatesCard" Style="{StaticResource CategoryCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="4"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="{DynamicResource AccentBrush}" CornerRadius="2,0,0,2"/>
                        <StackPanel Grid.Column="1" Margin="24,20">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                                <TextBlock Text="🔄" FontFamily="Segoe UI Emoji" FontSize="20" VerticalAlignment="Center"/>
                                <TextBlock Text="Updates" Style="{StaticResource HeadingSm}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                <Border CornerRadius="10" Padding="8,2" Margin="12,0,0,0"
                                        Background="{DynamicResource SuccessBrush}" Opacity="0.12">
                                    <TextBlock Text="Up to date" Style="{StaticResource Caption}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource SuccessBrush}"/>
                                </Border>
                            </StackPanel>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Current version" Style="{StaticResource SettingLabel}"/>
                                <TextBlock Grid.Column="1" Text="{Binding AppVersion}" Style="{StaticResource FieldValue}"/>
                            </Grid>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Last checked" Style="{StaticResource SettingLabel}"/>
                                <TextBlock Grid.Column="1" Text="{Binding LastUpdateCheck}" Style="{StaticResource FieldValue}"/>
                            </Grid>
                            <StackPanel Orientation="Horizontal">
                                <Button Command="{Binding CheckForUpdatesCommand}"
                                        Content="🔄  Check for Updates" FontFamily="Segoe UI Emoji"
                                        Style="{StaticResource BtnPrimary}" Height="34" FontSize="12"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ============================================ -->
                <Border x:Name="AboutCard" Style="{StaticResource CategoryCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="4"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="{DynamicResource DangerBrush}" CornerRadius="2,0,0,2"/>
                        <StackPanel Grid.Column="1" Margin="24,20">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                                <TextBlock Text="ℹ" FontFamily="Segoe UI Emoji" FontSize="20" VerticalAlignment="Center"/>
                                <TextBlock Text="About" Style="{StaticResource HeadingSm}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,12,0">
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Version" Style="{StaticResource StatLabel}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding AppVersion}" Style="{StaticResource StatValue}"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Framework" Style="{StaticResource StatLabel}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding AppFramework}" Style="{StaticResource StatValue}"/>
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Database" Style="{StaticResource StatLabel}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding AppDatabase}" Style="{StaticResource StatValue}"/>
                                    </Grid>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="6,0,6,0">
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Log path" Style="{StaticResource StatLabel}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding AppLogPath}" Style="{StaticResource StatValue}"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="OS" Style="{StaticResource StatLabel}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding AppOsVersion}" Style="{StaticResource StatValue}"/>
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Uptime" Style="{StaticResource StatLabel}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding AppUptime}" Style="{StaticResource StatValue}"/>
                                    </Grid>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="12,0,0,0">
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Memory" Style="{StaticResource StatLabel}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding AppWorkingSet}" Style="{StaticResource StatValue}"/>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ============================================ -->
                <!-- FAMILY & TEAM SUB-ACCOUNTS (SUBSCRIBERS)    -->
                <!-- ============================================ -->
                
                <!-- UNLOCKED CARD (When user is Subscribed or Admin) -->
                <Border x:Name="FamilyManagementCard" Style="{StaticResource CategoryCard}"
                        Visibility="{Binding CanManageFamily, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="4"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="{DynamicResource AccentBrush}" CornerRadius="2,0,0,2"/>
                        <StackPanel Grid.Column="1" Margin="24,20">
                            <!-- Header -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="👨‍👩‍👧‍👦" FontFamily="Segoe UI Emoji" FontSize="20" VerticalAlignment="Center"/>
                                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="Family &amp; Team Sub-Accounts" Style="{StaticResource HeadingSm}"/>
                                        <TextBlock Text="Create up to 2 sub-accounts for family or team members to share this subscription" Style="{StaticResource BodySm}" Foreground="{DynamicResource TextMutedBrush}"/>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Background="{DynamicResource InputBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,4" Margin="0,0,8,0">
                                        <TextBlock Text="{Binding FamilySlotsInfo}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                    </Border>
                                    <Button Command="{Binding LoadFamilyMembersCommand}"
                                            Content="🔄  Refresh" FontFamily="Segoe UI Emoji"
                                            Style="{StaticResource BtnSecondary}" Height="30" FontSize="11" Padding="10,0"/>
                                </StackPanel>
                            </Grid>

                            <!-- Alert Messages -->
                            <Border Background="{DynamicResource DangerBgBrush}" BorderBrush="{DynamicResource DangerBrush}" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,12"
                                    Visibility="{Binding HasFamilyError, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="{Binding FamilyErrorMessage}" Foreground="{DynamicResource DangerBrush}" FontSize="12" FontWeight="SemiBold"/>
                            </Border>

                            <Border Background="{DynamicResource SuccessBgBrush}" BorderBrush="{DynamicResource SuccessBrush}" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,12"
                                    Visibility="{Binding HasFamilySuccess, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="{Binding FamilySuccessMessage}" Foreground="{DynamicResource SuccessBrush}" FontSize="12" FontWeight="SemiBold"/>
                            </Border>

                            <!-- Active Sub-Accounts -->
                            <TextBlock Text="Active Sub-Accounts" Style="{StaticResource Label}" Margin="0,0,0,8"/>

                            <Border Padding="14,10" Margin="0,0,0,12" Background="{DynamicResource InputBgBrush}" CornerRadius="6"
                                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                    Visibility="{Binding FamilyMembers.Count, Converter={StaticResource IntToVisibilityConverter}, ConverterParameter=Inverse}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="ℹ️" FontFamily="Segoe UI Emoji" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="No sub-accounts created yet. Use the form below to create accounts for family members." FontSize="12" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <ItemsControl ItemsSource="{Binding FamilyMembers}" Margin="0,0,0,14">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="12,8" Margin="0,0,0,6" Background="{DynamicResource CardBgBrush}" CornerRadius="6" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="👤" FontFamily="Segoe UI Emoji" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Username}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                        <TextBlock Text="{Binding Email, StringFormat=' ({0})'}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding CreatedAt, StringFormat='Created: {0}'}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0"/>
                                                </StackPanel>
                                                <Border Grid.Column="2" CornerRadius="4" Background="{DynamicResource SuccessBgBrush}" BorderBrush="{DynamicResource SuccessBrush}" BorderThickness="1" Padding="8,2" Margin="10,0" VerticalAlignment="Center">
                                                    <TextBlock Text="Shared Pro" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SuccessBrush}"/>
                                                </Border>
                                                <Button Grid.Column="3" Command="{Binding DataContext.RemoveFamilyMemberCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                                        CommandParameter="{Binding}"
                                                        Content="🗑️ Remove" FontFamily="Segoe UI Emoji"
                                                        Height="28" Width="90"
                                                        Background="{DynamicResource DangerBrush}" Foreground="White"
                                                        FontWeight="Bold" FontSize="11" BorderThickness="0" Cursor="Hand"
                                                        md:ButtonAssist.CornerRadius="6"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Add New Sub-Account Section -->
                            <Border Background="{DynamicResource InputBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,12"
                                    Visibility="{Binding CanAddMoreFamily, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock Text="➕  Add New Sub-Account (إضافة مستخدم تابع)" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,10"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding NewFamilyUsername, UpdateSourceTrigger=PropertyChanged}"
                                                 Margin="0,0,8,0" Height="34" VerticalContentAlignment="Center"
                                                 Background="{DynamicResource InputBgBrush}"
                                                 BorderBrush="{DynamicResource InputBorderBrush}"
                                                 Foreground="{DynamicResource TextPrimaryBrush}" Padding="10,0"
                                                 md:HintAssist.Hint="Username (3+ chars)"/>
                                        <TextBox Grid.Column="1" Text="{Binding NewFamilyPassword, UpdateSourceTrigger=PropertyChanged}"
                                                 Margin="0,0,8,0" Height="34" VerticalContentAlignment="Center"
                                                 Background="{DynamicResource InputBgBrush}"
                                                 BorderBrush="{DynamicResource InputBorderBrush}"
                                                 Foreground="{DynamicResource TextPrimaryBrush}" Padding="10,0"
                                                 md:HintAssist.Hint="Password (4+ chars)"/>
                                        <TextBox Grid.Column="2" Text="{Binding NewFamilyEmail, UpdateSourceTrigger=PropertyChanged}"
                                                 Margin="0,0,8,0" Height="34" VerticalContentAlignment="Center"
                                                 Background="{DynamicResource InputBgBrush}"
                                                 BorderBrush="{DynamicResource InputBorderBrush}"
                                                 Foreground="{DynamicResource TextPrimaryBrush}" Padding="10,0"
                                                 md:HintAssist.Hint="Email (Optional)"/>
                                        <Button Grid.Column="3" Command="{Binding CreateFamilyMemberCommand}"
                                                Content="➕ Create User" FontFamily="Segoe UI Emoji"
                                                Height="34" Padding="14,0" Background="{DynamicResource AccentBrush}" Foreground="White"
                                                FontWeight="Bold" FontSize="11" Cursor="Hand" md:ButtonAssist.CornerRadius="6"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Background="{DynamicResource InputBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10"
                                    Visibility="{Binding CanAddMoreFamily, Converter={StaticResource BoolNotToVisibilityConverter}}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="✅" FontFamily="Segoe UI Emoji" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Maximum 2 sub-accounts reached. To add another account, remove an existing account above." FontSize="12" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- LOCKED CARD (When user is on Trial, Expired, or not Subscribed) -->
                <Border x:Name="FamilyManagementLockedCard" Style="{StaticResource CategoryCard}"
                        Visibility="{Binding IsFamilyLocked, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="4"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="{DynamicResource TextMutedBrush}" CornerRadius="2,0,0,2"/>
                        <StackPanel Grid.Column="1" Margin="24,20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="🔒" FontFamily="Segoe UI Emoji" FontSize="20" VerticalAlignment="Center"/>
                                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="Family &amp; Team Sub-Accounts (Locked)" Style="{StaticResource HeadingSm}"/>
                                        <TextBlock Text="Exclusive feature: Available only for active Subscribed users" Style="{StaticResource Caption}"/>
                                    </StackPanel>
                                </StackPanel>
                                <Border Grid.Column="1" Background="{DynamicResource WarningBgBrush}" BorderBrush="{DynamicResource WarningBrush}" BorderThickness="1" CornerRadius="6" Padding="10,4">
                                    <TextBlock Text="🔒 Requires Pro Subscription" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource WarningBrush}"/>
                                </Border>
                            </Grid>
                            <TextBlock Text="Subscribe to NetworkDiscoveryTool Pro to unlock creating up to 2 sub-accounts for your family or team members, allowing them to use the software on other computers simultaneously under your subscription."
                                       FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,10,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ============================================ -->
                <Border x:Name="UserManagementCard" Style="{StaticResource CategoryCard}"
                        Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="4"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="{DynamicResource DangerBrush}" CornerRadius="2,0,0,2"/>
                        <StackPanel Grid.Column="1" Margin="24,20">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                                <TextBlock Text="👥" FontFamily="Segoe UI Emoji" FontSize="20" VerticalAlignment="Center"/>
                                <TextBlock Text="User Management" Style="{StaticResource HeadingSm}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                <Button Command="{Binding LoadPendingUsersCommand}"
                                        Content="🔄  Refresh Pending" FontFamily="Segoe UI Emoji"
                                        Style="{StaticResource BtnSecondary}" Height="32" FontSize="11"/>
                                <Button Command="{Binding LoadAllUsersCommand}"
                                        Content="🔄  Refresh All Users" FontFamily="Segoe UI Emoji"
                                        Style="{StaticResource BtnSecondary}" Height="32" FontSize="11" Margin="10,0,0,0"/>
                            </StackPanel>

                            <TextBlock Text="Pending Approvals" Style="{StaticResource Label}" Margin="0,0,0,10"/>
                            <ItemsControl ItemsSource="{Binding PendingUsers}" Margin="0,0,0,18">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="12,8" Margin="0,0,0,6"
                                                Background="{DynamicResource WarningBgBrush}" CornerRadius="6"
                                                BorderBrush="{DynamicResource WarningBrush}" BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Username}" FontSize="13" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                    <TextBlock Text="{Binding Role}" FontSize="11"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                </StackPanel>
                                                <Button Grid.Column="1" Command="{Binding DataContext.ApproveUserCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                                        CommandParameter="{Binding}"
                                                        Content="Approve" Height="28" Width="80" Margin="8,0"
                                                        Background="{DynamicResource SuccessBrush}" Foreground="White"
                                                        FontWeight="Bold" FontSize="11" BorderThickness="0" Cursor="Hand"
                                                        md:ButtonAssist.CornerRadius="6"/>
                                                <Button Grid.Column="2" Command="{Binding DataContext.RejectUserCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                                        CommandParameter="{Binding}"
                                                        Content="Reject" Height="28" Width="80"
                                                        Background="{DynamicResource DangerBrush}" Foreground="White"
                                                        FontWeight="Bold" FontSize="11" BorderThickness="0" Cursor="Hand"
                                                        md:ButtonAssist.CornerRadius="6"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="All Users" Style="{StaticResource Label}" Margin="0,0,0,10"/>
                            <ItemsControl ItemsSource="{Binding AllUsers}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="10,6" Margin="0,0,0,4"
                                                Background="{DynamicResource InputBgBrush}" CornerRadius="4"
                                                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Username}" FontSize="13"
                                                           Foreground="{DynamicResource TextLabelBrush}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Role}" FontSize="11"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="8,0"/>
                                                <Button Grid.Column="2" Command="{Binding DataContext.DeleteUserCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                                        CommandParameter="{Binding}"
                                                        Content="Delete" Height="26" Width="70"
                                                        Background="{DynamicResource DangerBrush}" Foreground="White"
                                                        FontWeight="Bold" FontSize="11" BorderThickness="0" Cursor="Hand"
                                                        md:ButtonAssist.CornerRadius="5"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ============================================ -->
                <Border x:Name="SaveChangesCard" Style="{StaticResource CategoryCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="4"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="{DynamicResource SuccessBrush}" CornerRadius="2,0,0,2"/>
                        <StackPanel Grid.Column="1" Margin="24,20">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                <TextBlock Text="💾" FontFamily="Segoe UI Emoji" FontSize="20" VerticalAlignment="Center"/>
                                <TextBlock Text="Save Changes" Style="{StaticResource HeadingSm}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="Changes to theme and language are saved automatically. Use the button below to persist all other settings to the database."
                                       Style="{StaticResource BodySm}" TextWrapping="Wrap" Margin="0,0,0,14"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Command="{Binding SaveAllSettingsCommand}"
                                        Content="💾  Save All Settings" FontFamily="Segoe UI Emoji"
                                        Style="{StaticResource BtnPrimary}" Height="38" FontSize="13"
                                        IsEnabled="{Binding IsSaving, Converter={StaticResource BooleanNotConverter}}"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>