<Page
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      mc:Ignorable="d" 
      x:Class="NetworkDiscoveryTool.UI.Views.Settings.SettingsPage"
      Title="Settings"
      Background="{DynamicResource PageBgBrush}"
      UseLayoutRounding="True"
      SnapsToDevicePixels="True"
      TextOptions.TextFormattingMode="Display"
      TextOptions.TextRenderingMode="ClearType"
      RenderOptions.ClearTypeHint="Enabled"
      Loaded="Page_Loaded">

    <Page.Resources>
        <!-- Windows 11-style Smooth Toggle Switch -->
        <Style x:Key="ToggleSwitch" TargetType="{x:Type CheckBox}">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type CheckBox}">
                        <Border x:Name="Track" Width="44" Height="22" CornerRadius="11"
                                Background="{DynamicResource InputBorderBrush}"
                                BorderThickness="1" BorderBrush="{DynamicResource CardBorderBrush}"
                                SnapsToDevicePixels="True">
                            <Border x:Name="Thumb" Width="16" Height="16" CornerRadius="8"
                                    Background="White" HorizontalAlignment="Left" VerticalAlignment="Center"
                                    Margin="2,0,0,0">
                                <Border.RenderTransform>
                                    <TranslateTransform X="0"/>
                                </Border.RenderTransform>
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Thumb"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                             To="22" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Thumb"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                             To="0" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Track" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Category Card with left accent highlight -->
        <Style x:Key="CategoryCard" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="{DynamicResource CardBgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Margin" Value="0,0,0,18"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <!-- Settings row label -->
        <Style x:Key="SettingLabel" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Field value style -->
        <Style x:Key="FieldValue" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Stat label for About section -->
        <Style x:Key="StatLabel" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="StatValue" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <!-- Accent bar color resources per category -->
        <SolidColorBrush x:Key="AccentBar1" Color="#0EA5E9"/>
        <SolidColorBrush x:Key="AccentBar2" Color="#10B981"/>
        <SolidColorBrush x:Key="AccentBar3" Color="#06B6D4"/>
        <SolidColorBrush x:Key="AccentBar4" Color="#F59E0B"/>
        <SolidColorBrush x:Key="AccentBar5" Color="#8B5CF6"/>
        <SolidColorBrush x:Key="AccentBar6" Color="#3B82F6"/>
    </Page.Resources>

    <Grid>
        <ProgressBar Style="{StaticResource LoadingSpinner}"
                     Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                     VerticalAlignment="Top" Panel.ZIndex="10"/>

        <ScrollViewer Style="{StaticResource Scroller}" Margin="0,0,-6,0" Padding="0,0,6,0">
            <StackPanel Margin="32,24,32,40">

                <!-- ============================================ -->
                <!-- HEADER & STATUS BAR                          -->
                <!-- ============================================ -->
                <Grid Margin="0,0,0,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="40" Height="40" CornerRadius="10"
                                    Background="{DynamicResource AccentMutedBrush}"
                                    BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                                    Margin="0,0,12,0" VerticalAlignment="Center">
                                <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                           Foreground="{DynamicResource AccentBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Settings &amp; Preferences" Style="{StaticResource HeadingXL}"/>
                                <TextBlock Text="Global system parameters, telemetry presets &amp; security configurations" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Status indicator pill -->
                        <Border Background="{DynamicResource InputBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="12,6" Margin="0,0,12,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="{DynamicResource SuccessBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding StatusMessage, FallbackValue='Configuration Sync Ready'}" 
                                           FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <Button Command="{Binding SaveAllSettingsCommand}"
                                Style="{StaticResource BtnPrimary}" Height="36" Padding="18,0"
                                IsEnabled="{Binding IsSaving, Converter={StaticResource BooleanNotConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Save Changes" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- ============================================ -->
                <!-- 1. APPEARANCE & LOCALIZATION                  -->
                <!-- ============================================ -->
                <Border x:Name="AppearanceCard" Style="{StaticResource CategoryCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="4"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="{StaticResource AccentBar1}" CornerRadius="2,0,0,2"/>
                        <StackPanel Grid.Column="1" Margin="22,18">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                <Border Width="30" Height="30" CornerRadius="6" Background="{DynamicResource AccentMutedBrush}" Margin="0,0,10,0">
                                    <TextBlock Text="&#xE790;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Appearance &amp; Theme" Style="{StaticResource HeadingSm}"/>
                                    <TextBlock Text="Customize color theme palette across the console (Dark, Blue, Light)" Style="{StaticResource Caption}"/>
                                </StackPanel>
                            </StackPanel>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="280"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Theme Style" Style="{StaticResource SettingLabel}"/>
                                <ComboBox Grid.Column="1" ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme}"
                                          Style="{StaticResource ModernDarkComboBox}"
                                          Height="34" FontSize="12"/>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ============================================ -->
                <!-- 2. NOTIFICATIONS & ALERTS                    -->
                <!-- ============================================ -->
                <Border x:Name="NotificationsCard" Style="{StaticResource CategoryCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="4"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="{StaticResource AccentBar2}" CornerRadius="2,0,0,2"/>
                        <StackPanel Grid.Column="1" Margin="22,18">
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="30" Height="30" CornerRadius="6" Background="{DynamicResource SuccessBgBrush}" Margin="0,0,10,0">
                                        <TextBlock Text="&#xEA8F;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource SuccessBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Notifications &amp; Event Alerts" Style="{StaticResource HeadingSm}"/>
                                        <TextBlock Text="Receive real-time desktop notifications for background discoveries &amp; health state changes" Style="{StaticResource Caption}"/>
                                    </StackPanel>
                                </StackPanel>
                                <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                          IsChecked="{Binding EnableNotifications}" VerticalAlignment="Center"/>
                            </Grid>

                            <Border Background="{DynamicResource InputBgBrush}" CornerRadius="8"
                                    Padding="16,14" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                    IsEnabled="{Binding EnableNotifications}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Trigger 1 -->
                                    <Grid Margin="0,0,16,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Scan Completion Alert" Style="{StaticResource SettingLabel}" FontSize="12"/>
                                            <TextBlock Text="Notify when a network or port sweep finishes" Style="{StaticResource Caption}" FontSize="11"/>
                                        </StackPanel>
                                        <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                                  IsChecked="{Binding NotifyOnScanComplete}" VerticalAlignment="Center"/>
                                    </Grid>

                                    <!-- Trigger 2 -->
                                    <Grid Grid.Column="1" Margin="16,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Scan Failure / Warning" Style="{StaticResource SettingLabel}" FontSize="12"/>
                                            <TextBlock Text="Notify when timeouts or socket exceptions occur" Style="{StaticResource Caption}" FontSize="11"/>
                                        </StackPanel>
                                        <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                                  IsChecked="{Binding NotifyOnScanError}" VerticalAlignment="Center"/>
                                    </Grid>

                                    <!-- Trigger 3 -->
                                    <Grid Grid.Row="1" Margin="0,0,16,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Service State Transition" Style="{StaticResource SettingLabel}" FontSize="12"/>
                                            <TextBlock Text="Notify on Windows/IIS service start, stop or recycle" Style="{StaticResource Caption}" FontSize="11"/>
                                        </StackPanel>
                                        <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                                  IsChecked="{Binding NotifyOnServiceChange}" VerticalAlignment="Center"/>
                                    </Grid>

                                    <!-- Trigger 4 -->
                                    <Grid Grid.Row="1" Grid.Column="1" Margin="16,0,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="New Operator Enrollment" Style="{StaticResource SettingLabel}" FontSize="12"/>
                                            <TextBlock Text="Notify when an operator requests console authorization" Style="{StaticResource Caption}" FontSize="11"/>
                                        </StackPanel>
                                        <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                                  IsChecked="{Binding NotifyOnNewUserRegistration}" VerticalAlignment="Center"/>
                                    </Grid>
                                </Grid>
                            </Border>

                            <!-- Telegram Admin Alert Integration -->
                            <Border Background="{DynamicResource InputBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                    CornerRadius="8" Padding="16,12" Margin="0,14,0,0"
                                    Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="&#xE715;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Telegram Admin Instant Alert Integration" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Command="{Binding TestTelegramBotCommand}"
                                                Height="26" Padding="12,0"
                                                Background="{DynamicResource AccentBrush}" Foreground="White"
                                                FontSize="11" FontWeight="SemiBold" Cursor="Hand"
                                                BorderThickness="0" md:ButtonAssist.CornerRadius="5">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE898;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Send Test Alert" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.8*"/>
                                            <ColumnDefinition Width="1.2*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,12,0">
                                            <TextBlock Text="Telegram Bot Token" Style="{StaticResource Caption}" Margin="0,0,0,4"/>
                                            <TextBox Text="{Binding TelegramBotToken, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource TxtBox}" Height="32" FontSize="11"
                                                     ToolTip="Enter your Telegram Bot API token (e.g. 123456789:ABCdef...)"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Admin Chat ID" Style="{StaticResource Caption}" Margin="0,0,0,4"/>
                                            <TextBox Text="{Binding TelegramAdminChatId, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource TxtBox}" Height="32" FontSize="11"
                                                     ToolTip="Enter your Telegram Admin Chat ID (e.g. 987654321)"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ============================================ -->
                <!-- 3. DATABASE & SCAN ENGINE PRESETS            -->
                <!-- ============================================ -->
                <Border x:Name="DatabaseCard" Style="{StaticResource CategoryCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="4"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="{StaticResource AccentBar3}" CornerRadius="2,0,0,2"/>
                        <StackPanel Grid.Column="1" Margin="22,18">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                <Border Width="30" Height="30" CornerRadius="6" Background="{DynamicResource InfoBgBrush}" Margin="0,0,10,0">
                                    <TextBlock Text="&#xEA47;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource InfoBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Database &amp; Engine Defaults" Style="{StaticResource HeadingSm}"/>
                                    <TextBlock Text="Primary SQLite repository path, SQL server parameters &amp; sweep presets" Style="{StaticResource Caption}"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Database Storage Banner -->
                            <Border Background="{DynamicResource InputBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                    CornerRadius="8" Padding="14,10" Margin="0,0,0,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="LOCAL REPOSITORY" Style="{StaticResource Caption}" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                        <TextBlock Text="{Binding DatabasePath, Mode=OneTime}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Command="{Binding TestConnectionCommand}"
                                                Style="{StaticResource BtnSecondary}" Height="30" FontSize="11" Padding="12,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE703;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Test Connection" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Command="{Binding ResetDatabaseCommand}"
                                                Style="{StaticResource BtnDanger}" Height="30" FontSize="11" Padding="12,0" Margin="8,0,0,0"
                                                Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Reset DB" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- SQL Server Parameters -->
                            <TextBlock Text="Default SQL Server Instance" Style="{StaticResource Label}" Margin="0,4,0,8"/>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,8,0">
                                    <TextBlock Text="Host / Instance" Style="{StaticResource Caption}" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding SqlServer}" Style="{StaticResource TxtBox}" Height="32" TextChanged="TextBox_TextChanged"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                    <TextBlock Text="Port" Style="{StaticResource Caption}" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding SqlPort}" Style="{StaticResource TxtBox}" Height="32"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="0,0,8,0">
                                    <TextBlock Text="Database" Style="{StaticResource Caption}" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding SqlDatabase}" Style="{StaticResource TxtBox}" Height="32"/>
                                </StackPanel>
                                <StackPanel Grid.Column="3" Margin="0,0,8,0">
                                    <TextBlock Text="Username" Style="{StaticResource Caption}" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding SqlUsername}" Style="{StaticResource TxtBox}" Height="32"/>
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Password" Style="{StaticResource Caption}" Margin="0,0,0,4"/>
                                    <PasswordBox x:Name="SqlPasswordBox" Height="32" FontSize="12"
                                                 Background="{DynamicResource InputBgBrush}"
                                                 BorderBrush="{DynamicResource InputBorderBrush}"
                                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                                 Padding="10,0"/>
                                </StackPanel>
                            </Grid>

                            <!-- Scan Defaults Matrix -->
                            <TextBlock Text="Discovery &amp; Sweep Concurrency Presets" Style="{StaticResource Label}" Margin="0,10,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="1.2*"/>
                                    <ColumnDefinition Width="1.2*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,8,0">
                                    <TextBlock Text="Max Threads" Style="{StaticResource Caption}" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding DefaultMaxThreads}" Style="{StaticResource TxtBox}" Height="32"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                    <TextBlock Text="Ping Timeout (ms)" Style="{StaticResource Caption}" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding DefaultPingTimeout}" Style="{StaticResource TxtBox}" Height="32"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="0,0,8,0">
                                    <TextBlock Text="Port Timeout (ms)" Style="{StaticResource Caption}" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding DefaultPortTimeout}" Style="{StaticResource TxtBox}" Height="32"/>
                                </StackPanel>
                                <StackPanel Grid.Column="3" Margin="0,0,8,0">
                                    <TextBlock Text="Default Start IP" Style="{StaticResource Caption}" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding DefaultStartIP}" Style="{StaticResource TxtBox}" Height="32"/>
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Default End IP" Style="{StaticResource Caption}" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding DefaultEndIP}" Style="{StaticResource TxtBox}" Height="32"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ============================================ -->
                <!-- 4. LOGS & STORAGE PATHS                      -->
                <!-- ============================================ -->
                <Border x:Name="LogsCard" Style="{StaticResource CategoryCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="4"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="{StaticResource AccentBar4}" CornerRadius="2,0,0,2"/>
                        <StackPanel Grid.Column="1" Margin="22,18">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                <Border Width="30" Height="30" CornerRadius="6" Background="{DynamicResource WarningBgBrush}" Margin="0,0,10,0">
                                    <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource WarningBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Diagnostics &amp; Storage Paths" Style="{StaticResource HeadingSm}"/>
                                    <TextBlock Text="Verbosity level, auto-save triggers and target export directories" Style="{StaticResource Caption}"/>
                                </StackPanel>
                            </StackPanel>

                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Grid Margin="0,0,12,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Log Verbosity" Style="{StaticResource SettingLabel}"/>
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding LogLevels}" SelectedItem="{Binding LogLevel}"
                                              Style="{StaticResource ModernDarkComboBox}"
                                              Height="34" FontSize="12"
                                              SelectionChanged="ComboBox_SelectionChanged"/>
                                </Grid>

                                <Grid Grid.Column="1" Margin="12,0,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Auto-Save Results" Style="{StaticResource SettingLabel}"/>
                                        <TextBlock Text="Persist scan snapshots automatically" Style="{StaticResource Caption}"/>
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                              IsChecked="{Binding AutoSaveEnabled}" VerticalAlignment="Center"/>
                                </Grid>
                            </Grid>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Export Folder -->
                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Text="Export Output Directory" Style="{StaticResource Caption}" Margin="0,0,0,4"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding ExportFolder}" Style="{StaticResource TxtBox}" Height="32" FontSize="12" IsReadOnly="True"
                                                 Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <Button Grid.Column="1" Command="{Binding BrowseExportFolderCommand}"
                                                Style="{StaticResource BtnSecondary}" Height="32" Width="36" Padding="0" Margin="6,0,0,0">
                                            <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="13"/>
                                        </Button>
                                    </Grid>
                                </StackPanel>

                                <!-- Default Save Folder -->
                                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                    <TextBlock Text="Default Snapshot Folder" Style="{StaticResource Caption}" Margin="0,0,0,4"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding DefaultSaveFolder}" Style="{StaticResource TxtBox}" Height="32" FontSize="12" IsReadOnly="True"
                                                 Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <Button Grid.Column="1" Command="{Binding BrowseDefaultSaveFolderCommand}"
                                                Style="{StaticResource BtnSecondary}" Height="32" Width="36" Padding="0" Margin="6,0,0,0">
                                            <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="13"/>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ============================================ -->
                <!-- 5. UPDATES & SYSTEM TELEMETRY (ABOUT)        -->
                <!-- ============================================ -->
                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="1.4*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Updates Card -->
                    <Border x:Name="UpdatesCard" Style="{StaticResource CategoryCard}" Margin="0,0,10,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="4"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Background="{StaticResource AccentBar5}" CornerRadius="2,0,0,2"/>
                            <StackPanel Grid.Column="1" Margin="20,16">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                    <Border Width="28" Height="28" CornerRadius="6" Background="{DynamicResource AccentMutedBrush}" Margin="0,0,8,0">
                                        <TextBlock Text="&#xE777;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Software Updates" Style="{StaticResource HeadingSm}" VerticalAlignment="Center"/>
                                    <Border CornerRadius="8" Padding="6,2" Margin="8,0,0,0"
                                            Background="{DynamicResource SuccessBgBrush}" BorderBrush="{DynamicResource SuccessBrush}" BorderThickness="1">
                                        <TextBlock Text="Up to date" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}"/>
                                    </Border>
                                </StackPanel>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Build Version" Style="{StaticResource StatLabel}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding AppVersion}" Style="{StaticResource StatValue}"/>
                                </Grid>

                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Last Checked" Style="{StaticResource StatLabel}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding LastUpdateCheck}" Style="{StaticResource StatValue}"/>
                                </Grid>

                                <Button Command="{Binding CheckForUpdatesCommand}"
                                        Style="{StaticResource BtnSecondary}" Height="32" FontSize="11" HorizontalAlignment="Left" Padding="14,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE777;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Check for Updates" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- About / Telemetry Card -->
                    <Border x:Name="AboutCard" Grid.Column="1" Style="{StaticResource CategoryCard}" Margin="10,0,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="4"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Background="{StaticResource AccentBar6}" CornerRadius="2,0,0,2"/>
                            <StackPanel Grid.Column="1" Margin="20,16">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                    <Border Width="28" Height="28" CornerRadius="6" Background="{DynamicResource InfoBgBrush}" Margin="0,0,8,0">
                                        <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource InfoBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Host Environment &amp; Diagnostics" Style="{StaticResource HeadingSm}" VerticalAlignment="Center"/>
                                </StackPanel>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Margin="0,0,8,0">
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Framework" Style="{StaticResource StatLabel}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding AppFramework}" Style="{StaticResource StatValue}"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Engine" Style="{StaticResource StatLabel}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding AppDatabase}" Style="{StaticResource StatValue}"/>
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Memory" Style="{StaticResource StatLabel}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding AppWorkingSet}" Style="{StaticResource StatValue}"/>
                                        </Grid>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="65"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="OS" Style="{StaticResource StatLabel}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding AppOsVersion}" Style="{StaticResource StatValue}"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="65"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Uptime" Style="{StaticResource StatLabel}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding AppUptime}" Style="{StaticResource StatValue}"/>
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="65"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Log Path" Style="{StaticResource StatLabel}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding AppLogPath}" Style="{StaticResource StatValue}"/>
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ============================================ -->
                <!-- 6. USER ACCESS & SECURITY (ADMIN ONLY)       -->
                <!-- ============================================ -->
                <Border x:Name="UserManagementCard" Style="{StaticResource CategoryCard}"
                        Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="4"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="{DynamicResource DangerBrush}" CornerRadius="2,0,0,2"/>
                        <StackPanel Grid.Column="1" Margin="22,18">
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="30" Height="30" CornerRadius="6" Background="{DynamicResource DangerBgBrush}" Margin="0,0,10,0">
                                        <TextBlock Text="&#xE716;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource DangerBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="User Access &amp; Role Administration" Style="{StaticResource HeadingSm}"/>
                                        <TextBlock Text="Approve pending registrations and manage authorized console operator roles" Style="{StaticResource Caption}"/>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Command="{Binding LoadPendingUsersCommand}"
                                            Style="{StaticResource BtnSecondary}" Height="30" FontSize="11" Padding="12,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Refresh Pending" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding LoadAllUsersCommand}"
                                            Style="{StaticResource BtnSecondary}" Height="30" FontSize="11" Margin="8,0,0,0" Padding="12,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Refresh Users" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <!-- Pending Approvals -->
                            <TextBlock Text="Pending Authorization Requests" Style="{StaticResource Label}" Margin="0,0,0,8"/>
                            
                            <!-- Empty State when no pending users -->
                            <Border Padding="12,10" Margin="0,0,0,16" Background="{DynamicResource InputBgBrush}" CornerRadius="6"
                                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                    Visibility="{Binding PendingUsers.Count, Converter={StaticResource IntToVisibilityConverter}, ConverterParameter=Inverse}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource SuccessBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="No pending user authorization requests at this time." FontSize="12" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <ItemsControl ItemsSource="{Binding PendingUsers}" Margin="0,0,0,16">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="12,8" Margin="0,0,0,6"
                                                Background="{DynamicResource WarningBgBrush}" CornerRadius="6"
                                                BorderBrush="{DynamicResource WarningBrush}" BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Width="30" Height="30" CornerRadius="15" Background="{DynamicResource WarningBrush}" Margin="0,0,10,0">
                                                    <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="Black" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Username}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                        <TextBlock Text="{Binding Email, StringFormat=' ({0})'}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                        <TextBlock Text="{Binding HardwareId, StringFormat='HWID: {0}'}" FontSize="10" FontFamily="Consolas" Foreground="{DynamicResource AccentBrush}"/>
                                                        <TextBlock Text="{Binding CreatedAt, StringFormat=' | Reg: {0:yyyy-MM-dd HH:mm}'}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"/>
                                                    </StackPanel>
                                                </StackPanel>
                                                <Button Grid.Column="2" Command="{Binding DataContext.ApproveUserCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                                        CommandParameter="{Binding}"
                                                        Height="28" Width="90" Margin="8,0"
                                                        Background="{DynamicResource SuccessBrush}" Foreground="White"
                                                        FontWeight="Bold" FontSize="11" BorderThickness="0" Cursor="Hand"
                                                        md:ButtonAssist.CornerRadius="6">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="Approve" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                                <Button Grid.Column="3" Command="{Binding DataContext.RejectUserCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                                        CommandParameter="{Binding}"
                                                        Height="28" Width="90"
                                                        Background="{DynamicResource DangerBrush}" Foreground="White"
                                                        FontWeight="Bold" FontSize="11" BorderThickness="0" Cursor="Hand"
                                                        md:ButtonAssist.CornerRadius="6">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="Reject" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- All Registered Users -->
                            <TextBlock Text="Registered Console Operators" Style="{StaticResource Label}" Margin="0,0,0,8"/>
                            <ItemsControl ItemsSource="{Binding AllUsers}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="12,8" Margin="0,0,0,4"
                                                Background="{DynamicResource InputBgBrush}" CornerRadius="6"
                                                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Width="28" Height="28" CornerRadius="14" Background="{DynamicResource AccentMutedBrush}" Margin="0,0,10,0">
                                                    <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="{Binding Username}" FontSize="13" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                                <Border Grid.Column="2" CornerRadius="4" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                                        Padding="8,2" Margin="10,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Role}" FontSize="11" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                </Border>
                                                <Button Grid.Column="3" Command="{Binding DataContext.DeleteUserCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                                        CommandParameter="{Binding}"
                                                        Height="26" Width="76"
                                                        Background="{DynamicResource DangerBrush}" Foreground="White"
                                                        FontWeight="Bold" FontSize="11" BorderThickness="0" Cursor="Hand"
                                                        md:ButtonAssist.CornerRadius="5">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="Delete" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ============================================ -->
                <!-- 7. SAVE FOOTER                               -->
                <!-- ============================================ -->
                <Border x:Name="SaveChangesCard" Style="{StaticResource CategoryCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="4"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="{DynamicResource SuccessBrush}" CornerRadius="2,0,0,2"/>
                        <StackPanel Grid.Column="1" Margin="22,18">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Apply &amp; Persist Configuration" Style="{StaticResource HeadingSm}"/>
                                    <TextBlock Text="Theme &amp; language changes apply instantly. Click Save to persist database, scan and logging configurations."
                                               Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="1" Command="{Binding SaveAllSettingsCommand}"
                                        Style="{StaticResource BtnPrimary}" Height="38" Padding="20,0" VerticalAlignment="Center"
                                        IsEnabled="{Binding IsSaving, Converter={StaticResource BooleanNotConverter}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Save All Settings" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>