<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================ -->
    <!-- DARK THEME — NetScope Pro High-Tech Glassmorphism Palette   -->
    <!-- ============================================================ -->

    <!-- Page & Surface -->
    <SolidColorBrush x:Key="PageBgBrush" Color="#070C16"/>
    <SolidColorBrush x:Key="SurfaceBgBrush" Color="#0B132B"/>
    <SolidColorBrush x:Key="SurfaceBorderBrush" Color="#1E293B"/>

    <!-- Cards & Panels -->
    <SolidColorBrush x:Key="CardBgBrush" Color="#0E1726"/>
    <SolidColorBrush x:Key="CardBorderBrush" Color="#1E2D4A"/>
    <SolidColorBrush x:Key="CardBgAltBrush" Color="#132035"/>
    <SolidColorBrush x:Key="CardHoverBorderBrush" Color="#0EA5E9"/>

    <!-- Text System -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#94A3B8"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="#64748B"/>
    <SolidColorBrush x:Key="TextLabelBrush" Color="#CBD5E1"/>
    <SolidColorBrush x:Key="TextDisabledBrush" Color="#475569"/>

    <!-- Inputs & Toolbars -->
    <SolidColorBrush x:Key="InputBgBrush" Color="#091120"/>
    <SolidColorBrush x:Key="InputBorderBrush" Color="#1E2D4A"/>
    <SolidColorBrush x:Key="InputFocusBorderBrush" Color="#0EA5E9"/>

    <!-- Sidebar System -->
    <SolidColorBrush x:Key="SidebarBgBrush" Color="#060A14"/>
    <SolidColorBrush x:Key="SidebarBtnBrush" Color="Transparent"/>
    <SolidColorBrush x:Key="SidebarTextBrush" Color="#94A3B8"/>
    <SolidColorBrush x:Key="SidebarTextActiveBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SidebarDividerBrush" Color="#152238"/>
    <SolidColorBrush x:Key="NavActiveBgBrush" Color="#0EA5E9" Opacity="0.18"/>
    <SolidColorBrush x:Key="NavActiveBorderBrush" Color="#0EA5E9"/>

    <!-- Accent / Primary Electric Blue -->
    <SolidColorBrush x:Key="AccentBrush" Color="#0EA5E9"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#38BDF8"/>
    <SolidColorBrush x:Key="AccentMutedBrush" Color="#180EA5E9"/>
    <SolidColorBrush x:Key="PrimaryBrush" Color="#0EA5E9"/>
    <SolidColorBrush x:Key="PrimaryLightBrush" Color="#0C2D48"/>

    <!-- Semantic Status Colors -->
    <SolidColorBrush x:Key="SuccessBrush" Color="#10B981"/>
    <SolidColorBrush x:Key="SuccessBgBrush" Color="#1810B981"/>
    <SolidColorBrush x:Key="SuccessBorderBrush" Color="#3510B981"/>

    <SolidColorBrush x:Key="DangerBrush" Color="#EF4444"/>
    <SolidColorBrush x:Key="DangerBgBrush" Color="#18EF4444"/>
    <SolidColorBrush x:Key="DangerBorderBrush" Color="#35EF4444"/>

    <SolidColorBrush x:Key="WarningBrush" Color="#F59E0B"/>
    <SolidColorBrush x:Key="WarningBgBrush" Color="#18F59E0B"/>
    <SolidColorBrush x:Key="WarningBorderBrush" Color="#35F59E0B"/>

    <SolidColorBrush x:Key="PurpleBrush" Color="#A855F7"/>
    <SolidColorBrush x:Key="PurpleBgBrush" Color="#18A855F7"/>
    <SolidColorBrush x:Key="PurpleBorderBrush" Color="#35A855F7"/>

    <SolidColorBrush x:Key="InfoBrush" Color="#38BDF8"/>
    <SolidColorBrush x:Key="InfoBgBrush" Color="#1838BDF8"/>

    <!-- Drawer / Slide-out Panel -->
    <SolidColorBrush x:Key="DrawerBgBrush" Color="#E60B132B"/>
    <SolidColorBrush x:Key="DrawerCardBgBrush" Color="#0E1726"/>
    <SolidColorBrush x:Key="DrawerBorderBrush" Color="#1E2D4A"/>

    <!-- Interactive States -->
    <SolidColorBrush x:Key="HoverBgBrush" Color="#132035"/>
    <SolidColorBrush x:Key="SelectedBgBrush" Color="#0C2D48"/>
    <SolidColorBrush x:Key="SelectedTextBrush" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="OverlayBgBrush" Color="#CC070C16"/>
    <SolidColorBrush x:Key="FocusBorderBrush" Color="#0EA5E9"/>

    <!-- Chart Colors -->
    <SolidColorBrush x:Key="ChartColor1" Color="#0EA5E9"/>
    <SolidColorBrush x:Key="ChartColor2" Color="#10B981"/>
    <SolidColorBrush x:Key="ChartColor3" Color="#F59E0B"/>
    <SolidColorBrush x:Key="ChartColor4" Color="#EF4444"/>
    <SolidColorBrush x:Key="ChartColor5" Color="#A855F7"/>
    <SolidColorBrush x:Key="ChartColor6" Color="#06B6D4"/>

    <!-- Semantic variant backgrounds (8-25% opacity) -->
    <SolidColorBrush x:Key="DangerTransparentBrush" Color="#40EF4444"/>
    <SolidColorBrush x:Key="WarningProgressBgBrush" Color="#20F59E0B"/>
    <SolidColorBrush x:Key="DangerProgressBgBrush" Color="#20EF4444"/>
    <SolidColorBrush x:Key="AccentProgressBgBrush" Color="#200EA5E9"/>
    <SolidColorBrush x:Key="ChartColor5ProgressBgBrush" Color="#20A855F7"/>
    <SolidColorBrush x:Key="ChartColor6ProgressBgBrush" Color="#2006B6D4"/>

    <!-- White transparent brushes for overlays -->
    <SolidColorBrush x:Key="White20Brush" Color="#20FFFFFF"/>
    <SolidColorBrush x:Key="White30Brush" Color="#40FFFFFF"/>
    <SolidColorBrush x:Key="White10Brush" Color="#1AFFFFFF"/>

    <!-- ScrollBar Brushes -->
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="#334155"/>
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="#0EA5E9"/>

</ResourceDictionary>
