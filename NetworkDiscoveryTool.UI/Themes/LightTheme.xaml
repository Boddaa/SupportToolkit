<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================ -->
    <!-- LIGHT THEME — Full Color Palette                             -->
    <!-- ============================================================ -->

    <!-- Page & Surface -->
    <SolidColorBrush x:Key="PageBgBrush" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="SurfaceBgBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SurfaceBorderBrush" Color="#E2E8F0"/>

    <!-- Cards -->
    <SolidColorBrush x:Key="CardBgBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CardBorderBrush" Color="#E2E8F0"/>
    <SolidColorBrush x:Key="CardBgAltBrush" Color="#F1F5F9"/>

    <!-- Text -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#0F172A"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#475569"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="#64748B"/>
    <SolidColorBrush x:Key="TextLabelBrush" Color="#1E293B"/>

    <!-- Inputs -->
    <SolidColorBrush x:Key="InputBgBrush" Color="#F1F5F9"/>
    <SolidColorBrush x:Key="InputBorderBrush" Color="#CBD5E1"/>

    <!-- Sidebar (Pure Light Theme) -->
    <SolidColorBrush x:Key="SidebarBgBrush" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="SidebarBtnBrush" Color="Transparent"/>
    <SolidColorBrush x:Key="SidebarTextBrush" Color="#475569"/>
    <SolidColorBrush x:Key="SidebarTextActiveBrush" Color="#0284C7"/>
    <SolidColorBrush x:Key="SidebarDividerBrush" Color="#E2E8F0"/>
    <SolidColorBrush x:Key="NavActiveBgBrush" Color="#150284C7"/>
    <SolidColorBrush x:Key="NavActiveBorderBrush" Color="#0284C7"/>

    <!-- Accent / Primary -->
    <SolidColorBrush x:Key="AccentBrush" Color="#0284C7"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#0369A1"/>
    <SolidColorBrush x:Key="AccentMutedBrush" Color="#E0F2FE"/>
    <SolidColorBrush x:Key="PrimaryBrush" Color="#0284C7"/>
    <SolidColorBrush x:Key="PrimaryLightBrush" Color="#E0F2FE"/>

    <!-- Semantic Status Colors -->
    <SolidColorBrush x:Key="SuccessBrush" Color="#059669"/>
    <SolidColorBrush x:Key="SuccessBgBrush" Color="#ECFDF5"/>
    <SolidColorBrush x:Key="SuccessBorderBrush" Color="#A7F3D0"/>

    <SolidColorBrush x:Key="DangerBrush" Color="#DC2626"/>
    <SolidColorBrush x:Key="DangerBgBrush" Color="#FEF2F2"/>
    <SolidColorBrush x:Key="DangerBorderBrush" Color="#FECACA"/>

    <SolidColorBrush x:Key="WarningBrush" Color="#D97706"/>
    <SolidColorBrush x:Key="WarningBgBrush" Color="#FFFBEB"/>
    <SolidColorBrush x:Key="WarningBorderBrush" Color="#FDE68A"/>

    <SolidColorBrush x:Key="PurpleBrush" Color="#7C3AED"/>
    <SolidColorBrush x:Key="PurpleBgBrush" Color="#F5F3FF"/>
    <SolidColorBrush x:Key="PurpleBorderBrush" Color="#DDD6FE"/>

    <SolidColorBrush x:Key="InfoBrush" Color="#0284C7"/>
    <SolidColorBrush x:Key="InfoBgBrush" Color="#E0F2FE"/>

    <!-- Drawer / Slide-out Panel -->
    <SolidColorBrush x:Key="DrawerBgBrush" Color="#F0FFFFFF"/>
    <SolidColorBrush x:Key="DrawerCardBgBrush" Color="#1A000000"/>
    <SolidColorBrush x:Key="DrawerBorderBrush" Color="#D0D7DE"/>

    <!-- Interactive States -->
    <SolidColorBrush x:Key="HoverBgBrush" Color="#E2E8F0"/>
    <SolidColorBrush x:Key="SelectedBgBrush" Color="#E0F2FE"/>
    <SolidColorBrush x:Key="SelectedTextBrush" Color="#0F172A"/>
    <SolidColorBrush x:Key="OverlayBgBrush" Color="#1F232899"/>
    <SolidColorBrush x:Key="FocusBorderBrush" Color="#0284C7"/>

    <!-- Chart Colors -->
    <SolidColorBrush x:Key="ChartColor1" Color="#0284C7"/>
    <SolidColorBrush x:Key="ChartColor2" Color="#059669"/>
    <SolidColorBrush x:Key="ChartColor3" Color="#D97706"/>
    <SolidColorBrush x:Key="ChartColor4" Color="#DC2626"/>
    <SolidColorBrush x:Key="ChartColor5" Color="#7C3AED"/>
    <SolidColorBrush x:Key="ChartColor6" Color="#0891B2"/>

    <!-- Semantic variant backgrounds (8-25% opacity) -->
    <SolidColorBrush x:Key="DangerTransparentBrush" Color="#25DC2626"/>
    <SolidColorBrush x:Key="WarningProgressBgBrush" Color="#20D97706"/>
    <SolidColorBrush x:Key="DangerProgressBgBrush" Color="#20DC2626"/>
    <SolidColorBrush x:Key="AccentProgressBgBrush" Color="#200284C7"/>
    <SolidColorBrush x:Key="ChartColor5ProgressBgBrush" Color="#207C3AED"/>
    <SolidColorBrush x:Key="ChartColor6ProgressBgBrush" Color="#200891B2"/>

    <!-- White transparent brushes for overlays -->
    <SolidColorBrush x:Key="White20Brush" Color="#20000000"/>
    <SolidColorBrush x:Key="White30Brush" Color="#40000000"/>
    <SolidColorBrush x:Key="White10Brush" Color="#1A000000"/>

    <!-- ScrollBar Brushes -->
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="#94A3B8"/>
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="#0284C7"/>

</ResourceDictionary>
